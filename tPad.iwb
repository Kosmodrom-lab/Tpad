CONST TP_SCN_UPDATEUI  = 2007

': ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
': Enumerated Constants (Synchronized to Resource Script IDs)
': ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
ENUM tpad_commands
    CMD_NEW = 1
    CMD_OPEN = 2
    CMD_SAVEAS = 3
    CMD_PRINT = 4
    CMD_EXIT = 5
    CMD_SAVE = 6

    CMD_UNDO = 10
    CMD_CUT = 11
    CMD_COPY = 12
    CMD_PASTE = 13
    CMD_SELECTALL = 14
    CMD_FIND = 15
    CMD_REPLACE = 16
    CMD_WORDWRAP = 17

    CMD_FONT = 18
    CMD_REDO = 19
    CMD_ONTOP = 20
    CMD_ABOUT = 21
    CMD_HSCROLL = 22
    CMD_PROPERTIES = 23
    CMD_TOOLS = 24

    CMD_SHOW_INDENT = 42
    CMD_SHOW_EOL    = 43
    CMD_SHOW_WS     = 44
    CMD_SHOW_WRAPSYM = 45

    CMD_EOL_CRLF = 47
    CMD_EOL_LF   = 48
    CMD_EOL_CR   = 49

    CMD_TABS_SPACES = 50
    CMD_AUTOINDENT  = 51
    CMD_BRACEMATCH  = 52
    CMD_TRIM_SAVE   = 53
    CMD_FINAL_NL    = 54
    CMD_FINDNEXT    = 55
    CMD_FINDPREV    = 56

    CMD_ENC_BASE = 60      ' 60..66 = Encoding
    CMD_REL_BASE = 70      ' 70..76 = Reload As

    CMD_CP_REL = 300          ' 300..325 = Reload As ANSI with CP > ...

    CMD_THEME_BASE = 400

    CMD_CLEAR_MRU = 105
ENDENUM

ENUM control_ids
    EDIT_1 = 111
    STATUS_1 = 222
ENDENUM

ENUM dialog_controls
    lblSearch = 600
    lblReplace
    ctlSearchtext
    ctlReplacetext
    ctlMatchCase
    ctlMatchWholeWord
    ctlReplaceBtn = 608
    ctlReplaceAll
    ctlFind = 1         ' ID must be 1 for Enter to trigger Find (IDOK)
    ctlClose = 2        ' ID must be for Esc (IDCANCEL)
ENDENUM

ENUM tool_controls
    ctlToolList = 700
    ctlToolName
    ctlToolPath
    ctlToolArgs
    ctlToolBrowse
    ctlToolAdd
    ctlToolDel
    ctlToolUp
    ctlToolDown
    lblToolNote
    lblToolName
    lblToolPath
    lblToolArgs
    lblToolHint
ENDENUM
