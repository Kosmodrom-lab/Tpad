                  MENUITEM "ISO-8859-1 (Latin-1)", 0, 301
                  MENUITEM "ISO-8859-15 (Latin-9)", 0, 302
                  MENUITEM "CP850 (DOS Western)", 0, 303
                  MENUITEM "CP437 (DOS US)", 0, 304
                  SEPARATOR
                  MENUITEM "Windows-1250 (Central European)", 0, 305
                  MENUITEM "ISO-8859-2 (Latin-2)", 0, 306
                  MENUITEM "CP852 (DOS Central European)", 0, 307
                  MENUITEM "Windows-1257 (Baltic)", 0, 308
                  MENUITEM "Windows-1258 (Vietnamese)", 0, 309
                  SEPARATOR
                  MENUITEM "Windows-1251 (Cyrillic)", 0, 310
                  MENUITEM "KOI8-R (Cyrillic)", 0, 311
                  MENUITEM "KOI8-U (Cyrillic Ukrainian)", 0, 312
                  MENUITEM "ISO-8859-5 (Cyrillic)", 0, 313
                  MENUITEM "CP866 (DOS Cyrillic)", 0, 314
                  SEPARATOR
                  MENUITEM "Windows-1253 (Greek)", 0, 315
                  MENUITEM "ISO-8859-7 (Greek)", 0, 316
                  MENUITEM "Windows-1254 (Turkish)", 0, 317
                  MENUITEM "ISO-8859-9 (Turkish)", 0, 318
                  SEPARATOR
                  MENUITEM "Windows-1255 (Hebrew)", 0, 319
                  MENUITEM "Windows-1256 (Arabic)", 0, 320
                  MENUITEM "Windows-874 (Thai)", 0, 321
                  SEPARATOR
                  MENUITEM "Shift-JIS (Japanese)", 0, 322
                  MENUITEM "GBK (Simplified Chinese)", 0, 323
                  MENUITEM "CP949 (Korean)", 0, 324
                  MENUITEM "Big5 (Traditional Chinese)", 0, 325
               ENDPOPUP
           ENDPOPUP
        ENDPOPUP
        SEPARATOR
        MENUITEM "&Print...\tCtrl+P", 0, CMD_PRINT
        MENUITEM "E&xit\tAlt+F4", 0, CMD_EXIT

    MENUTITLE "&Edit"
        MENUITEM "&Undo\tCtrl+Z", 0, CMD_UNDO
        MENUITEM "&Redo\tCtrl+Y", 0, CMD_REDO
        SEPARATOR
        MENUITEM "Cu&t\tCtrl+X", 0, CMD_CUT
        MENUITEM "&Copy\tCtrl+C", 0, CMD_COPY
        MENUITEM "&Paste\tCtrl+V", 0, CMD_PASTE
        SEPARATOR
        MENUITEM "Select &All\tCtrl+A", 0, CMD_SELECTALL
        SEPARATOR
        MENUITEM "&Find...\tCtrl+F", 0, CMD_FIND
        MENUITEM "&Replace...\tCtrl+H", 0, CMD_REPLACE
        MENUITEM "Find Ne&xt\tF3", 0, CMD_FINDNEXT
        MENUITEM "Find Pre&vious\tShift+F3", 0, CMD_FINDPREV
        SEPARATOR
        MENUITEM "Tabs as &Spaces", 0, CMD_TABS_SPACES
        MENUITEM "Auto-&Indent", 0, CMD_AUTOINDENT
        MENUITEM "&Brace Matching", 0, CMD_BRACEMATCH
        MENUITEM "Tri&m Trailing Spaces on Save", 0, CMD_TRIM_SAVE
        MENUITEM "Final &Newline on Save", 0, CMD_FINAL_NL

    MENUTITLE "&View"
        MENUITEM "&Wrap\tCtrl+W", 0, CMD_WORDWRAP
        MENUITEM "&Font...", 0, CMD_FONT
        SEPARATOR
        BEGINPOPUP "T&heme"
            MENUITEM "Classic Light", 0, 400
            MENUITEM "Dark Modern", 0, 401
            MENUITEM "Solarized Dark", 0, 402
            MENUITEM "Solarized Light", 0, 403
            MENUITEM "Monokai", 0, 404
            MENUITEM "Dracula", 0, 405
            MENUITEM "Nord", 0, 406
            MENUITEM "Gruvbox Dark", 0, 407
            MENUITEM "Retro Green CRT", 0, 408
            MENUITEM "Amber CRT", 0, 409
            MENUITEM "Paper Sepia", 0, 410
        ENDPOPUP
        BEGINPOPUP "&Syntax"
            MENUITEM "Default", 0, 32
            MENUITEM "Assembler", 0, 33
            MENUITEM "iwBasic", 0, 34
            MENUITEM "C C++", 0, 35
            MENUITEM "Python", 0, 36
            MENUITEM "Perl", 0, 37
            MENUITEM "Makefile", 0, 38
            MENUITEM "Batch", 0, 39
            MENUITEM "Diff", 0, 40
            MENUITEM "Lua", 0, 41
        ENDPOPUP
        BEGINPOPUP "Sho&w"
            MENUITEM "Indentation", 0, 42
            MENUITEM "Line Ending", 0, 43
            MENUITEM "WhiteSpaces", 0, 44
            MENUITEM "Wrap Symbol", 0, 45
        ENDPOPUP
        SEPARATOR
        MENUITEM "On &Top\tCtrl+T", 0, CMD_ONTOP
        SEPARATOR
        MENUITEM "&About Tpad...\tF1", 0, CMD_ABOUT

    MENUTITLE "&Routines"
        MENUITEM "(none)", 0, CMD_RTN_NONE
ENDMENU

' 2. Retrieve the handle of the menu created by BEGINMENU
HMENU hWinMenu = GetMenu(WIN.hwnd)

IF hWinMenu <> 0 THEN
   IF hbrBackground <> 0 THEN
     g_WndMenu.SetTextureBrush(hbrBackground)
   ENDIF


    ' 1. Assign bitmap mappings
    AttachCustomMenuBitmaps()
    g_WndMenu.SetImageLists(himlHot, himlDisabled)

    ' 2. Attach menu and enable owner-draw flags
    ' Trace("AttachMenu entered, hwnd=" + STR$(win.hwnd) + " menu=" + STR$(hWinMenu))
    g_WndMenu.AttachMenu(WIN.hwnd, hWinMenu)

    ' 3. Make the last title right-justified (Win95 "Help" style)
    INT nTop = GetMenuItemCount(hWinMenu) - 1
    MENUITEMINFO mj
    RtlZeroMemory(&mj, LEN(mj))
    mj.cbSize = LEN(mj)
    mj.fMask  = 0x00000100                                   ' MIIM_FTYPE
    IF GetMenuItemInfoA(hWinMenu, nTop, TRUE, &mj) <> 0 THEN
        mj.fType = mj.fType | 0x00004000                     ' MFT_RIGHTJUSTIFY (keeps the owner-draw bit)
        mj.fMask = 0x00000100
        SetMenuItemInfoA(hWinMenu, nTop, TRUE, &mj)
    ENDIF
    DrawMenuBar(WIN.hwnd)
ENDIF

' 3. Register Keyboard Accelerators
ADDACCELERATOR WIN, @FCONTROL | @FVIRTKEY, ASC("N"), CMD_NEW
ADDACCELERATOR WIN, @FCONTROL | @FVIRTKEY, ASC("O"), CMD_OPEN
ADDACCELERATOR WIN, @FCONTROL | @FVIRTKEY, ASC("S"), CMD_SAVE
ADDACCELERATOR WIN, @FVIRTKEY, 0x7B, CMD_SAVEAS                   ' F12
ADDACCELERATOR WIN, @FCONTROL | @FVIRTKEY, ASC("P"), CMD_PRINT
ADDACCELERATOR WIN, @FCONTROL | @FVIRTKEY, ASC("Z"), CMD_UNDO
ADDACCELERATOR WIN, @FCONTROL | @FVIRTKEY, ASC("Y"), CMD_REDO
ADDACCELERATOR WIN, @FCONTROL | @FVIRTKEY, ASC("X"), CMD_CUT
ADDACCELERATOR WIN, @FCONTROL | @FVIRTKEY, ASC("C"), CMD_COPY
ADDACCELERATOR WIN, @FCONTROL | @FVIRTKEY, ASC("V"), CMD_PASTE
ADDACCELERATOR WIN, @FCONTROL | @FVIRTKEY, ASC("A"), CMD_SELECTALL
ADDACCELERATOR WIN, @FCONTROL | @FVIRTKEY, ASC("F"), CMD_FIND
ADDACCELERATOR WIN, @FCONTROL | @FVIRTKEY, ASC("H"), CMD_REPLACE
ADDACCELERATOR WIN, @FCONTROL | @FVIRTKEY, ASC("W"), CMD_WORDWRAP
ADDACCELERATOR WIN, @FCONTROL | @FVIRTKEY, ASC("T"), CMD_ONTOP
ADDACCELERATOR WIN, @FVIRTKEY, 0x70, CMD_ABOUT                    ' F1

' 4. Initialize Toolbar & Menu States
IF g_App.onTop THEN
    SendMessage(WIN, TB_CHECKBUTTON, CMD_ONTOP, TRUE, 2000)
    CHECKMENUITEM WIN, CMD_ONTOP, 1
    WindowOnTop(WIN.hwnd, 1)
ELSE
    SendMessage(WIN, TB_CHECKBUTTON, CMD_ONTOP, FALSE, 2000)
    CHECKMENUITEM WIN, CMD_ONTOP, 0
    WindowOnTop(WIN.hwnd, 0)
ENDIF

IF g_App.wordWrap THEN
    SendMessage(WIN, TB_CHECKBUTTON, CMD_WORDWRAP, TRUE, 2000)
    CHECKMENUITEM WIN, CMD_WORDWRAP, 1
    IF g_hSciCtrl <> 0 THEN SendMessageA(g_hSciCtrl, SCI_SETWRAPMODE, SC_WRAP_WORD, 0)
ELSE
    SendMessage(WIN, TB_CHECKBUTTON, CMD_WORDWRAP, FALSE, 2000)
    CHECKMENUITEM WIN, CMD_WORDWRAP, 0
    IF g_hSciCtrl <> 0 THEN SendMessageA(g_hSciCtrl, SCI_SETWRAPMODE, SC_WRAP_NONE, 0)
ENDIF

InitCodePages()
ApplyViewOptions()
SetEOLMode(0, FALSE)
SyncEncodingMenuCheck(g_App.encoding)
InitGutter()
InitRuler()
DynaNew(ds, 0, 1)
AllowFileDrop(WIN.hwnd, True)

If FileExists(GETSTARTPATH + "Tpad.ini") <> 0
    SETSIZE WIN, g_App.left, g_App.top, g_App.width, g_App.height
Else
    CENTERWINDOW WIN
EndIf

InjectUIFont(WIN.hwnd)
ApplyThemeStyles(g_App.themeID)
DoResize()
SetFocusA(g_hSciCtrl)
Trace("Tpad started !")


If fName <> "" THEN
    DoOpen()
ELSE
    FileNew()
ENDIF

ONEXIT(&CleanupAppResources, NULL)
WAITUNTIL WIN = 0
END

': ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
': Clean up resources, Free Scintilla DLL and Close Everything Proper
': ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
SUB DoEndProgram()
    IF WIN.hwnd <> 0 THEN
        StopTimer(WIN, FILE_MONITOR_TIMER_ID)
        StopTimer(WIN, BALLOON_DISMISS_TIMER_ID)
    ENDIF

    IF g_hwndToolTip <> 0 THEN
        DestroyWindow(g_hwndToolTip)
        g_hwndToolTip = 0
    ENDIF

    IF W1.hwnd <> 0 THEN RemoveWindowSubclass(W1.hwnd, &subclassProc, subclassID)
    IF W0.hwnd <> 0 THEN RemoveWindowSubclass(W0.hwnd, &subclassProc, subclassID2)

    IF (g_hSciCtrl <> 0) AND (ORIG <> NULL) THEN
        SetWindowLongA(g_hSciCtrl, -4, ORIG)
        ORIG = NULL
    ENDIF

    IF hToolBar <> 0 THEN DestroyWindow(hToolBar)

    IF W0.hwnd <> 0 THEN CLOSEWINDOW W0
    IF W1.hwnd <> 0 THEN CLOSEWINDOW W1
    IF WIN.hwnd <> 0 THEN CLOSEWINDOW WIN

    CleanupAppResources(NULL)
ENDSUB

SUB CleanupAppResources(POINTER pData), INT

    FreeGutterCache()
    DeleteObject(hBmpHot)
    DeleteObject(hBmpDisabled)

    IF g_hInjFont <> 0 THEN
        DeleteObject(g_hInjFont)
        g_hInjFont = 0
    ENDIF

    IF g_hUIFont <> 0 AND g_hUIFont <> GetStockObject(17) THEN
        DeleteObject(g_hUIFont)
        g_hUIFont = 0
    ENDIF

    IF (g_hEditorFont <> 0) THEN
        DeleteObject(g_hEditorFont)
        g_hEditorFont = 0
    ENDIF

    IF g_hFindEditBgBrush <> 0 THEN
        DeleteObject(g_hFindEditBgBrush)
        g_hFindEditBgBrush = 0
    ENDIF

    DynaDelete(ds)


    INT idx
    FOR idx = 0 TO 14
        IF g_hMenuBmps[idx] <> 0 THEN
            DeleteObject(g_hMenuBmps[idx])
            g_hMenuBmps[idx] = 0
        ENDIF
    NEXT idx

    FOR idx = 0 TO 1
        IF g_hMenuCheckedBmps[idx] <> 0 THEN
            DeleteObject(g_hMenuCheckedBmps[idx])
            g_hMenuCheckedBmps[idx] = 0
        ENDIF
    NEXT idx

    IF himlHot <> 0 THEN
       ImageList_Destroy(himlHot)
    ENDIF

    IF himlDisabled <> 0 THEN
       ImageList_Destroy(himlDisabled)
    ENDIF

    IF g_hbrGutter <> 0 THEN
        DeleteObject(g_hbrGutter)
        g_hbrGutter = 0
    ENDIF

    IF hbrBackground <> 0 THEN
        DeleteObject(hbrBackground)
        hbrBackground = 0
    ENDIF

    IF g_hBmpGutterRotated <> 0 THEN
        DeleteObject(g_hBmpGutterRotated)
        g_hBmpGutterRotated = 0
    ENDIF

    IF g_hRulerFont        <> 0 THEN DeleteObject(g_hRulerFont)        : g_hRulerFont = 0
    IF g_hRulerSepPen      <> 0 THEN DeleteObject(g_hRulerSepPen)      : g_hRulerSepPen = 0
    IF g_hRulerPolePen     <> 0 THEN DeleteObject(g_hRulerPolePen)     : g_hRulerPolePen = 0
    IF g_hRulerFlagPen     <> 0 THEN DeleteObject(g_hRulerFlagPen)     : g_hRulerFlagPen = 0
    IF g_hRulerFlagBrush   <> 0 THEN DeleteObject(g_hRulerFlagBrush)   : g_hRulerFlagBrush = 0
    IF g_hRulerArrowPen    <> 0 THEN DeleteObject(g_hRulerArrowPen)    : g_hRulerArrowPen = 0
    IF g_hRulerEraserPen   <> 0 THEN DeleteObject(g_hRulerEraserPen)   : g_hRulerEraserPen = 0
    IF g_hRulerEraserBrush <> 0 THEN DeleteObject(g_hRulerEraserBrush) : g_hRulerEraserBrush = 0

    DELETEIMAGE hIcon[0], @IMGICON
    DELETEIMAGE hIcon[1], @IMGICON
    DELETEIMAGE hIcon[2], @IMGICON
    DELETEIMAGE himl[4], @IMGBITMAP
    DELETEIMAGE hBmp0, @IMGBITMAP
    DELETEIMAGE hBmp1, @IMGBITMAP
    DELETEIMAGE hBmp8, @IMGBITMAP

    IF About.hwnd <> 0 THEN RemoveProp(About.hwnd, "AboutIcon")
    IF WIN.hwnd <> 0 THEN RemoveProp(WIN.hwnd, "TpadIcon")

    IF g_hSciLib <> 0 THEN
        FreeLibrary(g_hSciLib)
        g_hSciLib = 0
    ENDIF

    RETURN 0
ENDSUB

': ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
': Balloon Toast Overlay Routines
': ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
SUB ShowBalloonToast(POINTER pTitle, POINTER pMessage)
    IF g_hwndToolTip = 0 OR WIN.hwnd = 0 OR pMessage = NULL THEN RETURN

    STOPTIMER WIN, BALLOON_DISMISS_TIMER_ID

    STATIC ISTRING szStaticTitle[128]
    STATIC ISTRING szStaticMsg[512]

    lstrcpynA(&szStaticTitle, pTitle, 127)
    lstrcpynA(&szStaticMsg, pMessage, 511)

    TOOLINFO_BALLOON ti
    RtlZeroMemory(&ti, LEN(ti))
    ti.cbSize   = LEN(ti)
    ti.uFlags   = TTF_TRACK | TTF_ABSOLUTE
    ti.hwnd     = WIN.hwnd
    ti.uId      = 1
    ti.lpszText = &szStaticMsg

    SendMessageA(g_hwndToolTip, TTM_DELTOOLA, 0, &ti)
    SendMessageA(g_hwndToolTip, TTM_ADDTOOLA, 0, &ti)
    SendMessageA(g_hwndToolTip, TTM_SETTITLEA, 1, &szStaticTitle)

    WINRECT rcWin
    GetWindowRect(WIN.hwnd, &rcWin)

    INT px = rcWin.right - 140
    INT py = rcWin.top + 70

    SendMessageA(g_hwndToolTip, TTM_TRACKPOSITION, 0, (py << 16) | (px & 0xFFFF))
    SendMessageA(g_hwndToolTip, TTM_TRACKACTIVATE, TRUE, &ti)

    STARTTIMER WIN, 3500, BALLOON_DISMISS_TIMER_ID
ENDSUB

SUB HideBalloonToast()
    IF g_hwndToolTip = 0 THEN RETURN

    TOOLINFO_BALLOON ti
    RtlZeroMemory(&ti, LEN(ti))
    ti.cbSize = LEN(ti)
    ti.hwnd   = WIN.hwnd
    ti.uId    = 1

    SendMessageA(g_hwndToolTip, TTM_TRACKACTIVATE, FALSE, &ti)
ENDSUB

': ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
': Helper Routines
': ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
SUB DpiInit()
    UINT hdcScr = GetDC(NULL)
    IF hdcScr <> 0 THEN
        g_Dpi = GetDeviceCaps(hdcScr, 88)          ' LOGPIXELSX
        ReleaseDC(NULL, hdcScr)
    ENDIF
    IF g_Dpi < 96 THEN g_Dpi = 96
    g_IconScale = (g_Dpi + 24) / 96 : IF g_IconScale < 1 THEN g_IconScale = 1
    g_IconSz    = 16 * g_IconScale

' g_IconScale = 2 : g_IconSz = 32      ' TEMP: force 2x icons at 96 DPI
ENDSUB

SUB DpiPx(INT px), INT                              ' 96-DPI pixels -> real pixels
    RETURN MulDiv(px, g_Dpi, 96)
ENDSUB

SUB ApplyStatusParts()                               ' one definition instead of two
    PARTS[0] = posWIDTH - DpiPx(380)
    PARTS[1] = posWIDTH - DpiPx(290)
    PARTS[2] = posWIDTH - DpiPx(190)
    PARTS[3] = posWIDTH - DpiPx(130)
    PARTS[4] = posWIDTH - DpiPx(85)
    PARTS[5] = posWIDTH - DpiPx(45)
    PARTS[6] = -1
    CONTROLCMD WIN, STATUS_1, @SWSETPANES, 7, PARTS
ENDSUB

SUB PlaceGotoControls()
    INT h  = DpiPx(20)
    INT y  = (g_ToolbarH - h) / 2                     ' 96 DPI: (26 - 20) / 2 = 3, as now
    INT x0 = DpiPx(420)
    IF g_TbLastRight + DpiPx(16) > x0 THEN x0 = g_TbLastRight + DpiPx(16)

    SetSize WIN, x0,                 y, DpiPx(73), h, 101
    SetSize WIN, x0 + DpiPx(76),     y, DpiPx(40), h, 102
    SetSize WIN, x0 + DpiPx(119),    y, DpiPx(40), h, 103
    SetSize WIN, x0 + DpiPx(162),    y, DpiPx(40), h, 104
ENDSUB

SUB SafeAllocHeap(DWORD sizeInBytes), POINTER
    HANDLE hHeap = Win32GetProcessHeap()
    IF hHeap = NULL THEN RETURN NULL
    RETURN Win32HeapAlloc(hHeap, HEAP_ZERO_MEMORY, sizeInBytes)
ENDSUB

SUB SafeFreeHeap(POINTER pMem)
    IF pMem = NULL THEN RETURN
    HANDLE hHeap = Win32GetProcessHeap()
    IF hHeap <> NULL THEN
        Win32HeapFree(hHeap, 0, pMem)
    ENDIF
ENDSUB

SUB ToggleOnTop()
    g_App.onTop = NOT g_App.onTop
    If g_App.onTop Then
        SendMessage(WIN, TB_CHECKBUTTON, CMD_ONTOP, TRUE, 2000)
        CHECKMENUITEM WIN, CMD_ONTOP, 1
        WindowOnTop(WIN.hwnd, 1)
    Else
        SendMessage(WIN, TB_CHECKBUTTON, CMD_ONTOP, FALSE, 2000)
        CHECKMENUITEM WIN, CMD_ONTOP, 0
        WindowOnTop(WIN.hwnd, 0)
    EndIf
EndSub

SUB ToggleWordWrap()
    g_App.wordWrap = NOT g_App.wordWrap
    If g_App.wordWrap Then
        SendMessage(WIN, TB_CHECKBUTTON, CMD_WORDWRAP, TRUE, 2000)
        CHECKMENUITEM WIN, CMD_WORDWRAP, 1
        SendMessageA(g_hSciCtrl, SCI_SETWRAPMODE, SC_WRAP_WORD, 0)
    Else
        SendMessage(WIN, TB_CHECKBUTTON, CMD_WORDWRAP, FALSE, 2000)
        CHECKMENUITEM WIN, CMD_WORDWRAP, 0
        SendMessageA(g_hSciCtrl, SCI_SETWRAPMODE, SC_WRAP_NONE, 0)
    EndIf
    UpdateGutter()
    InvalidateRect(WIN.hwnd, NULL, TRUE)
    InvalidateRect(W1.hwnd, NULL, TRUE)
EndSub

SUB OpenFontDialog()
    STRING chosenFont$
    INT vSize, vWeight, vFlags, vColor

    vSize = g_App.fontSize
    vWeight = g_App.fontWeight
    vFlags = g_App.fontFlags
    vColor = RGB(0, 0, 0)

    ' Monospace-only font picker (CF_FIXEDPITCHONLY) instead of FONTREQUEST
    TPAD_LOGFONT lf
    TPAD_CHOOSEFONT cf
    ISTRING faceBuf[32]
    UINT hdcScr = GetDC(NULL)
    INT dpiY = GetDeviceCaps(hdcScr, 90)
    ReleaseDC(NULL, hdcScr)

    RtlZeroMemory(&lf, LEN(lf))
    RtlZeroMemory(&cf, LEN(cf))
    lf.lfHeight = -MulDiv(vSize, dpiY, 72)
    lf.lfWeight = vWeight
    IF lf.lfWeight <= 0 THEN lf.lfWeight = 400
    IF (vFlags & 1) <> 0 THEN lf.lfWeight = 700
    IF (vFlags & 2) <> 0 THEN lf.lfItalic = 1
    IF (vFlags & 4) <> 0 THEN lf.lfUnderline = 1
    lf.lfCharSet = 1                                  ' DEFAULT_CHARSET
    faceBuf = g_App.fontName
    lstrcpynA(&lf.lfFaceName[0], &faceBuf, 31)

    cf.lStructSize = LEN(cf)
    cf.hwndOwner   = WIN.hwnd
    cf.lpLogFont   = &lf
    cf.iPointSize  = vSize * 10
    ' CF_SCREENFONTS | CF_INITTOLOGFONTSTRUCT | CF_FIXEDPITCHONLY | CF_FORCEFONTEXIST | CF_NOVERTFONTS
    cf.Flags       = 0x00000001 | 0x00000040 | 0x00004000 | 0x00010000 | 0x01000000

    chosenFont$ = ""
    IF ChooseFontA(&cf) <> 0 THEN
        faceBuf = ""
        lstrcpynA(&faceBuf, &lf.lfFaceName[0], 31)
        chosenFont$ = faceBuf
        vSize   = cf.iPointSize / 10
        vWeight = lf.lfWeight
        vFlags  = 0
        IF lf.lfWeight >= 700 THEN vFlags = vFlags | 1
        IF lf.lfItalic <> 0 THEN vFlags = vFlags | 2
        IF lf.lfUnderline <> 0 THEN vFlags = vFlags | 4
    ENDIF

    If chosenFont$ <> "" Then
        g_App.fontName   = chosenFont$
        g_App.fontSize   = vSize
        g_App.fontWeight = vWeight
        g_App.fontFlags  = vFlags

        IF g_hSciCtrl <> 0 THEN
            ISTRING fontBuf[64]
            fontBuf = g_App.fontName

            ' 1. Update default style and line number margin style
            SendMessageA(g_hSciCtrl, SCI_STYLESETFONT, STYLE_DEFAULT, &fontBuf)
            SendMessageA(g_hSciCtrl, SCI_STYLESETSIZE, STYLE_DEFAULT, g_App.fontSize)
            SendMessageA(g_hSciCtrl, SCI_STYLESETFONT, STYLE_LINENUMBER, &fontBuf)
            SendMessageA(g_hSciCtrl, SCI_STYLESETSIZE, STYLE_LINENUMBER, g_App.fontSize)

            ' 2. Apply new font name & size to all lexer styles (0 to 31) without wiping colors
            INT i
            FOR i = 0 TO 31
                SendMessageA(g_hSciCtrl, SCI_STYLESETFONT, i, &fontBuf)
                SendMessageA(g_hSciCtrl, SCI_STYLESETSIZE, i, g_App.fontSize)
            NEXT i

            ' 3. Refresh editor buffer
            SendMessageA(g_hSciCtrl, SCI_COLOURISE, 0, -1)
        ENDIF

        IF g_hRulerFont <> 0 THEN DeleteObject(g_hRulerFont)
        INT fHeight = textH
        IF fHeight <= 0 THEN fHeight = 15
        g_hRulerFont = CreateFont(fHeight, 0, 0, 0, g_App.fontWeight, (g_App.fontFlags & 2), (g_App.fontFlags & 4), 0, 0, 0, 0, 5, 0, g_App.fontName)

        ' Delete the old font handle before regenerating to prevent leaks
        IF g_hUIFont <> 0 AND g_hUIFont <> GetStockObject(17) THEN DeleteObject(g_hUIFont)
        InitUIFont()
        DrawMenuBar(WIN.hwnd)
        InjectUIFont(win.hwnd)
        DoResize()
        InvalidateRect(WIN.hwnd, NULL, TRUE)
        InvalidateRect(W0.hwnd, NULL, TRUE)

        INIWrite()
    EndIf
EndSub

SUB AttachCustomMenuBitmaps()
    INT sz = g_IconSz
    INT hDC = GetDC(WIN.hwnd)
    INT hMemDC = CreateCompatibleDC(hDC)
    INT hStripDC = CreateCompatibleDC(hDC)

    ' private copy of the (DPI-scaled) strip: the menu engine keeps this bitmap for the whole session
    BITMAP bm
    GetObjectA(hBmpScaled, LEN(bm), &bm)
    HBITMAP hMenuBmp = CreateCompatibleBitmap(hDC, bm.bmWidth, bm.bmHeight)

    HBITMAP hOldStrip = SelectObject(hStripDC, hMenuBmp)
    HBITMAP hOldMem   = SelectObject(hMemDC, hBmpScaled)
    BitBlt(hStripDC, 0, 0, bm.bmWidth, bm.bmHeight, hMemDC, 0, 0, 0x00CC0020)     ' SRCCOPY
    SelectObject(hMemDC, hOldMem)
    SelectObject(hStripDC, hOldStrip)
    DeleteDC(hMemDC)
    DeleteDC(hStripDC)
    ReleaseDC(WIN.hwnd, hDC)

    ' pass the strip to the BrushedMenu engine (magenta = transparent)
    g_WndMenu.SetImages(hMenuBmp, RGB(255, 0, 255))

    ' hot and disabled variants
    INT hCustomHot = CreateHotToolbarBitmap(hMenuBmp)
    INT hCustomDisabled = CreateDisabledToolbarBitmap(hMenuBmp)
    g_WndMenu.SetStateBitmaps(hCustomHot, hCustomDisabled)

    ' command id -> icon index
    g_WndMenu.AssignBitmapIndex(CMD_NEW, 0)
    g_WndMenu.AssignBitmapIndex(CMD_OPEN, 1)
    g_WndMenu.AssignBitmapIndex(CMD_SAVE, 2)
    g_WndMenu.AssignBitmapIndex(CMD_SAVEAS, 2)
    g_WndMenu.AssignBitmapIndex(CMD_PRINT, 8)
    g_WndMenu.AssignBitmapIndex(CMD_UNDO, 6)
    g_WndMenu.AssignBitmapIndex(CMD_REDO, 7)
    g_WndMenu.AssignBitmapIndex(CMD_CUT, 3)
    g_WndMenu.AssignBitmapIndex(CMD_COPY, 4)
    g_WndMenu.AssignBitmapIndex(CMD_PASTE, 5)
    g_WndMenu.AssignBitmapIndex(CMD_FIND, 9)
    g_WndMenu.AssignBitmapIndex(CMD_REPLACE, 10)
    g_WndMenu.AssignBitmapIndex(CMD_WORDWRAP, 12)
    g_WndMenu.AssignBitmapIndex(CMD_FONT, 13)
    g_WndMenu.AssignBitmapIndex(CMD_ONTOP, 14)

    INT i = 0
    FOR i = 100 TO 104                                   ' recent files -> document icon
        g_WndMenu.AssignBitmapIndex(i, 15)
    NEXT i
    g_WndMenu.AssignBitmapIndex(CMD_CLEAR_MRU, 16)       ' Clear Recent Files -> trash bin
    g_WndMenu.AssignBitmapIndex(CMD_ABOUT, 17)           ' About -> rounded question mark
    g_WndMenu.AssignBitmapIndex(CMD_EXIT, 18)            ' Exit -> red X
ENDSUB

SUB SyncThemeMenuCheck(INT selectedID)
    UINT hMenu = GetMenu(WIN.hwnd)
    IF hMenu <> 0 THEN
        CheckMenuRadioItem(hMenu, CMD_THEME_BASE, CMD_THEME_BASE + THEME_COUNT - 1, selectedID, MF_BYCOMMAND)
        DrawMenuBar(WIN.hwnd)
    ENDIF
ENDSUB

SUB SyncSyntaxMenuCheck(INT selectedID)
    UINT hMenu = GetMenu(WIN.hwnd)
    IF hMenu <> 0 THEN
        CheckMenuRadioItem(hMenu, 32, 41, selectedID, MF_BYCOMMAND)
        DrawMenuBar(WIN.hwnd)
    ENDIF
ENDSUB
': ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
': Main Window Handler
': ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
SUB TpadHandler(), INT

    INT hasMruItems = FALSE
    UINT clearFlags = 0

    Select @MESSAGE

        CASE WM_INITMENUPOPUP:

        ' @WPARAM contains the HMENU handle of the popup being opened
        '    IF @WPARAM <> 0 THEN
        '        g_WndMenu.EnableOwnerDraw(@WPARAM)
        '    ENDIF
        ' hMenuPassed is lParam (or wParam depending on wrapper)
        ' Check if the popup being opened is the Edit menu

        INT hBar = GetMenu(WIN.hwnd)
        IF hBar <> 0 THEN
            IF @WPARAM = GetSubMenu(hBar, GetMenuItemCount(hBar) - 1) THEN BuildRoutinesMenu(@WPARAM)
        ENDIF

        INT canUndo = SendMessage(g_hSciCtrl, SCI_CANUNDO, 0, 0)
        INT canRedo = SendMessage(g_hSciCtrl, SCI_CANREDO, 0, 0)

        ENABLEMENUITEM WIN, CMD_UNDO, canUndo
        ENABLEMENUITEM WIN, CMD_REDO, canRedo

        CASE WM_ENTERSIZEMOVE
            g_IsResizing = TRUE
            RETURN 0

        CASE WM_EXITSIZEMOVE
            g_IsResizing = FALSE
            IF g_IconSz > 16 THEN
                SendMessage(hToolBar, 0x0420, 0, (g_IconSz << 16) | g_IconSz)               ' TB_SETBITMAPSIZE
                SendMessage(hToolBar, 0x041F, 0, ((g_IconSz + 6) << 16) | (g_IconSz + 7))   ' TB_SETBUTTONSIZE
            ENDIF
            SendMessage(hToolBar, TB_AUTOSIZE, 0, 0)
            DoResize()
            ' UpdateGutter()
            DrawRuler()
            RETURN 0

        Case 32800
            IF g_IsLoading = FALSE THEN
                IF SendMessageA(g_hSciCtrl, SCI_GETMODIFY, 0, 0) <> 0 THEN
                    IF g_IsDirty = FALSE THEN
                        g_IsDirty = TRUE
                        UpdateTitleBar()
                    ENDIF
                ENDIF

                UpdateStatusBar()
                UpdateGutter()
                DrawRuler()
            ENDIF
            RETURN 0

        Case @IDCLOSEWINDOW
            IF UserCancelledDiscard() = TRUE THEN RETURN 0
            INIWrite()
            IF WIN.hwnd <> 0 THEN
                StopTimer(WIN, FILE_MONITOR_TIMER_ID)
                StopTimer(WIN, BALLOON_DISMISS_TIMER_ID)
            ENDIF

            DWORD tEnd = GetTickCount()
            DoEndProgram()
            Trace("DoEndProgram: " + STR$(GetTickCount() - tEnd) + " ms")
            PostQuitMessage(0)
            RETURN 0

        Case WM_SETFOCUS
            SetFocusA(g_hSciCtrl)

        Case @IDDROPFILES

            GetDroppedFiles(ds, 1)

            IF LEN(ds) > 0 THEN
                STRING droppedPath$ = ""
                DynaGetStr(ds, 0, droppedPath$)
                Trace("File dropped ! " + droppedPath$)
                IF LEN(droppedPath$) > 0 THEN
                    IF UserCancelledDiscard() = TRUE THEN RETURN 0
                    fName = droppedPath$            ' only now point DoOpen at the new file
                    DoOpen()

                    SendMessage(WIN, WM_ACTIVATEAPP, 0, 0)
                    SetForegroundWindow(WIN.hwnd)
                    SetFocusA(g_hSciCtrl)
                ENDIF
            ENDIF

        Case @IDERASEBACKGROUND
            DrawTBGradient()

            RETURN 1

        Case @IDTIMER
            Select @CODE
                Case BALLOON_DISMISS_TIMER_ID
                    STOPTIMER WIN, BALLOON_DISMISS_TIMER_ID
                    HideBalloonToast()

                Case FILE_MONITOR_TIMER_ID
                    CheckFileStatus()

                Case 3000
                    STOPTIMER WIN, 3000
                    DoOpen()
            EndSelect

        Case @IDSIZE
            DoResize()

        CASE WM_NOTIFY
            IF @LPARAM <> 0 THEN
                POINTER pNhdr
                pNhdr = @LPARAM
                SETTYPE pNhdr, Sci_NotifyHeader

                IF (#pNhdr.idFrom = IDC_SCI_CREATE) OR (#pNhdr.hwndFrom = g_hSciCtrl) THEN
                    POINTER pSCN
                    pSCN = @LPARAM
                    SETTYPE pSCN, SCNotification

                    SELECT #pNhdr.code
                        CASE SCN_MODIFIED
                            IF g_IsLoading = FALSE THEN
                                INT modType = #pSCN.modificationType
                                ' Trace("SCN_MODIFIED hit! modificationType: " + HEX$(modType))

                                IF (modType & (SC_MOD_INSERTTEXT | SC_MOD_DELETETEXT)) <> 0 THEN
                                    IF g_IsDirty = FALSE THEN
                                        g_IsDirty = TRUE
                                        UpdateTitleBar()
                                    ENDIF
                                    UpdateStatusBar()
                                    UpdateGutter()
                                ENDIF
                            ENDIF

                        CASE 2013                                   ' SCN_PAINTED
                            IF g_IsLoading = FALSE THEN StyleHexNumbers(FALSE)
                    ENDSELECT
                ENDIF
            ENDIF
            RETURN 0

        Case @IDMENUPICK

            INT pickID = @MENUNUM
            IF pickID >= CMD_CP_REL AND pickID < CMD_CP_REL + CP_COUNT THEN
                ReloadAsCP(pickID - CMD_CP_REL)
                RETURN 0
            ENDIF

            IF pickID >= CMD_THEME_BASE AND pickID < CMD_THEME_BASE + THEME_COUNT THEN
                ApplyThemeStyles(pickID - CMD_THEME_BASE)
                INIWrite()
                RETURN 0
            ENDIF

            IF pickID >= CMD_RTN_BASE AND pickID < CMD_RTN_BASE + RTN_MAX THEN
                INT rLn = g_rtnLine[pickID - CMD_RTN_BASE]
                INT rA  = SendMessageA(g_hSciCtrl, 2167, rLn, 0)          ' SCI_POSITIONFROMLINE
                INT rB  = SendMessageA(g_hSciCtrl, 2136, rLn, 0)          ' SCI_GETLINEENDPOSITION
                SendMessageA(g_hSciCtrl, 2160, rA, rB)                    ' SCI_SETSEL: select the line
                INT rV  = SendMessageA(g_hSciCtrl, 2220, rLn, 0) - 3      ' SCI_VISIBLEFROMDOCLINE, 3 lines of context
                IF rV < 0 THEN rV = 0
                SendMessageA(g_hSciCtrl, 2613, rV, 0)                     ' SCI_SETFIRSTVISIBLELINE
                UpdateGutter()
                SETFOCUS WIN, g_hSciCtrl
                RETURN 0
            ENDIF

            IF pickID >= CMD_TOOL_BASE AND pickID < CMD_TOOL_BASE + TOOL_MAX THEN
                RunTool(pickID - CMD_TOOL_BASE)
                RETURN 0
            ENDIF


            Select @MENUNUM

                Case CMD_EXIT
                   IF UserCancelledDiscard() = TRUE THEN RETURN 0
                   INIWrite()
                   IF WIN.hwnd <> 0 THEN
                     StopTimer(WIN, FILE_MONITOR_TIMER_ID)
                     StopTimer(WIN, BALLOON_DISMISS_TIMER_ID)
                   ENDIF

                   DoEndProgram()
                   PostQuitMessage(0)
                   RETURN 0

                Case CMD_CLEAR_MRU
                    ClearMRUHistory()
                    ShowBalloonToast("Tpad Notification", "Recent files history cleared !")

                Case CMD_TOOLS
                    ShowToolsConfig()

                Case CMD_NEW
                    IF UserCancelledDiscard() = TRUE THEN RETURN 0
                    FileNew()

                Case CMD_OPEN
                    IF UserCancelledDiscard() = TRUE THEN RETURN 0
                    fName = ""
                    DoOpen()

                Case CMD_SAVE
                    IF fName <> "" THEN
                        Save_As = 0
                    ELSE
                        Save_As = 1
                    ENDIF
                    DoSave()

                Case CMD_SAVEAS
                    Save_As = 1
                    DoSave()

                Case CMD_PRINT
                    DoPrint()
                    SetFocusA(g_hSciCtrl)

                Case CMD_UNDO
                    DoUndo(WIN, g_hSciCtrl)

                Case CMD_REDO
                    DoRedo(WIN, g_hSciCtrl)

                Case CMD_CUT
                    SendMessageA(g_hSciCtrl, SCI_CUT, 0, 0):UpdateGutter()

                Case CMD_COPY
                    SendMessageA(g_hSciCtrl, SCI_COPY, 0, 0)

                Case CMD_PASTE
                    SendMessageA(g_hSciCtrl, SCI_PASTE, 0, 0):UpdateGutter()

                Case CMD_SELECTALL
                    SendMessageA(g_hSciCtrl, SCI_SELECTALL, 0, -1)

                Case CMD_FIND
                    Show_Find(WIN, g_hSciCtrl, FALSE):RETURN 0

                Case CMD_REPLACE
                    Show_Find(WIN, g_hSciCtrl, TRUE):RETURN 0

                Case CMD_FINDNEXT
                    FindAgain(FALSE)

                Case CMD_FINDPREV
                    FindAgain(TRUE)

                Case CMD_WORDWRAP
                    ToggleWordWrap()

                Case CMD_FONT
                    OpenFontDialog()

                Case CMD_ONTOP
                    ToggleOnTop()

                Case CMD_ABOUT
                    DOMODAL About

                CASE 32 ' Default (Plain Text)
                    SetLexerByExtension("file.txt")
                    SyncSyntaxMenuCheck(32)
                CASE 33 ' Assembler
                    SetLexerByExtension("file.asm")
                    SyncSyntaxMenuCheck(33)
                CASE 34 ' Basic
                    SetLexerByExtension("file.iwb")
                    SyncSyntaxMenuCheck(34)
                CASE 35 ' C / C++
                    SetLexerByExtension("file.cpp")
                    SyncSyntaxMenuCheck(35)
                CASE 36 ' Python
                    SetLexerByExtension("file.py")
                    SyncSyntaxMenuCheck(36)
                CASE 37 ' Perl
                    SetLexerByExtension("file.pl")
                    SyncSyntaxMenuCheck(37)
                CASE 38 ' Makefile
                    SetLexerByExtension("file.mak")
                    SyncSyntaxMenuCheck(38)
                CASE 39 ' Batch
                    SetLexerByExtension("file.bat")
                    SyncSyntaxMenuCheck(39)
                CASE 40 ' Diff
                    SetLexerByExtension("file.diff")
                    SyncSyntaxMenuCheck(40)
                CASE 41 ' Lua
                    SetLexerByExtension("file.lua")
                    SyncSyntaxMenuCheck(41)

                Case CMD_SHOW_INDENT
                  ToggleViewOption(CMD_SHOW_INDENT)
                Case CMD_SHOW_EOL
                   ToggleViewOption(CMD_SHOW_EOL)
                Case CMD_SHOW_WS
                   ToggleViewOption(CMD_SHOW_WS)
                Case CMD_SHOW_WRAPSYM
                   ToggleViewOption(CMD_SHOW_WRAPSYM)

                Case CMD_TABS_SPACES
                    ToggleEditOption(CMD_TABS_SPACES)
                Case CMD_AUTOINDENT
                    ToggleEditOption(CMD_AUTOINDENT)
                Case CMD_BRACEMATCH
                    ToggleEditOption(CMD_BRACEMATCH)
                Case CMD_TRIM_SAVE
                    ToggleEditOption(CMD_TRIM_SAVE)
                Case CMD_FINAL_NL
                    ToggleEditOption(CMD_FINAL_NL)

                Case CMD_EOL_CRLF
                    SetEOLMode(0, TRUE)
                Case CMD_EOL_LF
                    SetEOLMode(2, TRUE)
                Case CMD_EOL_CR
                    SetEOLMode(1, TRUE)

                Case 60
                    SetEncoding(ENC_ANSI)
                Case 61
                    SetEncoding(ENC_UTF8)
                Case 62
                    SetEncoding(ENC_UTF8BOM)
                Case 63
                    SetEncoding(ENC_U16LE_BOM)
                Case 64
                    SetEncoding(ENC_U16BE_BOM)
                Case 65
                    SetEncoding(ENC_U16LE)
                Case 66
                    SetEncoding(ENC_U16BE)
                Case 70
                    ReloadAs(ENC_ANSI)
                Case 71
                    ReloadAs(ENC_UTF8)
                Case 72
                    ReloadAs(ENC_UTF8BOM)
                Case 73
                    ReloadAs(ENC_U16LE_BOM)
                Case 74
                    ReloadAs(ENC_U16BE_BOM)
                Case 75
                    ReloadAs(ENC_U16LE)
                Case 76
                    ReloadAs(ENC_U16BE)

                Case 100 : OpenRecentFile(0)
                Case 101 : OpenRecentFile(1)
                Case 102 : OpenRecentFile(2)
                Case 103 : OpenRecentFile(3)
                Case 104 : OpenRecentFile(4)

            EndSelect

        Case @IDCONTROL

            Select @CONTROLID

                Case CMD_NEW
                    If @NotifyCode = 0
                        IF UserCancelledDiscard() = TRUE THEN RETURN 0
                        FileNew()
                    EndIf

                Case CMD_OPEN
                    If @NotifyCode = 0
                        IsFileChanged()
                        fName = ""
                        DoOpen()
                    EndIf

                Case CMD_SAVE
                    If @NotifyCode = 0
                        IF fName <> "" THEN
                            Save_As = 0
                        ELSE
                            Save_As = 1
                        ENDIF
                        DoSave()
                    EndIf

                Case CMD_CUT
                    If @NotifyCode = 0 THEN SendMessageA(g_hSciCtrl, SCI_CUT, 0, 0):UpdateGutter()

                Case CMD_COPY
                    If @NotifyCode = 0 THEN SendMessageA(g_hSciCtrl, SCI_COPY, 0, 0)

                Case CMD_PASTE
                    If @NotifyCode = 0 THEN SendMessageA(g_hSciCtrl, SCI_PASTE, 0, 0):UpdateGutter()

                Case CMD_UNDO
                    If @NotifyCode = 0 THEN DoUndo(WIN, g_hSciCtrl)

                Case CMD_REDO
                    If @NotifyCode = 0 THEN DoRedo(WIN, g_hSciCtrl)

                Case CMD_PRINT
                    If @NotifyCode = 0
                        DoPrint()
                        SetFocusA(g_hSciCtrl)
                    EndIf

                Case CMD_FIND
                    If @NotifyCode = 0 THEN Show_Find(WIN, g_hSciCtrl, FALSE)

                Case CMD_REPLACE
                    If @NotifyCode = 0 THEN Show_Find(WIN, g_hSciCtrl, TRUE)

                Case CMD_PROPERTIES
                    If @NotifyCode = 0 Then
                        If fName = "" OR fName = "Empty" Then
                            'MESSAGEBOX(WIN, "No file is currently open.", "Properties", @MB_ICONINFORMATION)
                            ShowBalloonToast("Properties", "No file is currently open.")
                            SetFocusA(g_hSciCtrl)
                        Else
                            OleInitialize(0)

                            SHELLEXECUTEINFO sei
                            RtlZeroMemory(&sei, LEN(sei))

                            STRING szVerb = "properties"
                            STRING szFile = fName

                            sei.cbSize = LEN(sei)
                            sei.fMask = 0x0000000C
                            sei.hwnd = WIN.hwnd
                            sei.lpVerb = &szVerb
                            sei.lpFile = &szFile
                            sei.lpParameters = NULL
                            sei.nShow = SW_SHOW

                            If ShellExecuteExA(&sei) = FALSE Then
                                'MESSAGEBOX(WIN, "Unable to display file properties.", "Properties Error", @MB_ICONSTOP)
                                ShowBalloonToast("Properties Error", "Unable to display file properties.")
                            EndIf

                            OleUninitialize()
                            SetFocusA(g_hSciCtrl)
                        EndIf
                    EndIf

                Case CMD_WORDWRAP
                    If @NotifyCode = 0 THEN ToggleWordWrap()

                Case CMD_FONT
                    If @NotifyCode = 0 THEN OpenFontDialog()

                Case CMD_ONTOP
                    If @NotifyCode = 0 THEN ToggleOnTop()

                Case CMD_ABOUT
                    If @NotifyCode = 0 THEN DOMODAL About

                Case CMD_TOOLS
                    If @NotifyCode = 0
                        ShowToolsConfig()
                    EndIf

                Case IDC_SCI_CREATE
                    IF g_IsLoading = FALSE THEN
                        Select @NOTIFYCODE
                            Case TP_SCN_CHARADDED
                                HandleAutoIndent()
                            Case TP_SCN_UPDATEUI
                                UpdateBraceMatch()
                                StyleHexNumbers(TRUE)
                        EndSelect
                        UpdateStatusBar()
                    ENDIF

                Case 101 ' GOTO LINE BOX
                    If @NOTIFYCODE = @ENSETFOCUS Then
                        If GETCONTROLTEXT(WIN, 101) = "Goto Line" THEN SETCONTROLTEXT WIN, 101, ""
                    EndIf

                Case 102
                    If @NOTIFYCODE = 0 THEN Edit_Scroll_2Line()

                Case 103
                    If @NOTIFYCODE = 0 THEN Edit_Scroll_2top()

                Case 104
                    If @NOTIFYCODE = 0 THEN Edit_Scroll_2bottom()

                Case 2000
                    Select @NOTIFYCODE
                        Case TBN_DROPDOWN
                            IF ToolbarDropIsTools() THEN
                                ShowToolsMenu()
                                RETURN 0
                            ENDIF
                            INT mc = 0
                            UINT hMruMenu = 0

                            For mc = 0 TO 4
                                ' If string is NOT empty AND NOT "Empty", it's a valid MRU file entry
                                IF (g_App.mru[mc] = "") OR (g_App.mru[mc] = "Empty") THEN
                                    g_App.mruFlags[mc] = @MENUDISABLE
                                Else
                                    g_App.mruFlags[mc] = 0
                                EndIf
                            Next mc

                            hMruMenu = CreatePopupMenu()

                            If hMruMenu <> 0 Then
                                INT mi = 0
                                FOR mi = 0 TO 4
                                    AppendMenuA(hMruMenu, g_App.mruFlags[mi], 100 + mi, MruCaption(g_App.mru[mi], 60))
                                NEXT mi

                                ' Add separator and Clear action using standard IF check
                                AppendMenuA(hMruMenu, MF_SEPARATOR, 0, NULL)
                                AppendMenuA(hMruMenu, 0, CMD_CLEAR_MRU, "Clear Recent Files")

                                g_WndMenu.SkinPopup(hMruMenu)

                                ' Query the bounding box of the Open toolbar button (CMD_OPEN = ID 2)
                                WINRECT rcBtn
                                SendMessageA(hToolBar, TB_GETRECT, CMD_OPEN, &rcBtn)

                                ' Convert button coordinates from toolbar client space to screen space
                                POINT pt
                                pt.x = rcBtn.left
                                pt.y = rcBtn.bottom
                                ClientToScreen(hToolBar, &pt)

                                TrackPopupMenu(hMruMenu, TPM_LEFTALIGN | TPM_RIGHTBUTTON, pt.x, pt.y, 0, WIN.hwnd, NULL)
                                DestroyMenu(hMruMenu)
                            EndIf

                    EndSelect
            EndSelect
    EndSelect

Return 0
EndSub

SUB UserCancelledDiscard(), INT
    CancelAction = FALSE
    IsFileChanged()
    RETURN CancelAction
ENDSUB

': ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
': ConfigureScintillaDefaults - Unlocks Read-Only & Enables Input
': ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
SUB ConfigureScintillaDefaults()
    IF g_hSciCtrl = 0 THEN RETURN

    ' Initialize Balloon Tooltip Overlay Window attached to main window
    IF g_hwndToolTip = 0 AND WIN.hwnd <> 0 THEN
        HINSTANCE hInst = GetModuleHandleA(0)
        g_hwndToolTip = CreateWindowExA(0, "tooltips_class32", "", _
            0x01 | 0x40, _
            CW_USEDEFAULT, CW_USEDEFAULT, CW_USEDEFAULT, CW_USEDEFAULT, _
            WIN.hwnd, 0, hInst, 0)

        IF g_hwndToolTip <> 0 THEN
            SetWindowPos(g_hwndToolTip, HWND_TOPMOST, 0, 0, 0, 0, SWP_NOMOVE | SWP_NOSIZE | SWP_NOACTIVATE)
            SendMessageA(g_hwndToolTip, TTM_SETMAXTIPWIDTH, 0, 400)
        ENDIF
    ENDIF

    SendMessageA(g_hSciCtrl, SCI_SETREADONLY, FALSE, 0)
    SendMessageA(g_hSciCtrl, SCI_SETCODEPAGE, SC_CP_UTF8, 0)

    INT bgColor = RGB(253, 246, 227)
    SendMessageA(g_hSciCtrl, SCI_STYLESETBACK, STYLE_DEFAULT, bgColor)

    ISTRING fontBuf[64]
    IF g_App.fontName <> "" THEN
        fontBuf = g_App.fontName
    ELSE
        fontBuf = "Consolas"
    ENDIF
    SendMessageA(g_hSciCtrl, SCI_STYLESETFONT, STYLE_DEFAULT, &fontBuf)

    INT fSize = g_App.fontSize
    IF fSize <= 0 THEN fSize = 10
    SendMessageA(g_hSciCtrl, SCI_STYLESETSIZE, STYLE_DEFAULT, fSize)

    INT isBold = FALSE
    IF g_App.fontWeight >= 700 OR (g_App.fontFlags & 1) THEN isBold = TRUE
    SendMessageA(g_hSciCtrl, SCI_STYLESETBOLD, STYLE_DEFAULT, isBold)

    INT isItalic = FALSE
    IF (g_App.fontFlags & 2) <> 0 THEN isItalic = TRUE
    SendMessageA(g_hSciCtrl, SCI_STYLESETITALIC, STYLE_DEFAULT, isItalic)

    SendMessageA(g_hSciCtrl, SCI_STYLECLEARALL, 0, 0)

    SendMessageA(g_hSciCtrl, SCI_SETMARGINWIDTHN, 0, 0)
    SendMessageA(g_hSciCtrl, SCI_SETUNDOCOLLECTION, TRUE, 0)

    SendMessageA(g_hSciCtrl, SCI_SETMODEVENTMASK, SC_MOD_INSERTTEXT | SC_MOD_DELETETEXT, 0)

    SendMessageA(g_hSciCtrl, SCI_CLEARCMDKEY, ASC("C") + (2 << 16), 0)
    SendMessageA(g_hSciCtrl, SCI_CLEARCMDKEY, ASC("X") + (2 << 16), 0)
    SendMessageA(g_hSciCtrl, SCI_CLEARCMDKEY, ASC("V") + (2 << 16), 0)
    SendMessageA(g_hSciCtrl, SCI_CLEARCMDKEY, ASC("Z") + (2 << 16), 0)
    SendMessageA(g_hSciCtrl, SCI_CLEARCMDKEY, ASC("Y") + (2 << 16), 0)
    SendMessageA(g_hSciCtrl, SCI_CLEARCMDKEY, ASC("A") + (2 << 16), 0)

    SendMessageA(g_hSciCtrl, 2371, 0, 0)    ' SCI_USEPOPUP = 2371, 0 = SC_POPUP_NEVER
ENDSUB

SUB ApplyViewOptions()
    IF g_hSciCtrl = 0 THEN RETURN

    ' Indentation guides: they need an indent unit (0 = use tab width, 8) and a visible colour
    SendMessageA(g_hSciCtrl, 2122, 4, 0)                    ' SCI_SETINDENT = 4
    SendMessageA(g_hSciCtrl, SCI_STYLESETFORE, 37, RGB(160, 160, 160))   ' STYLE_INDENTGUIDE
    IF g_App.showIndent THEN
        SendMessageA(g_hSciCtrl, 2132, 3, 0)       ' SC_IV_LOOKBOTH
    ELSE
        SendMessageA(g_hSciCtrl, 2132, 0, 0)
    ENDIF

    ' Line endings
    IF g_App.showEOL THEN
        SendMessageA(g_hSciCtrl, 2356, 1, 0)
    ELSE
        SendMessageA(g_hSciCtrl, 2356, 0, 0)
    ENDIF

    ' Whitespace and tabs
    IF g_App.showWS THEN
        SendMessageA(g_hSciCtrl, 2021, 1, 0)       ' VISIBLEALWAYS
    ELSE
        SendMessageA(g_hSciCtrl, 2021, 0, 0)
    ENDIF

    ' Wrap symbol
    IF g_App.showWrapSym THEN
        SendMessageA(g_hSciCtrl, 2460, 1, 0)                   ' SC_WRAPVISUALFLAG_END
        SendMessageA(g_hSciCtrl, 2157, 0, DpiPx(14))           ' SCI_SETMARGINRIGHT: room to draw it
    ELSE
        SendMessageA(g_hSciCtrl, 2460, 0, 0)
        SendMessageA(g_hSciCtrl, 2157, 0, 0)
    ENDIF

    ' Colour for the wrap symbol (also used for visible whitespace dots and tabs)
    IF g_App.themeID = 1 THEN
        SendMessageA(g_hSciCtrl, 2084, 1, g_thWs)                ' SCI_SETWHITESPACEFORE
    ELSE
        SendMessageA(g_hSciCtrl, 2084, 1, RGB(0, 100, 180))    ' light theme
    ENDIF

    INT v = 0
    v = 0 : IF g_App.showIndent  <> 0 THEN v = 1
    CHECKMENUITEM WIN, CMD_SHOW_INDENT,  v
    v = 0 : IF g_App.showEOL     <> 0 THEN v = 1
    CHECKMENUITEM WIN, CMD_SHOW_EOL,     v
    v = 0 : IF g_App.showWS      <> 0 THEN v = 1
    CHECKMENUITEM WIN, CMD_SHOW_WS,      v
    v = 0 : IF g_App.showWrapSym <> 0 THEN v = 1
    CHECKMENUITEM WIN, CMD_SHOW_WRAPSYM, v
    ' Trace("ApplyViewOptions: WS=" + STR$(g_App.showWS) + " menuState=" + STR$(GetMenuState(GetMenu(WIN.hwnd), CMD_SHOW_WS, MF_BYCOMMAND)))

    ApplyEditOptions()
ENDSUB

SUB ToggleViewOption(INT cmd)
    SELECT cmd
        CASE CMD_SHOW_INDENT
            IF g_App.showIndent <> 0 THEN
                g_App.showIndent = 0
            ELSE
                g_App.showIndent = 1
            ENDIF
        CASE CMD_SHOW_EOL
            IF g_App.showEOL <> 0 THEN
                g_App.showEOL = 0
            ELSE
                g_App.showEOL = 1
            ENDIF
        CASE CMD_SHOW_WS
            IF g_App.showWS <> 0 THEN
                g_App.showWS = 0
            ELSE
                g_App.showWS = 1
            ENDIF
        CASE CMD_SHOW_WRAPSYM
            IF g_App.showWrapSym <> 0 THEN
                g_App.showWrapSym = 0
            ELSE
                g_App.showWrapSym = 1
            ENDIF
    ENDSELECT
    ApplyViewOptions()
    UpdateGutter()
ENDSUB

SUB MixCol(INT c1, INT c2, INT pct), INT
    INT r = ((c1 & 0xFF) * (100 - pct) + (c2 & 0xFF) * pct) / 100
    INT g = (((c1 >> 8) & 0xFF) * (100 - pct) + ((c2 >> 8) & 0xFF) * pct) / 100
    INT b = (((c1 >> 16) & 0xFF) * (100 - pct) + ((c2 >> 16) & 0xFF) * pct) / 100
    RETURN r | (g << 8) | (b << 16)
ENDSUB

SUB ApplyThemeStyles(INT themeID)
    INT hSci = g_hSciCtrl
    IF (hSci = 0) THEN RETURN

    IF themeID < 0 OR themeID >= THEME_COUNT THEN themeID = 0
    g_App.themeID = themeID
    SyncThemeMenuCheck(CMD_THEME_BASE + themeID)

    IF (g_hEditorFont <> 0)
        DeleteObject(g_hEditorFont)
        g_hEditorFont = 0
    ENDIF

    STRING fontName$ = g_App.fontName
    IF fontName$ = "" THEN fontName$ = "Consolas"

    INT fontSize = g_App.fontSize
    IF fontSize <= 0 THEN fontSize = 10

    g_hEditorFont = CreateFontA( _
        -MulDiv(fontSize, GetDeviceCaps(GetDC(WIN.hwnd), 90), 72), 0, 0, 0, _
        g_App.fontWeight, (g_App.fontFlags & 2), (g_App.fontFlags & 4), 0, _
        0, 0, 0, 5, 0, fontName$ _
    )

    INT bgCol, fgCol, selBgCol, curLineBg, commentCol, kwdCol, kwd2Col, kwd3Col, kwd4Col, strCol, numCol, opCol, caretColor

    SELECT themeID
        CASE 1 ' Dark Modern
            bgCol      = 0x1C1C1C
            fgCol      = 0xF0FAFF
            selBgCol   = 0x8080
            curLineBg  = 0x262A2B
            commentCol = 0x8CE6F0
            kwdCol     = 0x00D7FF
            kwd2Col    = 0xFFD700
            kwd3Col    = 0xFF96BE
            kwd4Col    = 0xBE8CFF
            strCol     = 0x8FBC8F
            numCol     = 0x4763FF
            opCol      = 0xD0E040
            caretColor = 0x258FF5
            g_thWs      = RGB(110, 170, 210)
            g_thBraceFg = RGB(255, 215, 0)
            g_thBraceBg = RGB(70, 80, 100)
            g_thBadBg   = RGB(170, 40, 40)

        CASE 2 ' Solarized Dark
            bgCol      = RGB(0, 43, 54)
            fgCol      = RGB(131, 148, 150)
            selBgCol   = 0xFFFF
            curLineBg  = RGB(7, 54, 66)
            commentCol = RGB(88, 110, 117)
            kwdCol     = RGB(181, 137, 0)
            kwd2Col    = RGB(203, 75, 22)
            kwd3Col    = RGB(38, 139, 210)
            kwd4Col    = RGB(211, 54, 130)
            strCol     = RGB(42, 161, 152)
            numCol     = RGB(220, 50, 47)
            opCol      = RGB(147, 161, 161)
            caretColor = RGB(181, 137, 0)
            g_thWs      = RGB(88, 110, 117)
            g_thBraceFg = RGB(253, 246, 227)
            g_thBraceBg = RGB(38, 139, 210)
            g_thBadBg   = RGB(220, 50, 47)

        CASE 3 ' Solarized Light
            bgCol      = RGB(253, 246, 227)
            fgCol      = RGB(101, 123, 131)
            selBgCol   = 0xFFFF
            curLineBg  = RGB(238, 232, 213)
            commentCol = RGB(147, 161, 161)
            kwdCol     = RGB(133, 153, 0)
            kwd2Col    = RGB(203, 75, 22)
            kwd3Col    = RGB(38, 139, 210)
            kwd4Col    = RGB(211, 54, 130)
            strCol     = RGB(42, 161, 152)
            numCol     = RGB(220, 50, 47)
            opCol      = RGB(88, 110, 117)
            caretColor = RGB(220, 50, 47)
            g_thWs      = RGB(147, 161, 161)
            g_thBraceFg = RGB(253, 246, 227)
            g_thBraceBg = RGB(38, 139, 210)
            g_thBadBg   = RGB(220, 50, 47)

        CASE 4 ' Monokai
            bgCol      = RGB(39, 40, 34)
            fgCol      = RGB(248, 248, 242)
            selBgCol   = RGB(150, 150, 120)
            curLineBg  = RGB(62, 61, 50)
            commentCol = RGB(117, 113, 94)
            kwdCol     = RGB(249, 38, 114)
            kwd2Col    = RGB(166, 226, 46)
            kwd3Col    = RGB(102, 217, 239)
            kwd4Col    = RGB(174, 129, 255)
            strCol     = RGB(230, 219, 116)
            numCol     = RGB(253, 151, 31)
            opCol      = RGB(200, 200, 190)
            caretColor = RGB(248, 248, 240)
            g_thWs      = RGB(90, 90, 80)
            g_thBraceFg = RGB(230, 219, 116)
            g_thBraceBg = RGB(73, 72, 62)
            g_thBadBg   = RGB(249, 38, 114)

        CASE 5 ' Dracula
            bgCol      = RGB(40, 42, 54)
            fgCol      = RGB(248, 248, 242)
            selBgCol   = 0x4763FF
            curLineBg  = RGB(68, 71, 90)
            commentCol = RGB(98, 114, 164)
            kwdCol     = RGB(255, 121, 198)
            kwd2Col    = RGB(80, 250, 123)
            kwd3Col    = RGB(139, 233, 253)
            kwd4Col    = RGB(189, 147, 249)
            strCol     = RGB(241, 250, 140)
            numCol     = RGB(255, 184, 108)
            opCol      = RGB(200, 200, 210)
            caretColor = RGB(248, 248, 242)
            g_thWs      = RGB(98, 114, 164)
            g_thBraceFg = RGB(241, 250, 140)
            g_thBraceBg = RGB(98, 114, 164)
            g_thBadBg   = RGB(255, 85, 85)

        CASE 6 ' Nord
            bgCol      = RGB(46, 52, 64)
            fgCol      = RGB(216, 222, 233)
            selBgCol   = 0xA5FF
            curLineBg  = RGB(59, 66, 82)
            commentCol = RGB(110, 126, 152)
            kwdCol     = RGB(129, 161, 193)
            kwd2Col    = RGB(191, 97, 106)
            kwd3Col    = RGB(136, 192, 208)
            kwd4Col    = RGB(180, 142, 173)
            strCol     = RGB(163, 190, 140)
            numCol     = RGB(235, 203, 139)
            opCol      = RGB(170, 180, 200)
            caretColor = RGB(216, 222, 233)
            g_thWs      = RGB(76, 86, 106)
            g_thBraceFg = RGB(235, 203, 139)
            g_thBraceBg = RGB(76, 86, 106)
            g_thBadBg   = RGB(191, 97, 106)

        CASE 7 ' Gruvbox Dark
            bgCol      = RGB(40, 40, 40)
            fgCol      = RGB(235, 219, 178)
            selBgCol   = 0xB3DEF5
            curLineBg  = RGB(60, 56, 54)
            commentCol = RGB(146, 131, 116)
            kwdCol     = RGB(251, 73, 52)
            kwd2Col    = RGB(254, 128, 25)
            kwd3Col    = RGB(131, 165, 152)
            kwd4Col    = RGB(211, 134, 155)
            strCol     = RGB(184, 187, 38)
            numCol     = RGB(250, 189, 47)
            opCol      = RGB(168, 153, 132)
            caretColor = RGB(254, 128, 25)
            g_thWs      = RGB(80, 73, 69)
            g_thBraceFg = RGB(250, 189, 47)
            g_thBraceBg = RGB(80, 73, 69)
            g_thBadBg   = RGB(204, 36, 29)

        CASE 8 ' Retro Green CRT
            bgCol      = RGB(0, 16, 0)
            fgCol      = RGB(51, 255, 51)
            selBgCol   = 0x32CD9A
            curLineBg  = RGB(0, 32, 0)
            commentCol = RGB(0, 128, 0)
            kwdCol     = RGB(220, 255, 200)
            kwd2Col    = RGB(102, 255, 178)
            kwd3Col    = RGB(153, 255, 51)
            kwd4Col    = RGB(0, 255, 153)
            strCol     = RGB(0, 204, 102)
            numCol     = RGB(255, 255, 102)
            opCol      = RGB(0, 180, 0)
            caretColor = RGB(51, 255, 51)
            g_thWs      = RGB(0, 90, 0)
            g_thBraceFg = RGB(0, 16, 0)
            g_thBraceBg = RGB(51, 255, 51)
            g_thBadBg   = RGB(200, 0, 0)

        CASE 9 ' Amber CRT
            bgCol      = RGB(24, 14, 0)
            fgCol      = RGB(255, 176, 0)
            selBgCol   = 0xF5F5F5 'RGB(180, 110, 0)
            curLineBg  = RGB(40, 24, 0)
            commentCol = RGB(140, 90, 0)
            kwdCol     = RGB(255, 220, 128)
            kwd2Col    = RGB(255, 140, 0)
            kwd3Col    = RGB(255, 200, 60)
            kwd4Col    = RGB(255, 120, 40)
            strCol     = RGB(220, 150, 30)
            numCol     = RGB(255, 235, 160)
            opCol      = RGB(200, 130, 0)
            caretColor = RGB(255, 176, 0)
            g_thWs      = RGB(100, 62, 0)
            g_thBraceFg = RGB(24, 14, 0)
            g_thBraceBg = RGB(255, 176, 0)
            g_thBadBg   = RGB(200, 40, 0)

        CASE 10 ' Paper (Sepia)
            bgCol      = RGB(244, 236, 216)
            fgCol      = RGB(59, 47, 34)
            selBgCol   = 0xD7FF
            curLineBg  = RGB(234, 224, 198)
            commentCol = RGB(138, 128, 110)
            kwdCol     = RGB(150, 50, 30)
            kwd2Col    = RGB(40, 100, 130)
            kwd3Col    = RGB(40, 110, 100)
            kwd4Col    = RGB(120, 60, 120)
            strCol     = RGB(80, 120, 40)
            numCol     = RGB(190, 80, 20)
            opCol      = RGB(110, 90, 70)
            caretColor = RGB(150, 50, 30)
            g_thWs      = RGB(190, 175, 150)
            g_thBraceFg = RGB(59, 47, 34)
            g_thBraceBg = RGB(215, 195, 150)
            g_thBadBg   = RGB(190, 60, 50)

        DEFAULT ' Classic Light
            bgCol      = 0xE7F6FD
            fgCol      = 0x362B00
            selBgCol   = 0x00FFFF
            curLineBg  = 0xDAEFEF
            commentCol = 0x008000
            kwdCol     = 0x0064B4
            kwd2Col    = 0xEE687B
            kwd3Col    = 0x808000
            kwd4Col    = 0x783CAA
            strCol     = 0x8B008B
            numCol     = 0x0045FF
            opCol      = 0xCD5A6A
            caretColor = 0x3C14DC
            g_thWs      = RGB(0, 100, 180)
            g_thBraceFg = RGB(0, 0, 200)
            g_thBraceBg = RGB(190, 215, 255)
            g_thBadBg   = RGB(220, 60, 60)
    ENDSELECT


    ISTRING fBuf[64]
    fBuf = fontName$
    SendMessageA(hSci, SCI_STYLESETFONT, STYLE_DEFAULT, &fBuf)
    SendMessageA(hSci, SCI_STYLESETSIZE, STYLE_DEFAULT, fontSize)
    SendMessageA(hSci, SCI_STYLESETFORE, STYLE_DEFAULT, fgCol)
    SendMessageA(hSci, SCI_STYLESETBACK, STYLE_DEFAULT, bgCol)

    SendMessageA(hSci, SCI_STYLECLEARALL, 0, 0)

    SendMessageA(hSci, SCI_SETSELBACK, TRUE, selBgCol)
    SendMessageA(hSci, SCI_SETSELALPHA, 80, 0)
    SendMessageA(hSci, SCI_SETCARETFORE, caretColor, 0)
    SendMessageA(hSci, SCI_SETCARETLINEBACK, curLineBg, 0)
    SendMessageA(hSci, SCI_SETCARETLINEVISIBLE, TRUE, 0)

    ' Copy default foreground/background to ALL styles (0-255)
    SendMessageA(hSci, SCI_STYLECLEARALL, 0, 0)

    ' ========================================================================
    ' IF PLAIN TEXT / DEFAULT SYNTAX IS ACTIVE, DO NOT APPLY SYNTAX COLORS
    ' ========================================================================
    IF g_activeLexer = SCLEX_NULL THEN
        SendMessageA(hSci, SCI_SETCARETWIDTH, DpiPx(2), 0)
        SendMessageA(hSci, SCI_SETCARETSTYLE, CARETSTYLE_LINE, 0)
        'SendMessageA(hSci, SCI_SETVIEWWS, SCWS_VISIBLEALWAYS, 0)
        SendMessageA(hSci, SCI_SETWHITESPACESIZE, 2, 0)
        SendMessageA(hSci, SCI_SETEDGEMODE, SC_EDGE_LINE, 0)
        SendMessageA(hSci, SCI_SETEDGECOLUMN, 80, 0)

        ApplyViewOptions()

        InvalidateRect(hSci, NULL, TRUE)
        SetFocusA(hSci)
        RETURN
    ENDIF

    ' ========================================================================
    ' Per-lexer styles: every lexer has its OWN style numbering, so only the
    ' table of the active lexer may be applied.
    ' ========================================================================
    SendMessageA(hSci, SCI_STYLESETFORE, 0, fgCol)        ' Default
    SendMessageA(hSci, SCI_STYLESETBACK, 0, bgCol)

    SELECT g_activeLexer

        ' ---- C / C++ (SCE_C_*) -------------------------------------------
        CASE SCLEX_CPP
            SendMessageA(hSci, SCI_STYLESETFORE, 1, commentCol)    ' COMMENT
            SendMessageA(hSci, SCI_STYLESETFORE, 2, commentCol)    ' COMMENTLINE
            SendMessageA(hSci, SCI_STYLESETFORE, 3, commentCol)    ' COMMENTDOC
            SendMessageA(hSci, SCI_STYLESETFORE, 15, commentCol)   ' COMMENTLINEDOC
            SendMessageA(hSci, SCI_STYLESETFORE, 17, commentCol)   ' COMMENTDOCKEYWORD
            SendMessageA(hSci, SCI_STYLESETITALIC, 1, TRUE)
            SendMessageA(hSci, SCI_STYLESETITALIC, 2, TRUE)
            SendMessageA(hSci, SCI_STYLESETITALIC, 3, TRUE)
            SendMessageA(hSci, SCI_STYLESETITALIC, 15, TRUE)
            SendMessageA(hSci, SCI_STYLESETFORE, 4, numCol)        ' NUMBER
            SendMessageA(hSci, SCI_STYLESETFORE, 5, kwdCol)        ' WORD (set 0) -> GOLD
            SendMessageA(hSci, SCI_STYLESETBOLD, 5, TRUE)
            SendMessageA(hSci, SCI_STYLESETFORE, 6, strCol)        ' STRING
            SendMessageA(hSci, SCI_STYLESETFORE, 7, strCol)        ' CHARACTER
            SendMessageA(hSci, SCI_STYLESETFORE, 12, strCol)       ' STRINGEOL
            SendMessageA(hSci, SCI_STYLESETFORE, 9, kwd2Col)       ' PREPROCESSOR -> CYAN
            SendMessageA(hSci, SCI_STYLESETFORE, 10, opCol)        ' OPERATOR
            SendMessageA(hSci, SCI_STYLESETFORE, 11, fgCol)        ' IDENTIFIER
            SendMessageA(hSci, SCI_STYLESETFORE, 16, kwd2Col)      ' WORD2 (set 1)

        ' ---- IWBasic / FreeBasic (SCE_B_*) -------------------------------
        CASE SCLEX_FREEBASIC
            SendMessageA(hSci, SCI_STYLESETFORE, 1, commentCol)    ' COMMENT
            SendMessageA(hSci, SCI_STYLESETITALIC, 1, TRUE)
            SendMessageA(hSci, SCI_STYLESETFORE, 2, numCol)        ' NUMBER
            SendMessageA(hSci, SCI_STYLESETFORE, 17, numCol)       ' HEXNUMBER
            SendMessageA(hSci, SCI_STYLESETFORE, 18, numCol)       ' BINNUMBER
            SendMessageA(hSci, SCI_STYLESETFORE, 3, kwdCol)        ' KEYWORD  (set 0) -> GOLD
            SendMessageA(hSci, SCI_STYLESETBOLD, 3, TRUE)
            SendMessageA(hSci, SCI_STYLESETFORE, 4, strCol)        ' STRING
            SendMessageA(hSci, SCI_STYLESETFORE, 8, strCol)        ' DATE
            SendMessageA(hSci, SCI_STYLESETFORE, 9, strCol)        ' STRINGEOL
            SendMessageA(hSci, SCI_STYLESETFORE, 5, kwd2Col)       ' PREPROCESSOR -> CYAN
            SendMessageA(hSci, SCI_STYLESETFORE, 6, opCol)         ' OPERATOR
            SendMessageA(hSci, SCI_STYLESETFORE, 7, fgCol)         ' IDENTIFIER
            SendMessageA(hSci, SCI_STYLESETFORE, 10, kwd2Col)      ' KEYWORD2 (set 1) -> CYAN
            SendMessageA(hSci, SCI_STYLESETBOLD, 10, TRUE)
            SendMessageA(hSci, SCI_STYLESETFORE, 11, kwd3Col)      ' KEYWORD3 (set 2) -> library commands
            SendMessageA(hSci, SCI_STYLESETFORE, 12, kwd4Col)      ' KEYWORD4 (set 3) -> constants / types
            SendMessageA(hSci, SCI_STYLESETFORE, 13, kwd4Col)      ' CONSTANT
            SendMessageA(hSci, SCI_STYLESETFORE, 15, kwd2Col)      ' LABEL

        ' ---- x86 assembly (SCE_ASM_*) ------------------------------------
        CASE SCLEX_ASM
            SendMessageA(hSci, SCI_STYLESETFORE, 1, commentCol)    ' COMMENT
            SendMessageA(hSci, SCI_STYLESETFORE, 11, commentCol)   ' COMMENTBLOCK
            SendMessageA(hSci, SCI_STYLESETITALIC, 1, TRUE)
            SendMessageA(hSci, SCI_STYLESETITALIC, 11, TRUE)
            SendMessageA(hSci, SCI_STYLESETFORE, 2, numCol)        ' NUMBER
            SendMessageA(hSci, SCI_STYLESETFORE, 3, strCol)        ' STRING
            SendMessageA(hSci, SCI_STYLESETFORE, 12, strCol)       ' CHARACTER
            SendMessageA(hSci, SCI_STYLESETFORE, 13, strCol)       ' STRINGEOL
            SendMessageA(hSci, SCI_STYLESETFORE, 4, opCol)         ' OPERATOR
            SendMessageA(hSci, SCI_STYLESETFORE, 5, fgCol)         ' IDENTIFIER
            SendMessageA(hSci, SCI_STYLESETFORE, 6, kwdCol)        ' CPUINSTRUCTION (set 0) -> GOLD
            SendMessageA(hSci, SCI_STYLESETBOLD, 6, TRUE)
            SendMessageA(hSci, SCI_STYLESETFORE, 7, kwdCol)        ' MATHINSTRUCTION (set 1)
            SendMessageA(hSci, SCI_STYLESETFORE, 14, kwdCol)       ' EXTINSTRUCTION (set 5)
            SendMessageA(hSci, SCI_STYLESETFORE, 8, kwd3Col)       ' REGISTER (set 2)
            SendMessageA(hSci, SCI_STYLESETFORE, 9, kwd2Col)       ' DIRECTIVE (set 3) -> CYAN
            SendMessageA(hSci, SCI_STYLESETBOLD, 9, TRUE)
            SendMessageA(hSci, SCI_STYLESETFORE, 10, kwd2Col)      ' DIRECTIVEOPERAND (set 4)

        ' ---- Python (SCE_P_*) --------------------------------------------
        CASE SCLEX_PYTHON
            SendMessageA(hSci, SCI_STYLESETFORE, 1, commentCol)    ' COMMENTLINE
            SendMessageA(hSci, SCI_STYLESETFORE, 12, commentCol)   ' COMMENTBLOCK
            SendMessageA(hSci, SCI_STYLESETITALIC, 1, TRUE)
            SendMessageA(hSci, SCI_STYLESETITALIC, 12, TRUE)
            SendMessageA(hSci, SCI_STYLESETFORE, 2, numCol)        ' NUMBER
            SendMessageA(hSci, SCI_STYLESETFORE, 3, strCol)        ' STRING
            SendMessageA(hSci, SCI_STYLESETFORE, 4, strCol)        ' CHARACTER
            SendMessageA(hSci, SCI_STYLESETFORE, 6, strCol)        ' TRIPLE
            SendMessageA(hSci, SCI_STYLESETFORE, 7, strCol)        ' TRIPLEDOUBLE
            SendMessageA(hSci, SCI_STYLESETFORE, 13, strCol)       ' STRINGEOL
            SendMessageA(hSci, SCI_STYLESETFORE, 5, kwdCol)        ' WORD (set 0) -> GOLD
            SendMessageA(hSci, SCI_STYLESETBOLD, 5, TRUE)
            SendMessageA(hSci, SCI_STYLESETFORE, 14, kwd2Col)      ' WORD2 (set 1: builtins) -> CYAN
            SendMessageA(hSci, SCI_STYLESETFORE, 8, kwd3Col)       ' CLASSNAME
            SendMessageA(hSci, SCI_STYLESETFORE, 9, kwd3Col)       ' DEFNAME
            SendMessageA(hSci, SCI_STYLESETFORE, 10, opCol)        ' OPERATOR
            SendMessageA(hSci, SCI_STYLESETFORE, 11, fgCol)        ' IDENTIFIER

        ' ---- Perl (SCE_PL_*) ---------------------------------------------
        CASE SCLEX_PERL
            SendMessageA(hSci, SCI_STYLESETFORE, 1, numCol)         ' ERROR
            SendMessageA(hSci, SCI_STYLESETFORE, 2, commentCol)     ' COMMENTLINE
            SendMessageA(hSci, SCI_STYLESETITALIC, 2, TRUE)
            SendMessageA(hSci, SCI_STYLESETFORE, 3, commentCol)     ' POD
            SendMessageA(hSci, SCI_STYLESETFORE, 31, commentCol)    ' POD_VERB
            SendMessageA(hSci, SCI_STYLESETFORE, 21, commentCol)    ' DATASECTION
            SendMessageA(hSci, SCI_STYLESETITALIC, 3, TRUE)
            SendMessageA(hSci, SCI_STYLESETITALIC, 31, TRUE)
            SendMessageA(hSci, SCI_STYLESETITALIC, 21, TRUE)
            SendMessageA(hSci, SCI_STYLESETFORE, 4, numCol)         ' NUMBER
            SendMessageA(hSci, SCI_STYLESETFORE, 5, kwdCol)         ' WORD -> GOLD
            SendMessageA(hSci, SCI_STYLESETBOLD, 5, TRUE)
            SendMessageA(hSci, SCI_STYLESETFORE, 6, strCol)         ' STRING
            SendMessageA(hSci, SCI_STYLESETFORE, 7, strCol)         ' CHARACTER
            SendMessageA(hSci, SCI_STYLESETFORE, 19, strCol)        ' LONGQUOTE
            SendMessageA(hSci, SCI_STYLESETFORE, 22, strCol)        ' HERE_DELIM
            SendMessageA(hSci, SCI_STYLESETFORE, 23, strCol)        ' HERE_Q
            SendMessageA(hSci, SCI_STYLESETFORE, 24, strCol)        ' HERE_QQ
            SendMessageA(hSci, SCI_STYLESETFORE, 26, strCol)        ' STRING_Q
            SendMessageA(hSci, SCI_STYLESETFORE, 27, strCol)        ' STRING_QQ
            SendMessageA(hSci, SCI_STYLESETFORE, 30, strCol)        ' STRING_QW
            SendMessageA(hSci, SCI_STYLESETFORE, 20, kwd2Col)       ' BACKTICKS
            SendMessageA(hSci, SCI_STYLESETFORE, 25, kwd2Col)       ' HERE_QX
            SendMessageA(hSci, SCI_STYLESETFORE, 28, kwd2Col)       ' STRING_QX
            SendMessageA(hSci, SCI_STYLESETFORE, 17, kwd4Col)       ' REGEX
            SendMessageA(hSci, SCI_STYLESETFORE, 18, kwd4Col)       ' REGSUBST
            SendMessageA(hSci, SCI_STYLESETFORE, 29, kwd4Col)       ' STRING_QR
            SendMessageA(hSci, SCI_STYLESETFORE, 12, kwd3Col)       ' SCALAR   $x
            SendMessageA(hSci, SCI_STYLESETFORE, 13, kwd3Col)       ' ARRAY    @x
            SendMessageA(hSci, SCI_STYLESETFORE, 14, kwd3Col)       ' HASH     %x
            SendMessageA(hSci, SCI_STYLESETFORE, 15, kwd3Col)       ' SYMBOLTABLE *x
            SendMessageA(hSci, SCI_STYLESETBOLD, 12, TRUE)
            SendMessageA(hSci, SCI_STYLESETBOLD, 13, TRUE)
            SendMessageA(hSci, SCI_STYLESETBOLD, 14, TRUE)
            SendMessageA(hSci, SCI_STYLESETBOLD, 15, TRUE)
            SendMessageA(hSci, SCI_STYLESETFORE, 9, kwd2Col)        ' PREPROCESSOR
            SendMessageA(hSci, SCI_STYLESETFORE, 40, kwd2Col)       ' SUB_PROTOTYPE (newer lexers only)
            SendMessageA(hSci, SCI_STYLESETFORE, 41, kwd2Col)       ' FORMAT_IDENT
            SendMessageA(hSci, SCI_STYLESETFORE, 42, strCol)        ' FORMAT
            SendMessageA(hSci, SCI_STYLESETFORE, 8, opCol)          ' PUNCTUATION
            SendMessageA(hSci, SCI_STYLESETFORE, 10, opCol)         ' OPERATOR
            SendMessageA(hSci, SCI_STYLESETFORE, 11, fgCol)         ' IDENTIFIER
            SendMessageA(hSci, SCI_STYLESETFORE, 16, fgCol)         ' VARIABLE_INDEXER

        ' ---- Makefile (SCE_MAKE_*) ---------------------------------------
        CASE SCLEX_MAKEFILE
            SendMessageA(hSci, SCI_STYLESETFORE, 1, commentCol)     ' COMMENT
            SendMessageA(hSci, SCI_STYLESETITALIC, 1, TRUE)
            SendMessageA(hSci, SCI_STYLESETFORE, 2, kwd2Col)        ' PREPROCESSOR (ifdef, include...)
            SendMessageA(hSci, SCI_STYLESETBOLD, 2, TRUE)
            SendMessageA(hSci, SCI_STYLESETFORE, 3, kwd3Col)        ' IDENTIFIER  $(VAR)
            SendMessageA(hSci, SCI_STYLESETFORE, 9, kwd3Col)        ' IDEOL
            SendMessageA(hSci, SCI_STYLESETBOLD, 3, TRUE)
            SendMessageA(hSci, SCI_STYLESETFORE, 4, opCol)          ' OPERATOR
            SendMessageA(hSci, SCI_STYLESETFORE, 5, kwdCol)         ' TARGET -> GOLD
            SendMessageA(hSci, SCI_STYLESETBOLD, 5, TRUE)

        ' ---- Batch (SCE_BAT_*) -------------------------------------------
        CASE SCLEX_BATCH
            SendMessageA(hSci, SCI_STYLESETFORE, 1, commentCol)     ' COMMENT
            SendMessageA(hSci, SCI_STYLESETITALIC, 1, TRUE)
            SendMessageA(hSci, SCI_STYLESETFORE, 2, kwdCol)         ' WORD (set 0) -> GOLD
            SendMessageA(hSci, SCI_STYLESETBOLD, 2, TRUE)
            SendMessageA(hSci, SCI_STYLESETFORE, 3, kwd4Col)        ' LABEL
            SendMessageA(hSci, SCI_STYLESETBOLD, 3, TRUE)
            SendMessageA(hSci, SCI_STYLESETFORE, 4, commentCol)     ' HIDE (@command)
            SendMessageA(hSci, SCI_STYLESETFORE, 5, kwd3Col)        ' COMMAND (external programs)
            SendMessageA(hSci, SCI_STYLESETBOLD, 5, TRUE)
            SendMessageA(hSci, SCI_STYLESETFORE, 6, kwd2Col)        ' IDENTIFIER  %VAR%
            SendMessageA(hSci, SCI_STYLESETBOLD, 6, TRUE)
            SendMessageA(hSci, SCI_STYLESETFORE, 7, opCol)          ' OPERATOR

        ' ---- Diff (SCE_DIFF_*) -------------------------------------------
        CASE SCLEX_DIFF
            SendMessageA(hSci, SCI_STYLESETFORE, 1, commentCol)     ' COMMENT
            SendMessageA(hSci, SCI_STYLESETITALIC, 1, TRUE)
            SendMessageA(hSci, SCI_STYLESETFORE, 2, kwdCol)         ' COMMAND  (diff ..., index ...)
            SendMessageA(hSci, SCI_STYLESETBOLD, 2, TRUE)
            SendMessageA(hSci, SCI_STYLESETFORE, 3, kwd2Col)        ' HEADER   (--- / +++)
            SendMessageA(hSci, SCI_STYLESETBACK, 3, MixCol(bgCol, kwd2Col, 18))
            SendMessageA(hSci, SCI_STYLESETEOLFILLED, 3, TRUE)
            SendMessageA(hSci, SCI_STYLESETBOLD, 3, TRUE)
            SendMessageA(hSci, SCI_STYLESETFORE, 4, kwd4Col)        ' POSITION (@@ ... @@)
            SendMessageA(hSci, SCI_STYLESETBOLD, 4, TRUE)
            SendMessageA(hSci, SCI_STYLESETFORE, 5, fgCol)          ' DELETED  (-)
            SendMessageA(hSci, SCI_STYLESETBACK, 5, MixCol(bgCol, numCol, 30))
            SendMessageA(hSci, SCI_STYLESETEOLFILLED, 5, TRUE)
            SendMessageA(hSci, SCI_STYLESETFORE, 6, fgCol)          ' ADDED    (+)
            SendMessageA(hSci, SCI_STYLESETBACK, 6, MixCol(bgCol, strCol, 30))
            SendMessageA(hSci, SCI_STYLESETEOLFILLED, 6, TRUE)
            SendMessageA(hSci, SCI_STYLESETFORE, 7, fgCol)          ' CHANGED  (!)
            SendMessageA(hSci, SCI_STYLESETBACK, 7, MixCol(bgCol, kwd3Col, 30))
            SendMessageA(hSci, SCI_STYLESETEOLFILLED, 7, TRUE)

        ' ---- Lua (SCE_LUA_*) ---------------------------------------------
        CASE SCLEX_LUA
            SendMessageA(hSci, SCI_STYLESETFORE, 1, commentCol)     ' COMMENT  --[[ ]]
            SendMessageA(hSci, SCI_STYLESETFORE, 2, commentCol)     ' COMMENTLINE
            SendMessageA(hSci, SCI_STYLESETFORE, 3, commentCol)     ' COMMENTDOC
            SendMessageA(hSci, SCI_STYLESETITALIC, 1, TRUE)
            SendMessageA(hSci, SCI_STYLESETITALIC, 2, TRUE)
            SendMessageA(hSci, SCI_STYLESETITALIC, 3, TRUE)
            SendMessageA(hSci, SCI_STYLESETFORE, 4, numCol)         ' NUMBER
            SendMessageA(hSci, SCI_STYLESETFORE, 5, kwdCol)         ' WORD (set 0) -> GOLD
            SendMessageA(hSci, SCI_STYLESETBOLD, 5, TRUE)
            SendMessageA(hSci, SCI_STYLESETFORE, 6, strCol)         ' STRING
            SendMessageA(hSci, SCI_STYLESETFORE, 7, strCol)         ' CHARACTER
            SendMessageA(hSci, SCI_STYLESETFORE, 8, strCol)         ' LITERALSTRING [[ ]]
            SendMessageA(hSci, SCI_STYLESETFORE, 12, strCol)        ' STRINGEOL
            SendMessageA(hSci, SCI_STYLESETFORE, 9, kwd2Col)        ' PREPROCESSOR
            SendMessageA(hSci, SCI_STYLESETFORE, 10, opCol)         ' OPERATOR
            SendMessageA(hSci, SCI_STYLESETFORE, 11, fgCol)         ' IDENTIFIER
            SendMessageA(hSci, SCI_STYLESETFORE, 13, kwd3Col)       ' WORD2 (set 1: base functions)
            SendMessageA(hSci, SCI_STYLESETFORE, 14, kwd3Col)       ' WORD3 (set 2: string/table/math)
            SendMessageA(hSci, SCI_STYLESETFORE, 15, kwd3Col)       ' WORD4 (set 3: coroutine/io/os)
            SendMessageA(hSci, SCI_STYLESETBOLD, 13, TRUE)
            SendMessageA(hSci, SCI_STYLESETBOLD, 14, TRUE)
            SendMessageA(hSci, SCI_STYLESETBOLD, 15, TRUE)
            SendMessageA(hSci, SCI_STYLESETFORE, 20, kwd4Col)       ' LABEL ::name::

    ENDSELECT

    ' Editor View Controls
    SendMessageA(hSci, SCI_SETCARETWIDTH, DpiPx(2), 0)
    SendMessageA(hSci, SCI_SETCARETSTYLE, CARETSTYLE_LINE, 0)
    ' SendMessageA(hSci, SCI_SETVIEWWS, SCWS_VISIBLEALWAYS, 0)
    SendMessageA(hSci, SCI_SETWHITESPACESIZE, 2, 0)
    SendMessageA(hSci, SCI_SETEDGEMODE, SC_EDGE_LINE, 0)
    SendMessageA(hSci, SCI_SETEDGECOLUMN, 80, 0)

    ApplyViewOptions()

    SendMessageA(hSci, SCI_COLOURISE, 0, -1)
    InvalidateRect(hSci, NULL, TRUE)
    SetFocusA(hSci)
ENDSUB

': ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
': Memory-Mapped File Loader with UTF-8 BOM Masking & 10MB Guard
': ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
SUB LoadMemoryMappedFile(STRING filePath$), INT
g_LoadError = 0
    IF LEN(filePath$) = 0 THEN RETURN FALSE

    HANDLE hFile = CreateFileA(filePath$, GENERIC_READ, 3, NULL, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, NULL)
    IF hFile = INVALID_HANDLE_VALUE THEN
        g_LoadError = GetLastError()
        Trace("LOAD failed: CreateFile error " + STR$(GetLastError()) + " path=" + filePath$)
        RETURN FALSE
    ENDIF

    DWORD fileSize = GetFileSize(hFile, NULL)
    IF fileSize > 10485760 THEN
        g_LoadError = -1
        Trace("LOAD failed: file too large, " + STR$(fileSize) + " bytes")
        CloseHandle(hFile)
        RETURN FALSE
    ENDIF

    IF fileSize = 0 THEN
        CloseHandle(hFile)
        SendMessageA(g_hSciCtrl, SCI_SETTEXT, 0, &"")
        IF g_ForceEnc >= 0 THEN
            g_App.encoding = g_ForceEnc
            g_App.codePage = g_ForceCP
        ELSE
            g_App.encoding = ENC_UTF8
            g_App.codePage = 0
        ENDIF
        SetEOLMode(0, FALSE)
        SyncEncodingMenuCheck(g_App.encoding)
        UpdateStatusBar()
        RETURN TRUE
    ENDIF

    HANDLE hMap = CreateFileMappingA(hFile, NULL, PAGE_READONLY, 0, 0, NULL)
    POINTER pMem = MapViewOfFile(hMap, FILE_MAP_READ, 0, 0, fileSize)

    ' --- signature bytes (masked to 0..255) ---
    INT b0 = #<BYTE>(pMem + 0) & 0xFF
    INT b1 = 0
    INT b2 = 0
    IF fileSize >= 2 THEN b1 = #<BYTE>(pMem + 1) & 0xFF
    IF fileSize >= 3 THEN b2 = #<BYTE>(pMem + 2) & 0xFF

    INT bomUtf8 = FALSE
    INT bomLE   = FALSE
    INT bomBE   = FALSE
    IF fileSize >= 3 THEN
        IF b0 = 0xEF AND b1 = 0xBB AND b2 = 0xBF THEN bomUtf8 = TRUE
    ENDIF
    IF fileSize >= 2 THEN
        IF b0 = 0xFF AND b1 = 0xFE THEN bomLE = TRUE
        IF b0 = 0xFE AND b1 = 0xFF THEN bomBE = TRUE
    ENDIF

    ' --- choose the encoding ---
    INT enc = ENC_ANSI : INT cp = 0
    INT skipBytes = 0

    IF g_ForceEnc >= 0 THEN
        enc = g_ForceEnc : cp = g_ForceCP
        IF (enc = ENC_UTF8 OR enc = ENC_UTF8BOM) AND bomUtf8 THEN skipBytes = 3
        IF (enc = ENC_U16LE_BOM OR enc = ENC_U16LE) AND bomLE THEN skipBytes = 2
        IF (enc = ENC_U16BE_BOM OR enc = ENC_U16BE) AND bomBE THEN skipBytes = 2
    ELSE
        IF bomUtf8 THEN
            enc = ENC_UTF8BOM
            skipBytes = 3
        ELSEIF bomLE THEN
            enc = ENC_U16LE_BOM
            skipBytes = 2
        ELSEIF bomBE THEN
            enc = ENC_U16BE_BOM
            skipBytes = 2
        ELSE
            INT hint    = DetectCodingHint(pMem, fileSize)
            INT isU8    = IsUTF8(pMem, fileSize)
            INT hasHigh = HasHighBytes(pMem, fileSize)

            IF isU8 AND hasHigh THEN
                enc = ENC_UTF8                      ' real multi-byte UTF-8 beats any header
            ELSEIF hint = 65001 THEN
                enc = ENC_UTF8
            ELSEIF hint > 0 THEN
                enc = ENC_ANSI : cp = hint          ' declared code page
            ELSEIF isU8 THEN
                enc = ENC_UTF8                      ' pure ASCII, nothing declared
            ELSE
                enc = ENC_ANSI
            ENDIF
        ENDIF
    ENDIF

    ' --- decode to a UTF-8 buffer (what Scintilla holds) ---
    POINTER pFinalBuf = NULL
    INT finalLen = 0
    INT payloadLen = fileSize - skipBytes
    INT wLen = 0
    POINTER pWide = NULL

    IF enc = ENC_UTF8 OR enc = ENC_UTF8BOM THEN
        pFinalBuf = SafeAllocHeap(payloadLen + 2)
        RtlMoveMemory(pFinalBuf, pMem + skipBytes, payloadLen)
        finalLen = payloadLen

    ELSEIF enc = ENC_ANSI THEN
        wLen = MultiByteToWideChar(cp, 0, pMem, payloadLen, NULL, 0)
        pWide = SafeAllocHeap((wLen + 1) * 2)
        MultiByteToWideChar(cp, 0, pMem, payloadLen, pWide, wLen)
        finalLen = WideCharToMultiByte(65001, 0, pWide, wLen, NULL, 0, NULL, NULL)
        pFinalBuf = SafeAllocHeap(finalLen + 2)
        WideCharToMultiByte(65001, 0, pWide, wLen, pFinalBuf, finalLen, NULL, NULL)
        SafeFreeHeap(pWide)

    ELSE
        ' UTF-16: an odd trailing byte is dropped
        wLen = payloadLen / 2
        pWide = SafeAllocHeap(payloadLen + 4)
        RtlMoveMemory(pWide, pMem + skipBytes, wLen * 2)
        IF enc = ENC_U16BE_BOM OR enc = ENC_U16BE THEN SwapBytes16(pWide, wLen * 2)
        finalLen = WideCharToMultiByte(65001, 0, pWide, wLen, NULL, 0, NULL, NULL)
        pFinalBuf = SafeAllocHeap(finalLen + 2)
        IF finalLen > 0 THEN WideCharToMultiByte(65001, 0, pWide, wLen, pFinalBuf, finalLen, NULL, NULL)
        SafeFreeHeap(pWide)
    ENDIF

    IF pFinalBuf <> NULL THEN
        #<BYTE>(pFinalBuf + finalLen) = 0
        INT detEol = DetectEOL(pFinalBuf, finalLen)
        SendMessageA(g_hSciCtrl, SCI_SETTEXT, 0, pFinalBuf)
        SafeFreeHeap(pFinalBuf)
        SetEOLMode(detEol, FALSE)
    ENDIF

    UnmapViewOfFile(pMem)
    CloseHandle(hMap)
    CloseHandle(hFile)

    g_App.encoding = enc : g_App.codePage = cp
    SyncEncodingMenuCheck(enc)
    UpdateStatusBar()
    RETURN TRUE
ENDSUB

': ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
': IsUTF8 - Strict Scanner
': ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
SUB IsUTF8(POINTER pMem, DWORD fileSize), INT
    IF pMem = NULL OR fileSize = 0 THEN RETURN FALSE

    DWORD i = 0
    INT b = 0
    INT need = 0          ' continuation bytes still expected
    INT lo = 0x80         ' allowed range of the NEXT continuation byte
    INT hi = 0xBF

    WHILE i < fileSize
        b = #<BYTE>(pMem + i) & 0xFF

        IF need = 0 THEN
            IF b >= 0x80 THEN
                lo = 0x80
                hi = 0xBF
                IF b >= 0xC2 AND b <= 0xDF THEN
                    need = 1
                ELSEIF b >= 0xE0 AND b <= 0xEF THEN
                    need = 2
                    IF b = 0xE0 THEN lo = 0xA0       ' no overlong 3-byte forms
                    IF b = 0xED THEN hi = 0x9F       ' no surrogates
                ELSEIF b >= 0xF0 AND b <= 0xF4 THEN
                    need = 3
                    IF b = 0xF0 THEN lo = 0x90       ' no overlong 4-byte forms
                    IF b = 0xF4 THEN hi = 0x8F       ' nothing above U+10FFFF
                ELSE
                    RETURN FALSE                     ' 80-C1, F5-FF
                ENDIF
            ENDIF
        ELSE
            IF b < lo OR b > hi THEN RETURN FALSE
            lo = 0x80
            hi = 0xBF
            need--
        ENDIF
        i++
    WEND

    RETURN (need = 0)
ENDSUB

SUB EncodingName(INT enc), STRING
    SELECT enc
        CASE ENC_ANSI
            IF g_App.codePage <> 0 THEN RETURN CPNameOf(g_App.codePage)
            RETURN "ANSI"
        CASE ENC_UTF8BOM
            RETURN "UTF-8 BOM"
        CASE ENC_U16LE_BOM
            RETURN "UTF-16 LE BOM"
        CASE ENC_U16BE_BOM
            RETURN "UTF-16 BE BOM"
        CASE ENC_U16LE
            RETURN "UTF-16 LE"
        CASE ENC_U16BE
            RETURN "UTF-16 BE"
    ENDSELECT
    RETURN "UTF-8"
ENDSUB

SUB SyncEncodingMenuCheck(INT enc)
    INT i = 0
    INT want = 0

    FOR i = 0 TO 6
        want = 0
        IF i = enc AND (enc <> ENC_ANSI OR g_App.codePage = 0) THEN want = 1
        CHECKMENUITEM WIN, CMD_ENC_BASE + i, want
    NEXT i

    FOR i = 0 TO CP_COUNT - 1
        want = 0
        IF enc = ENC_ANSI AND g_App.codePage = g_CPNum[i] THEN want = 1
        CHECKMENUITEM WIN, CMD_CP_REL + i, want
    NEXT i

    DrawMenuBar(WIN.hwnd)
ENDSUB

' Convert: the next save writes this encoding. The editor text is unchanged.
SUB SetEncoding(INT enc)
    IF enc < 0 OR enc > 6 THEN RETURN
    g_App.encoding = enc
    IF g_IsDirty = FALSE THEN
        g_IsDirty = TRUE
        UpdateTitleBar()
    ENDIF
    g_App.codePage = 0
    SyncEncodingMenuCheck(enc)
    UpdateStatusBar()
ENDSUB

' Reinterpret: read the file again from disk using this encoding.
SUB ReloadAs(INT enc)
    IF enc < 0 OR enc > 6 THEN RETURN
    IF g_CurrentLoadedPath = "" THEN
        ShowBalloonToast("Reload As", "This document has not been saved to disk yet.")
        RETURN
    ENDIF

    CancelAction = FALSE
    IsFileChanged()                        ' same unsaved-changes prompt as New and Open
    IF CancelAction = TRUE THEN RETURN

    g_ForceEnc = enc : g_ForceCP = 0
    fName = g_CurrentLoadedPath
    DoOpen()
    g_ForceEnc = -1
    SyncEncodingMenuCheck(g_App.encoding)
ENDSUB

SUB InitCodePages()
    g_CPNum = 1252, 28591, 28605, 850, 437, 1250, 28592, 852, 1257, 1258, 1251, 20866, 21866, 28595, 866, 1253, 28597, 1254, 28599, 1255, 1256, 874, 932, 936, 949, 950
    g_CPName = "Windows-1252", "ISO-8859-1", "ISO-8859-15", "CP850", "CP437", "Windows-1250", "ISO-8859-2", "CP852", "Windows-1257", "Windows-1258", "Windows-1251", "KOI8-R", "KOI8-U", "ISO-8859-5", "CP866", "Windows-1253", "ISO-8859-7", "Windows-1254", "ISO-8859-9", "Windows-1255", "Windows-1256", "Windows-874", "Shift-JIS", "GBK", "CP949", "Big5"
ENDSUB

SUB CPNameOf(INT cp), STRING
    INT i = 0
    FOR i = 0 TO CP_COUNT - 1
        IF g_CPNum[i] = cp THEN RETURN g_CPName[i]
    NEXT i
    RETURN "CP" + STR$(cp)
ENDSUB

' Reinterpret: read the file again from disk using this code page.
SUB ReloadAsCP(INT idx)
    IF idx < 0 OR idx >= CP_COUNT THEN RETURN
    IF g_CurrentLoadedPath = "" THEN
        ShowBalloonToast("Reload As", "This document has not been saved to disk yet.")
        RETURN
    ENDIF

    CancelAction = FALSE
    IsFileChanged()
    IF CancelAction = TRUE THEN RETURN

    g_ForceEnc = ENC_ANSI
    g_ForceCP  = g_CPNum[idx]
    fName = g_CurrentLoadedPath
    DoOpen()
    g_ForceEnc = -1
    g_ForceCP  = 0
    SyncEncodingMenuCheck(g_App.encoding)
ENDSUB

SUB SwapBytes16(POINTER p, INT nBytes)
    INT i = 0
    INT t = 0
    WHILE (i + 1) < nBytes
        t = #<BYTE>(p + i) & 0xFF
        #<BYTE>(p + i) = #<BYTE>(p + i + 1) & 0xFF
        #<BYTE>(p + i + 1) = t
        i += 2
    WEND
ENDSUB

SUB GetReadableFileSize(DWORD fileSize, POINTER pOutBuf)
    IF pOutBuf = NULL THEN RETURN

    DWORD whole = 0
    DWORD frac = 0

    IF fileSize < 1024 THEN
        wsprintfA(pOutBuf, "%u B", fileSize)
        RETURN
    ENDIF

    IF fileSize < 1048576 THEN
        whole = fileSize / 1024
        frac  = ((fileSize % 1024) * 10) / 1024
        wsprintfA(pOutBuf, "%u.%u KB", whole, frac)
        RETURN
    ENDIF

    whole = fileSize / 1048576

    DOUBLE tempFrac = (DOUBLE(fileSize % 1048576) * 100.0) / 1048576.0
    frac = INT(tempFrac)

    IF frac < 10 THEN
        wsprintfA(pOutBuf, "%u.0%u MB", whole, frac)
    ELSE
        wsprintfA(pOutBuf, "%u.%u MB", whole, frac)
    ENDIF
ENDSUB

': ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
': Native Custom Find & Replace Subroutines
': ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
' Fill the combo list from g_hist[base .. base+4] and hook the Enter key of its edit part.
SUB HistLoad(INT hCb, INT base)
    ISTRING it[300]
    INT i
    SendMessageA(hCb, 0x14B, 0, 0)                         ' CB_RESETCONTENT
    SendMessageA(hCb, 0x141, 256, 0)                       ' CB_LIMITTEXT
    ' SendMessageA(hCb, 0x160, DpiPx(320), 0)                ' CB_SETDROPPEDWIDTH: list wider than the box
    FOR i = 0 TO 4
        IF g_hist[base + i] <> "" THEN
            it = g_hist[base + i]
            SendMessageA(hCb, 0x143, 0, &it)               ' CB_ADDSTRING
        ENDIF
    NEXT i

    INT hEd = GetWindow(hCb, 5)                            ' GW_CHILD: the edit inside the combo
    IF hEd <> 0 THEN
        IF GetPropA(hEd, "Tpad_OrigProc") = 0 THEN
            SetPropA(hEd, "Tpad_OrigProc", SetWindowLongA(hEd, GWL_WNDPROC, &FindEditProc))
        ENDIF
    ENDIF
    ' Add a tooltip
    HistTipHook(hCb)
ENDSUB

' Put txt$ on top of its list (no duplicates, max 5) and refresh the combo.
SUB HistPush(INT hCb, INT base, STRING txt$)
    IF txt$ = "" THEN RETURN
    ISTRING it[300]
    INT i, j = 4
    FOR i = 0 TO 4                                         ' already there? then it simply moves up
        IF LCASE$(g_hist[base + i]) = LCASE$(txt$) THEN
            j = i
            i = 4
        ENDIF
    NEXT i
    FOR i = j TO 1 STEP -1
        g_hist[base + i] = g_hist[base + i - 1]
    NEXT i
    g_hist[base] = txt$

    g_HistBusy = 1                                         ' keep the EDITCHANGE handler quiet
    HistLoad(hCb, base)
    it = txt$
    SetWindowTextA(hCb, &it)                               ' the reset blanks the edit part
    i = LEN(txt$)
    SendMessageA(hCb, 0x142, 0, i | (i << 16))             ' CB_SETEDITSEL: caret at the end
    g_HistBusy = 0
ENDSUB

' Text of the currently highlighted list entry (the edit part is not updated yet at CBN_SELCHANGE).
SUB HistSelText(INT hCb), STRING
    ISTRING b[300]
    STRING r$ = ""
    INT ix = SendMessageA(hCb, 0x147, 0, 0)                ' CB_GETCURSEL
    IF ix >= 0 THEN
        SendMessageA(hCb, 0x148, ix, &b)
        r$ = b
    ENDIF
    RETURN r$
ENDSUB

' Give the combo's drop-down list a tooltip that shows the hovered entry in full.
SUB HistTipHook(INT hCb)
    ISTRING cbi[64]
    ISTRING ti[48]
    POINTER pc = &cbi
    POINTER pt = &ti
    INT k
    FOR k = 0 TO 15 : #<INT>(pc + k * 4) = 0 : NEXT k
    #<INT>(pc) = 52                                       ' COMBOBOXINFO.cbSize
    SendMessageA(hCb, 0x164, 0, &cbi)                     ' CB_GETCOMBOBOXINFO
    INT hList = #<INT>(pc + 48)                           ' hwndList
    IF hList = 0 THEN RETURN
    IF GetPropA(hList, "Tpad_Tip") <> 0 THEN RETURN       ' already hooked

    INT hTip = CreateWindowExA(8, "tooltips_class32", "", 0x80000003, 0, 0, 0, 0, search_dlg.hwnd, 0, GetModuleHandleA(NULL), 0)
    IF hTip = 0 THEN RETURN
    SendMessageA(hTip, 0x418, 0, DpiPx(400))              ' TTM_SETMAXTIPWIDTH: wrap long strings

    FOR k = 0 TO 11 : #<INT>(pt + k * 4) = 0 : NEXT k
    #<INT>(pt)      = 44                                  ' TOOLINFO.cbSize
    #<INT>(pt + 4)  = 0xA0                                ' TTF_TRACK | TTF_ABSOLUTE
    #<INT>(pt + 8)  = hList
    #<INT>(pt + 12) = 1
    #<INT>(pt + 36) = &g_tipTxt
    SendMessageA(hTip, 0x404, 0, &ti)                     ' TTM_ADDTOOLA

    SetPropA(hList, "Tpad_Tip", hTip)
    SetPropA(hList, "Tpad_Last", 0)                       ' last shown item + 1
    SetPropA(hList, "Tpad_OrigProc", SetWindowLongA(hList, GWL_WNDPROC, &HistListProc))
ENDSUB

SUB HistListProc(INT hwnd, INT uMsg, INT wParam, POINTER lParam), INT
    INT orig = GetPropA(hwnd, "Tpad_OrigProc")
    INT hTip = GetPropA(hwnd, "Tpad_Tip")
    ISTRING ti[48]
    ISTRING cp[8]
    POINTER pt = &ti
    POINTER pp = &cp
    INT k, r, idx, outside, n

    Select uMsg
        Case 0x0200                                       ' WM_MOUSEMOVE
            r = SendMessageA(hwnd, 0x1A9, 0, lParam)      ' LB_ITEMFROMPOINT
            idx = r & 0xFFFF
            outside = (r >> 16) & 1
            n = 0
            IF outside = 0 THEN n = SendMessageA(hwnd, 0x18A, idx, 0)   ' LB_GETTEXTLEN

            FOR k = 0 TO 11 : #<INT>(pt + k * 4) = 0 : NEXT k
            #<INT>(pt)      = 44
            #<INT>(pt + 4)  = 0xA0
            #<INT>(pt + 8)  = hwnd
            #<INT>(pt + 12) = 1
            #<INT>(pt + 36) = &g_tipTxt

            IF n > 20 THEN                                ' only long entries get a tip
                IF GetPropA(hwnd, "Tpad_Last") <> idx + 1 THEN
                    SetPropA(hwnd, "Tpad_Last", idx + 1)
                    SendMessageA(hwnd, 0x189, idx, &g_tipTxt)             ' LB_GETTEXT
                    SendMessageA(hTip, 0x40C, 0, &ti)                     ' TTM_UPDATETIPTEXTA
                ENDIF
                GetCursorPos(&cp)
                SendMessageA(hTip, 0x412, 0, ((#<INT>(pp + 4) + 20) << 16) | ((#<INT>(pp) + 12) & 0xFFFF))  ' TTM_TRACKPOSITION
                SendMessageA(hTip, 0x411, 1, &ti)                         ' TTM_TRACKACTIVATE on
                SetWindowPos(hTip, -1, 0, 0, 0, 0, 0x13)                  ' HWND_TOPMOST, NOMOVE|NOSIZE|NOACTIVATE
            ELSE
                SetPropA(hwnd, "Tpad_Last", 0)
                SendMessageA(hTip, 0x411, 0, &ti)                         ' off
            ENDIF

        Case 0x0018                                       ' WM_SHOWWINDOW: list closing hides the tip
            IF wParam = 0 THEN
                FOR k = 0 TO 11 : #<INT>(pt + k * 4) = 0 : NEXT k
                #<INT>(pt)     = 44
                #<INT>(pt + 4) = 0xA0
                #<INT>(pt + 8) = hwnd
                #<INT>(pt + 12) = 1
                SendMessageA(hTip, 0x411, 0, &ti)
                SetPropA(hwnd, "Tpad_Last", 0)
            ENDIF
    EndSelect
    RETURN CallWindowProcA(orig, hwnd, uMsg, wParam, lParam)
ENDSUB

SUB Show_Find(WINDOW win, INT ctrlID, INT findreplace)
    INT gotSel = GrabSelectionForFind()

    IF search_dlg.hwnd <> 0
        IF IsWindow(search_dlg.hwnd) THEN
            IF gotSel THEN SETCONTROLTEXT search_dlg, ctlSearchtext, Searchtext
            SETFOCUS search_dlg, ctlSearchtext
            SendMessageA(GetDlgItem(search_dlg.hwnd, ctlSearchtext), 0x142, 0, -65536)   ' CB_SETEDITSEL: select all: select all
            RETURN
        ENDIF
    ENDIF
    search_win = win
    search_ctl = ctrlID
    g_IsReplaceDialog = findreplace

    SendMessage(hToolBar, TB_ENABLEBUTTON, CMD_FIND, 0)
    SendMessage(hToolBar, TB_ENABLEBUTTON, CMD_REPLACE, 0)

    ENABLEMENUITEM WIN, CMD_FIND, 0
    ENABLEMENUITEM WIN, CMD_REPLACE, 0

    If findreplace = 0 Then
        search_dlg = dlg_find
    Else
        search_dlg = dlg_findreplace
    EndIf

    SHOWDIALOG search_dlg, search_win
    RETURN
EndSub

' Enter inside the combo's edit = Find (Shift+Enter = backwards, read by the ctlFind handler).
SUB FindEditProc(INT hwnd, INT uMsg, INT wParam, POINTER lParam), INT
    INT orig = GetPropA(hwnd, "Tpad_OrigProc")
    Select uMsg
        Case 0x0087                                        ' WM_GETDLGCODE: lParam = MSG*, its wParam is at +8
            IF lParam <> 0 THEN
                IF #<INT>(lParam + 8) = 13 THEN RETURN 12  ' DLGC_WANTMESSAGE | DLGC_HASSETSEL
            ENDIF
        Case 0x0100                                        ' WM_KEYDOWN
            IF wParam = 13 THEN
                SendMessageA(search_dlg.hwnd, 0x111, ctlFind, GetDlgItem(search_dlg.hwnd, ctlFind))
                RETURN 0
            ENDIF
            IF wParam = 65 THEN                            ' 'A'
                IF GetKeyState(0x11) & 0x8000 THEN         ' with Ctrl held
                    SendMessageA(hwnd, 177, 0, -1)         ' EM_SETSEL: select everything in this box
                    RETURN 0
                ENDIF
            ENDIF
        Case 0x0102                                        ' WM_CHAR
            IF wParam = 13 OR wParam = 1 THEN RETURN 0     ' Enter, Ctrl+A: swallow (no beep)
    EndSelect
    RETURN CallWindowProcA(orig, hwnd, uMsg, wParam, lParam)
ENDSUB

SUB Load_FindReplace()
    INT o = DpiPx(CAP_H) - DpiPx(4)                          ' 18 px at 96 DPI: room for the caption bar

    CREATEDIALOG dlg_find, 100, 100, DpiPx(350), DpiPx(90) + o, @NOCAPTION, WIN, "Find", &routineFindReplace
    CONTROL dlg_find, @STATIC, "Search for", DpiPx(10), DpiPx(18) + o, DpiPx(80), DpiPx(20), 0, lblSearch
    CONTROL dlg_find, @COMBOBOX, "", DpiPx(90), DpiPx(15) + o, DpiPx(150), DpiPx(110), 0x50210042, ctlSearchtext
    CONTROL dlg_find, @CHECKBOX, "&Match Case", DpiPx(90), DpiPx(40) + o, DpiPx(100), DpiPx(20), 0x5001000B, ctlMatchCase
    CONTROL dlg_find, @CHECKBOX, "&Match Whole Word", DpiPx(90), DpiPx(62) + o, DpiPx(150), DpiPx(20), 0x5001000B, ctlMatchWholeWord
    CONTROL dlg_find, @BUTTON, "&Find", DpiPx(250), DpiPx(15) + o, DpiPx(90), DpiPx(24), 0x5001000B, ctlFind
    CONTROL dlg_find, @BUTTON, "&Close", DpiPx(250), DpiPx(48) + o, DpiPx(90), DpiPx(24), 0x5001000B, ctlClose

    CREATEDIALOG dlg_findreplace, 100, 100, DpiPx(350), DpiPx(130) + o, @NOCAPTION, WIN, "Find/Replace", &routineFindReplace
    CONTROL dlg_findreplace, @STATIC, "Search for", DpiPx(10), DpiPx(18) + o, DpiPx(80), DpiPx(20), 0, lblSearch
    CONTROL dlg_findreplace, @COMBOBOX, "", DpiPx(100), DpiPx(15) + o, DpiPx(150), DpiPx(110), 0x50210042, ctlSearchtext
    CONTROL dlg_findreplace, @STATIC, "Replace with", DpiPx(10), DpiPx(43) + o, DpiPx(85), DpiPx(20), 0, lblReplace
    CONTROL dlg_findreplace, @COMBOBOX, "", DpiPx(100), DpiPx(40) + o, DpiPx(150), DpiPx(110), 0x50210042, ctlReplacetext
    CONTROL dlg_findreplace, @CHECKBOX, "&Match Case", DpiPx(100), DpiPx(65) + o, DpiPx(100), DpiPx(20), 0x5001000B, ctlMatchCase
    CONTROL dlg_findreplace, @CHECKBOX, "&Match Whole Word", DpiPx(100), DpiPx(87) + o, DpiPx(150), DpiPx(20), 0x5001000B, ctlMatchWholeWord
    CONTROL dlg_findreplace, @BUTTON, "&Find Next", DpiPx(255), DpiPx(10) + o, DpiPx(90), DpiPx(24), 0x5001000B, ctlFind
    CONTROL dlg_findreplace, @BUTTON, "&Replace", DpiPx(255), DpiPx(40) + o, DpiPx(90), DpiPx(24), 0x5001000B, ctlReplaceBtn
    CONTROL dlg_findreplace, @BUTTON, "Repl. &All", DpiPx(255), DpiPx(70) + o, DpiPx(90), DpiPx(24), 0x5001000B, ctlReplaceAll
    CONTROL dlg_findreplace, @BUTTON, "&Close", DpiPx(255), DpiPx(100) + o, DpiPx(90), DpiPx(24), 0x5001000B, ctlClose
    RETURN
EndSub

SUB routineFindReplace(), INT
    Select @MESSAGE
        Case @IDINITDIALOG
            g_FindOrig = GetWindowLongA(search_dlg.hwnd, GWL_WNDPROC)
            SetWindowLongA(search_dlg.hwnd, GWL_WNDPROC, &ColorFindSubClass)

            HistLoad(GetDlgItem(search_dlg.hwnd, ctlSearchtext), 0)
            IF g_IsReplaceDialog = 1 THEN HistLoad(GetDlgItem(search_dlg.hwnd, ctlReplacetext), 5)

            InjectUIFont(search_dlg.hwnd)
            CENTERWINDOW search_dlg
            setfirststart(search_win, g_hSciCtrl)

            SETCONTROLTEXT search_dlg, ctlSearchtext, Searchtext
            If g_IsReplaceDialog = 1 THEN SETCONTROLTEXT search_dlg, ctlReplacetext, gReplaceText

            SETFOCUS search_dlg, ctlSearchtext
            SendMessageA(GetDlgItem(search_dlg.hwnd, ctlSearchtext), 0x142, 0, -65536)

        Case @IDERASEBACKGROUND
            RETURN 0

        Case @IDLBUTTONDN
            DragWindow(search_dlg)

        CASE @IDCLOSEWINDOW
            ' Safely clean up this dialog's unique font
            UINT hFnt = GetPropA(search_dlg.hwnd, "Tpad_UIFont")
            IF hFnt <> 0 THEN
                RemovePropA(search_dlg.hwnd, "Tpad_UIFont")
                DeleteObject(hFnt)
            ENDIF

            SendMessage(hToolBar, TB_ENABLEBUTTON, CMD_FIND, 1)
            SendMessage(hToolBar, TB_ENABLEBUTTON, CMD_REPLACE, 1)

            ENABLEMENUITEM WIN, CMD_FIND, 1
            ENABLEMENUITEM WIN, CMD_REPLACE, 1

            CLOSEDIALOG search_dlg
            SETFOCUS search_win, g_hSciCtrl

        Case @IDCONTROL
            Select @CONTROLID
                Case ctlClose
                    SendMessage(hToolBar, TB_ENABLEBUTTON, CMD_FIND, 1)
                    SendMessage(hToolBar, TB_ENABLEBUTTON, CMD_REPLACE, 1)

                    ENABLEMENUITEM WIN, CMD_FIND, 1
                    ENABLEMENUITEM WIN, CMD_REPLACE, 1

                    CLOSEDIALOG search_dlg
                    SETFOCUS search_win, g_hSciCtrl

                Case ctlSearchtext
                    IF g_HistBusy = 0 THEN
                        IF @NOTIFYCODE = 1 THEN                    ' CBN_SELCHANGE: picked from the list
                            Searchtext = HistSelText(GetDlgItem(search_dlg.hwnd, ctlSearchtext))
                            setfirststart(search_win, g_hSciCtrl)
                        ELSEIF @NOTIFYCODE = 5 THEN                ' CBN_EDITCHANGE: typing
                            setfirststart(search_win, g_hSciCtrl)
                            Searchtext = GETCONTROLTEXT(search_dlg, ctlSearchtext)
                        ENDIF
                    ENDIF

                Case ctlReplacetext
                    IF g_HistBusy = 0 THEN
                        IF @NOTIFYCODE = 1 THEN
                            gReplaceText = HistSelText(GetDlgItem(search_dlg.hwnd, ctlReplacetext))
                        ELSEIF @NOTIFYCODE = 5 THEN
                            gReplaceText = GETCONTROLTEXT(search_dlg, ctlReplacetext)
                        ENDIF
                    ENDIF

                Case ctlFind
                    HistPush(GetDlgItem(search_dlg.hwnd, ctlSearchtext), 0, Searchtext)
                    IF GetKeyState(VK_SHIFT) & 0x8000 THEN
                        doFindDir(Searchtext, 1 - match_case, TRUE)
                    ELSE
                        doFindDir(Searchtext, 1 - match_case, FALSE)
                    ENDIF

                Case ctlReplaceBtn
                    HistPush(GetDlgItem(search_dlg.hwnd, ctlSearchtext), 0, Searchtext)
                    HistPush(GetDlgItem(search_dlg.hwnd, ctlReplacetext), 5, gReplaceText)
                    doReplace(search_win, g_hSciCtrl, Searchtext, gReplaceText, 1 - match_case)

                Case ctlReplaceAll
                    HistPush(GetDlgItem(search_dlg.hwnd, ctlSearchtext), 0, Searchtext)
                    HistPush(GetDlgItem(search_dlg.hwnd, ctlReplacetext), 5, gReplaceText)
                    doReplaceAll(search_win, g_hSciCtrl, Searchtext, gReplaceText, 1 - match_case)

                Case ctlMatchCase
                    match_case = FlipBool(match_case)
                    InvalidateRect(GetDlgItem(search_dlg.hwnd, ctlMatchCase), NULL, TRUE)
                    setfirststart(search_win, g_hSciCtrl)

                Case ctlMatchWholeWord
                    match_word = FlipBool(match_word)
                    InvalidateRect(GetDlgItem(search_dlg.hwnd, ctlMatchWholeWord), NULL, TRUE)
                    setfirststart(search_win, g_hSciCtrl)
            EndSelect

    EndSelect
    Return 0
EndSub

' Count the three styles and return the majority. CRLF wins ties and empty files.
SUB DetectEOL(POINTER p, INT n), INT
    INT i = 0
    INT b = 0
    INT nCRLF = 0
    INT nLF = 0
    INT nCR = 0

    IF p = NULL THEN RETURN 0

    WHILE i < n
        b = #<BYTE>(p + i) & 0xFF
        IF b = 13 THEN
            IF (i + 1) < n THEN
                IF (#<BYTE>(p + i + 1) & 0xFF) = 10 THEN
                    nCRLF++
                    i++
                ELSE
                    nCR++
                ENDIF
            ELSE
                nCR++
            ENDIF
        ELSEIF b = 10 THEN
            nLF++
        ENDIF
        i++
    WEND

    IF nCRLF >= nLF AND nCRLF >= nCR THEN RETURN 0     ' SC_EOL_CRLF
    IF nLF >= nCR THEN RETURN 2                        ' SC_EOL_LF
    RETURN 1                                           ' SC_EOL_CR
ENDSUB

' userPick = TRUE: the user chose it from the menu, so convert on the next save.
' userPick = FALSE: just adopt the mode (file load, New file, startup).
SUB SetEOLMode(INT mode, INT userPick)
    IF g_hSciCtrl = 0 THEN RETURN

    SendMessageA(g_hSciCtrl, 2031, mode, 0)            ' SCI_SETEOLMODE: affects new lines and pastes
    g_EolTarget = mode

    IF userPick THEN
        g_EolPending = TRUE
        IF g_IsDirty = FALSE THEN
            g_IsDirty = TRUE
            UpdateTitleBar()
        ENDIF
    ELSE
        g_EolPending = FALSE
    ENDIF

    INT checkID = CMD_EOL_CRLF
    SELECT mode
        CASE 1
            g_App.eolMode = "CR"
            checkID = CMD_EOL_CR
        CASE 2
            g_App.eolMode = "LF"
            checkID = CMD_EOL_LF
        DEFAULT
            g_App.eolMode = "CRLF"
            checkID = CMD_EOL_CRLF
    ENDSELECT

    UINT hMenu = GetMenu(WIN.hwnd)
    IF hMenu <> 0 THEN
        CheckMenuRadioItem(hMenu, CMD_EOL_CRLF, CMD_EOL_CR, checkID, MF_BYCOMMAND)
        DrawMenuBar(WIN.hwnd)
    ENDIF

    UpdateStatusBar()
ENDSUB

SUB ConvertEOLs(POINTER pIn, INT n, INT mode), POINTER
    g_ConvLen = 0
    IF pIn = NULL THEN RETURN NULL

    ' Worst case is CR -> CRLF, which doubles the size
    POINTER pOut = SafeAllocHeap((n * 2) + 2)
    IF pOut = NULL THEN RETURN NULL

    INT i = 0
    INT o = 0
    INT b = 0

    WHILE i < n
        b = #<BYTE>(pIn + i) & 0xFF

        IF b = 13 OR b = 10 THEN
            ' CRLF counts as one break
            IF b = 13 AND (i + 1) < n THEN
                IF (#<BYTE>(pIn + i + 1) & 0xFF) = 10 THEN i++
            ENDIF

            IF mode = 0 THEN
                #<BYTE>(pOut + o) = 13 : o++
                #<BYTE>(pOut + o) = 10 : o++
            ELSEIF mode = 1 THEN
                #<BYTE>(pOut + o) = 13 : o++
            ELSE
                #<BYTE>(pOut + o) = 10 : o++
            ENDIF
        ELSE
            #<BYTE>(pOut + o) = b : o++
        ENDIF
        i++
    WEND

    #<BYTE>(pOut + o) = 0
    g_ConvLen = o
    RETURN pOut
ENDSUB

SUB setfirststart(WINDOW w, INT ctrlID)
    IF g_hSciCtrl = 0 THEN RETURN
    startattop = FALSE
    found = FALSE
    RETURN
ENDSUB

': ANSI string (dialog edit text) -> NUL-terminated UTF-8 (what Scintilla holds). Returns byte count.
SUB AcpToUtf8(STRING s$, POINTER pOut, INT cap), INT
    #<BYTE>pOut = 0
    IF s$ = "" THEN RETURN 0
    INT wLen = MultiByteToWideChar(CP_ACP, 0, s$, -1, NULL, 0)
    IF wLen <= 1 THEN RETURN 0
    POINTER pWide = SafeAllocHeap(wLen * 2)
    IF pWide = NULL THEN RETURN 0
    MultiByteToWideChar(CP_ACP, 0, s$, -1, pWide, wLen)
    INT n = WideCharToMultiByte(CP_UTF8, 0, pWide, wLen - 1, pOut, cap - 1, NULL, NULL)
    SafeFreeHeap(pWide)
    IF n < 0 THEN n = 0
    #<BYTE>(pOut + n) = 0
    RETURN n
ENDSUB

': UTF-8 bytes -> NUL-terminated ANSI. Returns byte count, or -1 if a character cannot be represented.
SUB Utf8ToAcp(POINTER pUtf8, INT n, POINTER pOut, INT cap), INT
    INT wLen = MultiByteToWideChar(65001, 0, pUtf8, n, NULL, 0)
    IF wLen <= 0 THEN RETURN -1
    POINTER pWide = SafeAllocHeap((wLen + 1) * 2)
    IF pWide = NULL THEN RETURN -1
    MultiByteToWideChar(65001, 0, pUtf8, n, pWide, wLen)
    INT usedDef = 0
    INT outLen = WideCharToMultiByte(CP_ACP, 0x400, pWide, wLen, pOut, cap - 1, NULL, &usedDef)
    SafeFreeHeap(pWide)
    IF outLen <= 0 OR usedDef <> 0 THEN RETURN -1
    #<BYTE>(pOut + outLen) = 0
    RETURN outLen
ENDSUB

': If the editor has a single-line selection that fits the search box, it becomes the search text.
SUB GrabSelectionForFind(), INT
    IF g_hSciCtrl = 0 THEN RETURN FALSE

    INT sStart = SendMessageA(g_hSciCtrl, SCI_GETSELECTIONSTART, 0, 0)
    INT sEnd   = SendMessageA(g_hSciCtrl, SCI_GETSELECTIONEND, 0, 0)
    INT n = sEnd - sStart
    IF n <= 0 OR n > 256 THEN RETURN FALSE              ' the search box holds 256 characters

    ISTRING selBuf[300]
    ISTRING acpBuf[300]
    SendMessageA(g_hSciCtrl, 2161, 0, &selBuf)          ' SCI_GETSELTEXT

    POINTER pSel = &selBuf
    INT i = 0
    INT b = 0
    WHILE i < n
        b = #<BYTE>(pSel + i) & 0xFF
        IF b = 10 OR b = 13 THEN RETURN FALSE           ' multi-line selection: not a search term
        i++
    WEND

    INT m = Utf8ToAcp(pSel, n, &acpBuf, 300)
    IF m <= 0 THEN RETURN FALSE                         ' not representable in the dialog's ANSI field

    Searchtext = acpBuf
    startattop = FALSE
    found = FALSE
    RETURN TRUE
ENDSUB

SUB doFind(WINDOW w, INT ctrlID, STRING textToFind, INT ignoreCase)
    doFindDir(textToFind, ignoreCase, FALSE)
ENDSUB

': Find the next (backward = FALSE) or previous (backward = TRUE) occurrence; wraps once.
SUB doFindDir(STRING textToFind, INT ignoreCase, INT backward)
    IF textToFind = "" THEN
        ShowBalloonToast("Find Text", "Cannot search for an empty string.")
        RETURN
    ENDIF

    UINT hControl = g_hSciCtrl
    IF hControl = 0 THEN RETURN

    INT docLen = SendMessageA(hControl, SCI_GETLENGTH, 0, 0)
    IF docLen <= 0 THEN
        ShowBalloonToast("Find Text", "Cannot find the text '" + textToFind + "'")
        RETURN
    ENDIF

    ISTRING u8Find[1100]
    INT byteLen = AcpToUtf8(textToFind, &u8Find, 1100)
    IF byteLen <= 0 THEN RETURN

    INT searchFlags = 0
    IF ignoreCase = FALSE THEN searchFlags = searchFlags | SCFIND_MATCHCASE
    IF match_word <> 0    THEN searchFlags = searchFlags | SCFIND_WHOLEWORD
    SendMessageA(hControl, SCI_SETSEARCHFLAGS, searchFlags, 0)

    ' A target whose end is before its start makes Scintilla search backwards.
    INT fromPos = 0
    INT toPos = 0
    IF backward THEN
        fromPos = SendMessageA(hControl, SCI_GETSELECTIONSTART, 0, 0)
        toPos = 0
    ELSE
        fromPos = SendMessageA(hControl, SCI_GETSELECTIONEND, 0, 0)
        toPos = docLen
    ENDIF

    SendMessageA(hControl, SCI_SETTARGETSTART, fromPos, 0)
    SendMessageA(hControl, SCI_SETTARGETEND, toPos, 0)
    INT pos = SendMessageA(hControl, SCI_SEARCHINTARGET, byteLen, &u8Find)

    IF pos = -1 THEN                                  ' nothing before the end: wrap once
        IF backward THEN
            fromPos = docLen
            toPos = 0
        ELSE
            fromPos = 0
            toPos = docLen
        ENDIF
        SendMessageA(hControl, SCI_SETTARGETSTART, fromPos, 0)
        SendMessageA(hControl, SCI_SETTARGETEND, toPos, 0)
        pos = SendMessageA(hControl, SCI_SEARCHINTARGET, byteLen, &u8Find)
    ENDIF

    IF pos <> -1 THEN
        INT matchStart = SendMessageA(hControl, SCI_GETTARGETSTART, 0, 0)
        INT matchEnd   = SendMessageA(hControl, SCI_GETTARGETEND, 0, 0)
        SendMessageA(hControl, SCI_SETSEL, matchStart, matchEnd)
        SendMessageA(hControl, SCI_SCROLLCARET, 0, 0)
        UpdateGutter()
        found = TRUE
    ELSE
        ShowBalloonToast("Find Text", "Cannot find the text '" + textToFind + "'")
    ENDIF
ENDSUB

': F3 / Shift+F3 / menu: repeat the last search without the dialog.
SUB FindAgain(INT backward)
    IF Searchtext = "" THEN
        Show_Find(WIN, g_hSciCtrl, FALSE)               ' nothing to repeat yet: open Find
        RETURN
    ENDIF
    doFindDir(Searchtext, 1 - match_case, backward)
ENDSUB

SUB doReplace(WINDOW w, INT ctrlID, STRING textToFind, STRING textToRep, INT ignoreCase)
    UINT hControl = g_hSciCtrl
    IF hControl = 0 THEN RETURN

    IF textToFind = "" THEN
        ShowBalloonToast("Replace Text", "Cannot search for an empty string.")
        RETURN
    ENDIF

    ISTRING u8Find[1100]
    ISTRING u8Rep[1100]
    INT findLen = AcpToUtf8(textToFind, &u8Find, 1100)
    INT repLen  = AcpToUtf8(textToRep, &u8Rep, 1100)      ' 0 is fine: it deletes the match
    IF findLen <= 0 THEN RETURN

    INT selStart = SendMessageA(hControl, SCI_GETSELECTIONSTART, 0, 0)
    INT selEnd   = SendMessageA(hControl, SCI_GETSELECTIONEND, 0, 0)

    IF selEnd > selStart THEN
        ' replace only if the selection really is a match of the search text
        INT flags = 0
        IF ignoreCase = FALSE THEN flags = flags | SCFIND_MATCHCASE
        IF match_word <> 0    THEN flags = flags | SCFIND_WHOLEWORD
        SendMessageA(hControl, SCI_SETSEARCHFLAGS, flags, 0)
        SendMessageA(hControl, SCI_SETTARGETSTART, selStart, 0)
        SendMessageA(hControl, SCI_SETTARGETEND, selEnd, 0)

        INT hit = SendMessageA(hControl, SCI_SEARCHINTARGET, findLen, &u8Find)
        IF hit = selStart AND SendMessageA(hControl, SCI_GETTARGETEND, 0, 0) = selEnd THEN
            SendMessageA(hControl, SCI_REPLACETARGET, repLen, &u8Rep)
            SendMessageA(hControl, SCI_SETSEL, selStart + repLen, selStart + repLen)
        ENDIF
    ENDIF

    doFind(w, g_hSciCtrl, textToFind, ignoreCase)
    RETURN
ENDSUB

SUB doReplaceAll(WINDOW w, INT ctrlID, STRING textToFind, STRING textToRep, INT ignoreCase)
    IF textToFind = "" THEN RETURN

    UINT hControl = g_hSciCtrl
    IF hControl = 0 THEN RETURN

    ISTRING u8Find[1100]
    ISTRING u8Rep[1100]
    INT findByteLen = AcpToUtf8(textToFind, &u8Find, 1100)
    INT repByteLen  = AcpToUtf8(textToRep, &u8Rep, 1100)
    IF findByteLen <= 0 THEN RETURN

    INT count = 0
    INT searchPos = 0

    INT searchFlags = 0
    IF ignoreCase = FALSE THEN searchFlags = searchFlags | SCFIND_MATCHCASE
    IF match_word <> 0    THEN searchFlags = searchFlags | SCFIND_WHOLEWORD

    SendMessageA(hControl, SCI_SETSEARCHFLAGS, searchFlags, 0)

    SendMessageA(hControl, SCI_BEGINUNDOACTION, 0, 0)

    INT docLen = SendMessageA(hControl, SCI_GETLENGTH, 0, 0)

    WHILE searchPos < docLen
        SendMessageA(hControl, SCI_SETTARGETSTART, searchPos, 0)
        SendMessageA(hControl, SCI_SETTARGETEND, docLen, 0)

        INT pos = SendMessageA(hControl, SCI_SEARCHINTARGET, findByteLen, &u8Find)

        IF pos = -1 THEN BREAK

        INT matchStart = SendMessageA(hControl, SCI_GETTARGETSTART, 0, 0)
        SendMessageA(hControl, SCI_REPLACETARGET, repByteLen, &u8Rep)

        count++

        searchPos = matchStart + repByteLen
        docLen = SendMessageA(hControl, SCI_GETLENGTH, 0, 0)
    WEND

    SendMessageA(hControl, SCI_ENDUNDOACTION, 0, 0)

    ShowBalloonToast("Replace Text", STR$(count) + " replacements made.")
    RETURN
ENDSUB

': ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
': Native Scintilla Undo and Redo Dispatchers
': ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
SUB DoUndo(WINDOW w, INT ctrlID)
    IF SendMessageA(g_hSciCtrl, SCI_CANUNDO, 0, 0) <> 0 THEN
        SendMessageA(g_hSciCtrl, SCI_UNDO, 0, 0)
        SendMessageA(g_hSciCtrl, SCI_SCROLLCARET, 0, 0)
        UpdateGutter()
        UpdateStatusBar()
    ENDIF
ENDSUB

SUB DoRedo(WINDOW w, INT ctrlID)
    IF SendMessageA(g_hSciCtrl, SCI_CANREDO, 0, 0) <> 0 THEN
        SendMessageA(g_hSciCtrl, SCI_REDO, 0, 0)
        SendMessageA(g_hSciCtrl, SCI_SCROLLCARET, 0, 0)
        UpdateGutter()
        UpdateStatusBar()
    ENDIF
ENDSUB

': ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
': Helper Subroutines
': ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
SUB ScaleBitmapTo(INT hSrc, INT dw, INT dh), INT
    IF hSrc = 0 THEN RETURN 0
    INT hDC     = GetDC(0)
    INT hMemSrc = CreateCompatibleDC(hDC)
    INT hMemDst = CreateCompatibleDC(hDC)
    BITMAP bm
    GetObjectA(hSrc, LEN(bm), &bm)

    BITMAPINFO bmi
    RtlZeroMemory(&bmi, LEN(bmi))
    bmi.bmiHeader.biSize        = LEN(bmi.bmiHeader)
    bmi.bmiHeader.biWidth       = dw
    bmi.bmiHeader.biHeight      = dh
    bmi.bmiHeader.biPlanes      = 1
    bmi.bmiHeader.biBitCount    = 24
    bmi.bmiHeader.biCompression = 0
    POINTER pBits = NULL
    INT hDst = CreateDIBSection(hDC, &bmi, 0, &pBits, NULL, 0)

    INT hOldS = SelectObject(hMemSrc, hSrc)
    INT hOldD = SelectObject(hMemDst, hDst)
    SetStretchBltMode(hMemDst, 4)                       ' HALFTONE: smooth, these are textures
    SetBrushOrgEx(hMemDst, 0, 0, NULL)
    StretchBlt(hMemDst, 0, 0, dw, dh, hMemSrc, 0, 0, bm.bmWidth, bm.bmHeight, 0x00CC0020)
    SelectObject(hMemSrc, hOldS)
    SelectObject(hMemDst, hOldD)
    DeleteDC(hMemSrc)
    DeleteDC(hMemDst)
    ReleaseDC(0, hDC)
    RETURN hDst
ENDSUB

SUB LoadScaledBitmap(STRING nm$), INT
    INT hSrc = LoadImage(nm$, @IMGBITMAP)
    IF hSrc = 0 OR g_Dpi <= 96 THEN RETURN hSrc
    BITMAP bm
    GetObjectA(hSrc, LEN(bm), &bm)
    INT hNew = ScaleBitmapTo(hSrc, MulDiv(bm.bmWidth, g_Dpi, 96), MulDiv(bm.bmHeight, g_Dpi, 96))
    IF hNew = 0 THEN RETURN hSrc
    DeleteObject(hSrc)
    RETURN hNew
ENDSUB

' Scales every rectangle of a region. Shared edges map to identical values, so no gaps appear.
SUB ScaleRegion(INT hrgn), INT
    IF hrgn = 0 OR g_Dpi <= 96 THEN RETURN hrgn
    INT sz = GetRegionData(hrgn, 0, NULL)
    IF sz <= 0 THEN RETURN hrgn
    POINTER pBuf = SafeAllocHeap(sz)
    IF pBuf = NULL THEN RETURN hrgn
    IF GetRegionData(hrgn, sz, pBuf) = 0 THEN
        SafeFreeHeap(pBuf)
        RETURN hrgn
    ENDIF

    INT n = #<INT>(pBuf + 8)                            ' RGNDATAHEADER.nCount
    INT i, o
    FOR i = 0 TO 3                                      ' rcBound (offset 16)
        o = 16 + (i * 4)
        #<INT>(pBuf + o) = MulDiv(#<INT>(pBuf + o), g_Dpi, 96)
    NEXT i
    FOR i = 0 TO (n * 4) - 1                            ' rects start at offset 32
        o = 32 + (i * 4)
        #<INT>(pBuf + o) = MulDiv(#<INT>(pBuf + o), g_Dpi, 96)
    NEXT i

    INT hNew = ExtCreateRegion(NULL, sz, pBuf)
    SafeFreeHeap(pBuf)
    IF hNew = 0 THEN RETURN hrgn
    DeleteObject(hrgn)
    RETURN hNew
ENDSUB

SUB RegionScaled(STRING nm$), INT
    RETURN ScaleRegion(RGNFROMBITMAP(nm$))
ENDSUB

SUB ScaleStripBitmap(INT hSrc, INT s), INT
    IF hSrc = 0 THEN RETURN 0
    IF s < 1 THEN s = 1

    INT hDC     = GetDC(0)
    INT hMemSrc = CreateCompatibleDC(hDC)
    INT hMemDst = CreateCompatibleDC(hDC)

    BITMAP bm
    GetObjectA(hSrc, LEN(bm), &bm)
    INT dw = bm.bmWidth * s
    INT dh = bm.bmHeight * s

    ' 24-bit DIB section: exact colours and readable with GetPixel, like the loaded strip
    BITMAPINFO bmi
    RtlZeroMemory(&bmi, LEN(bmi))
    bmi.bmiHeader.biSize        = LEN(bmi.bmiHeader)
    bmi.bmiHeader.biWidth       = dw
    bmi.bmiHeader.biHeight      = dh
    bmi.bmiHeader.biPlanes      = 1
    bmi.bmiHeader.biBitCount    = 24
    bmi.bmiHeader.biCompression = 0
    POINTER pBits = NULL
    INT hDst = CreateDIBSection(hDC, &bmi, 0, &pBits, NULL, 0)

    INT hOldSrc = SelectObject(hMemSrc, hSrc)
    INT hOldDst = SelectObject(hMemDst, hDst)

    SetStretchBltMode(hMemDst, 3)          ' COLORONCOLOR = pure nearest-neighbour
    StretchBlt(hMemDst, 0, 0, dw, dh, hMemSrc, 0, 0, bm.bmWidth, bm.bmHeight, 0x00CC0020)

    SelectObject(hMemSrc, hOldSrc)
    SelectObject(hMemDst, hOldDst)
    DeleteDC(hMemSrc)
    DeleteDC(hMemDst)
    ReleaseDC(0, hDC)
    RETURN hDst
ENDSUB

SUB CreateHotToolbarBitmap(INT hBmpSrc), INT
    IF hBmpSrc = 0 THEN RETURN 0

    INT hDC = GetDC(WIN.hwnd)
    INT hMemSrc = CreateCompatibleDC(hDC)
    INT hMemDst = CreateCompatibleDC(hDC)

    BITMAP bm
    GetObjectA(hBmpSrc, LEN(bm), &bm)

    INT w = bm.bmWidth
    INT h = bm.bmHeight

    INT hBmpHot = CreateCompatibleBitmap(hDC, w, h)

    INT hOldSrc = SelectObject(hMemSrc, hBmpSrc)
    INT hOldDst = SelectObject(hMemDst, hBmpHot)

    INT x, y
    DWORD pxColor, r, g, b

    For y = 0 TO h - 1
        For x = 0 TO w - 1
            pxColor = API_GetPixel(hMemSrc, x, y)

            r = pxColor & 0xFF
            g = (pxColor >> 8) & 0xFF
            b = (pxColor >> 16) & 0xFF

            ' Lighten non-background pixels (assuming RGB 192,192,192 or transparent color isn't touched)
            IF (r <> 255) OR (g <> 0) OR (b <> 255) THEN
                r = r + 35 : IF r > 255 THEN r = 255
                g = g + 35 : IF g > 255 THEN g = 255
                b = b + 35 : IF b > 255 THEN b = 255
            ENDIF

            SetPixelV(hMemDst, x, y, (b << 16) | (g << 8) | r)
        Next x
    Next y

    SelectObject(hMemSrc, hOldSrc)
    SelectObject(hMemDst, hOldDst)

    DeleteDC(hMemSrc)
    DeleteDC(hMemDst)
    ReleaseDC(WIN.hwnd, hDC)

    RETURN hBmpHot
ENDSUB

SUB CreateDisabledToolbarBitmap(INT hBmpSrc), INT
    IF hBmpSrc = 0 THEN RETURN 0

    INT hDC = GetDC(WIN.hwnd)
    INT hMemSrc = CreateCompatibleDC(hDC)
    INT hMemDst = CreateCompatibleDC(hDC)

    BITMAP bm
    GetObjectA(hBmpSrc, LEN(bm), &bm)

    INT w = bm.bmWidth
    INT h = bm.bmHeight

    INT hBmpDisabled = CreateCompatibleBitmap(hDC, w, h)

    INT hOldSrc = SelectObject(hMemSrc, hBmpSrc)
    INT hOldDst = SelectObject(hMemDst, hBmpDisabled)

    INT x, y
    DWORD pxColor, r, g, b, gray

    For y = 0 TO h - 1
        For x = 0 TO w - 1
            pxColor = API_GetPixel(hMemSrc, x, y)

            r = pxColor & 0xFF
            g = (pxColor >> 8) & 0xFF
            b = (pxColor >> 16) & 0xFF

            ' Preserve transparent/background mask color (e.g., RGB 192,192,192)
            IF (r = 255) AND (g = 0) AND (b = 255) THEN
                SetPixelV(hMemDst, x, y, pxColor)
            ELSE
                ' Convert to gray scale & lower contrast/brightness
                gray = INT((r * 0.299) + (g * 0.587) + (b * 0.114))
                gray = 90 + INT(gray * 0.55)       ' range 90..230: dark outlines stay visible, whites stay light
                SetPixelV(hMemDst, x, y, (gray << 16) | (gray << 8) | gray)
            ENDIF
        Next x
    Next y

    SelectObject(hMemSrc, hOldSrc)
    SelectObject(hMemDst, hOldDst)

    DeleteDC(hMemSrc)
    DeleteDC(hMemDst)
    ReleaseDC(WIN.hwnd, hDC)

    RETURN hBmpDisabled
ENDSUB

SUB RotateBitmap90(INT hBmpSrc), INT
    INT hDC = GetDC(WIN.hwnd)
    INT hMemSrc = CreateCompatibleDC(hDC)
    INT hMemDst = CreateCompatibleDC(hDC)

    BITMAP bm
    GetObjectA(hBmpSrc, LEN(bm), &bm)

    INT srcW = bm.bmWidth
    INT srcH = bm.bmHeight
    INT dstW = srcH
    INT dstH = srcW

    INT hBmpDst = CreateCompatibleBitmap(hDC, dstW, dstH)

    INT hOldSrc = SelectObject(hMemSrc, hBmpSrc)
    INT hOldDst = SelectObject(hMemDst, hBmpDst)

    INT x, y
    DWORD pxColor = 0

    For y = 0 TO srcH - 1
        For x = 0 TO srcW - 1
            pxColor = API_GetPixel(hMemSrc, x, y)
            SetPixelV(hMemDst, (srcH - 1) - y, x, pxColor)
        Next x
    Next y

    SelectObject(hMemSrc, hOldSrc)
    SelectObject(hMemDst, hOldDst)

    DeleteDC(hMemSrc)
    DeleteDC(hMemDst)
    ReleaseDC(WIN.hwnd, hDC)

    RETURN hBmpDst
ENDSUB

SUB IsFileChanged()
    RET = g_IsDirty

    IF RET = TRUE THEN
        IF YesNoBox(WIN, "File was modified. Save changes ?", "Tpad") THEN
            IF g_CurrentLoadedPath <> "" THEN
                fName = g_CurrentLoadedPath      ' never save over some other file
                Save_As = 0
            ELSE
                fName = ""
                Save_As = 1                      ' unsaved document: ask for a name
            ENDIF
            DoSave()
        ELSE
            CancelAction = FALSE
        ENDIF
    ENDIF
ENDSUB

': ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
': Wine/Linux Safe Monospaced Font Resolver
': ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
SUB FontInstalled(STRING face$), INT
    UINT hdc = GetDC(NULL)
    IF hdc = 0 THEN RETURN FALSE

    UINT hF = CreateFontA(-12, 0, 0, 0, 400, 0, 0, 0, 0, 0, 0, 5, 0, face$)
    IF hF = 0 THEN
        ReleaseDC(NULL, hdc)
        RETURN FALSE
    ENDIF

    UINT hOld = SelectObject(hdc, hF)
    ISTRING got[64]
    got = ""
    GetTextFaceA(hdc, 63, &got)
    SelectObject(hdc, hOld)
    DeleteObject(hF)
    ReleaseDC(NULL, hdc)

    STRING g$ = got
    RETURN (LCASE$(g$) = LCASE$(face$))
ENDSUB

' Resolved once, then cached
SUB ResolveUIFace(), STRING
    IF g_UIFaceName = "" THEN
        IF FontInstalled("Consolas") THEN
            g_UIFaceName = "Consolas"
        ELSE
            g_UIFaceName = "Courier New"    ' last resort, never checked
        ENDIF
    ENDIF
    RETURN g_UIFaceName
ENDSUB

SUB InitUIFont()
    INT hDC = GetDC(WIN.hwnd)
    INT _logPixelsY = GetDeviceCaps(hDC, 90) ' LOGPIXELSY = 90
    ReleaseDC(WIN.hwnd, hDC)

    INT fontHeight = -MulDiv(g_App.fontSize, _logPixelsY, 72)

    g_hUIFont = CreateFontA(fontHeight, 0, 0, 0, g_App.fontWeight, 0, 0, 0, _
                            0, 0, 0, 5, 0, g_App.fontName)

    ' Fallback to system default GUI font if CreateFontA failed
    IF g_hUIFont = NULL THEN
        g_hUIFont = GetStockObject(17) ' DEFAULT_GUI_FONT = 17
    ENDIF

    ' Pass the application font handle directly to BrushedMenu
    g_WndMenu.SetMenuFont(g_hUIFont)
ENDSUB

SUB CreateUIFont(INT pt, INT weight), UINT
    STRING face$ = ResolveUIFace()
    INT px = -MulDiv(pt, g_Dpi, 72)
    RETURN CreateFontA(px, 0, 0, 0, weight, 0, 0, 0, 0, 0, 0, 5, 0, face$)   ' 5 = CLEARTYPE
ENDSUB

SUB GetSafeMonoFont(STRING preferredFont$), STRING
    IF LEN(preferredFont$) = 0 THEN preferredFont$ = "Consolas"
    IF FontInstalled(preferredFont$) THEN RETURN preferredFont$

    STRING fb$[4]
    fb$[0] = "Courier New"      : fb$[1] = "Liberation Mono"
    fb$[2] = "DejaVu Sans Mono" : fb$[3] = "Monospace"
    INT i
    FOR i = 0 TO 3
        IF FontInstalled(fb$[i]) THEN RETURN fb$[i]
    NEXT i
    RETURN "Courier New"
ENDSUB

SUB InjectUIFont(UINT hDlg)
    IF hDlg = 0 THEN RETURN

    ' Generate a UNIQUE font handle for this specific dialog/window
    UINT hLocalFont = CreateUIFont(g_App.fontSize, 400)

    IF hLocalFont <> 0 THEN
        UINT hPrev = GetPropA(hDlg, "Tpad_UIFont")
        ' Store the handle in the window properties for safe cleanup on close
        SetPropA(hDlg, "Tpad_UIFont", hLocalFont)

        SendMessageA(hDlg, 0x0030, hLocalFont, TRUE)
        EnumChildWindows(hDlg, &EnumSetFontProc, hLocalFont)
        IF hPrev <> 0 THEN DeleteObject(hPrev)
    ENDIF
ENDSUB

SUB EnumSetFontProc(UINT hWndChild, UINT hFont), INT
    IF hWndChild <> 0 AND hFont <> 0
        SendMessageA(hWndChild, 0x0030, hFont, TRUE)
    ENDIF
    RETURN TRUE
ENDSUB
': ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
': FileNew - Baseline Initialization for Empty Document
': ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
SUB FileNew()
    StopTimer(WIN, FILE_MONITOR_TIMER_ID)

    ClearAllBookmarks()
    g_App.encoding = ENC_UTF8 : g_App.codePage = 0

    g_IsLoading = TRUE

    SendMessageA(g_hSciCtrl, SCI_SETUNDOCOLLECTION, TRUE, 0)
    SendMessageA(g_hSciCtrl, SCI_SETTEXT, 0, &"")

    fName = ""
    g_CurrentLoadedPath = ""
    Save_As = 1

    SetLexerByExtension("")                 ' new document = default (plain text) syntax

    CONTROLCMD WIN, STATUS_1, @SWSETPANETEXT, 1, "0 B"
    CONTROLCMD WIN, STATUS_1, @SWSETPANETEXT, 2, "UTF-8"
    CONTROLCMD WIN, STATUS_1, @SWSETPANETEXT, 3, ""

    SetEOLMode(0, FALSE)

    SendMessageA(g_hSciCtrl, SCI_EMPTYUNDOBUFFER, 0, 0)
    SendMessageA(g_hSciCtrl, SCI_SETSAVEPOINT, 0, 0)

    g_IsDirty = FALSE
    g_CachedCaption$ = ""
    UpdateTitleBar()

    SetFocusA(g_hSciCtrl)

    g_IsLoading = FALSE
    SyncEncodingMenuCheck(g_App.encoding)
    UpdateGutter()
    UpdateStatusBar()

    StartTimer(WIN, 1000, FILE_MONITOR_TIMER_ID)
    ApplyThemeStyles(g_App.themeID)
ENDSUB

': ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
': FileOpen - Deterministic Loading Protocol
': ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
SUB DoOpen()
ISTRING dirBuf[300]
STRING selectedPath$
INT loadSuccess


    ' Suspend the text editor control's visual updates (massively speeds up large file insertion)
    SendMessageA(g_hSciCtrl, 0x000B, FALSE, 0) ' WM_SETREDRAW = 0x000B
    ' Force the main window and UI components to paint instantly BEFORE the thread blocks
    InvalidateRect(WIN.hwnd, NULL, FALSE)
    UpdateWindow(WIN.hwnd)

    StopTimer(WIN, FILE_MONITOR_TIMER_ID)
    SetProcessSpeed(2)
    selectedPath$ = ""
    loadSuccess = FALSE

    IF fName = "" THEN
        dirBuf = ""
        GetPathFile(g_CurrentLoadedPath, &dirBuf, NULL)
        STRING startDir$ = dirBuf
        selectedPath$ = FileRequest("Open File", WIN, 1, Filter$, "txt", 0, startDir$)
    ELSE
        selectedPath$ = fName
    ENDIF

    IF LEN(selectedPath$) = 0 THEN
        fName = ""
        SetProcessSpeed(1)
        GOTO OpenCleanup
    ENDIF

    IF LEN(selectedPath$) >= 260 THEN
        ShowBalloonToast("Path Too Long", "The selected file path exceeds MAX_PATH (260 characters):" + g_CRLF + selectedPath$)
        fName = ""
        SetProcessSpeed(1)
        GOTO OpenCleanup
    ENDIF

    fName = selectedPath$
    g_IsLoading = TRUE
    loadSuccess = LoadMemoryMappedFile(fName)

    IF loadSuccess = TRUE THEN
        ClearAllBookmarks()
        newName = fName
        mruArray()
        g_CurrentLoadedPath = fName
        StartFileMonitoring()
        g_IsDirty = FALSE
        g_CachedCaption$ = ""
        UpdateTitleBar()
        SetLexerByExtension(fName)
        UpdateGutter()
        IF g_hSciCtrl <> 0 THEN SetFocusA(g_hSciCtrl)
        IF g_hSciCtrl <> 0 THEN
            SendMessageA(g_hSciCtrl, SCI_EMPTYUNDOBUFFER, 0, 0)
            SendMessageA(g_hSciCtrl, SCI_SETSAVEPOINT, 0, 0)
        ENDIF
    ELSE
        STRING openMsg$ = DescribeWinError(g_LoadError) + g_CRLF + fName
        ShowBalloonToast("Cannot open file", openMsg$)
        fName = ""
    ENDIF

    g_IsLoading = FALSE
    UpdateStatusBar()
    StartTimer(WIN, 1000, FILE_MONITOR_TIMER_ID)
    SetProcessSpeed(1)
    DoResize()
    ApplyThemeStyles(g_App.themeID)

LABEL OpenCleanup
    ' Resume text editor visual updates and force it to draw the newly loaded text
    SendMessageA(g_hSciCtrl, 0x000B, TRUE, 0)
    InvalidateRect(g_hSciCtrl, NULL, TRUE)
    UpdateWindow(g_hSciCtrl)
/*
    IF loadSuccess = TRUE THEN
        endTime = GetTickCount()
        elapsedSec = (endTime - startTime) / 1000.0
        IF elapsedSec < 0.01 THEN elapsedSec = 0.01

        DWORD bytesRead = SendMessageA(g_hSciCtrl, SCI_GETTEXTLENGTH, 0, 0)

        GetReadableFileSize(bytesRead, &szSize)



        szTitle = "Tpad Notification"
        wsprintfA(&szMsg, "Loaded %s in %u.%02u seconds !", &szSize, INT(elapsedSec), INT((elapsedSec - INT(elapsedSec)) * 100.0))
        ShowBalloonToast(&szTitle, &szMsg)
    ENDIF
*/
    RETURN TRUE
ENDSUB
': ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
': Open MRU file
': ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
SUB OpenRecentFile(INT idx)
    CancelAction = FALSE
    IsFileChanged()
    IF CancelAction = TRUE THEN RETURN             ' user cancelled the "save changes?" prompt

    fName = g_App.mru[idx]
    IF fName = "Empty" THEN RETURN

    IF FileExists(fName) <> 1 THEN
        MESSAGEBOX(WIN, "The selected file no longer exists on disk:" + g_CRLF + fName + g_CRLF + g_CRLF + _
"It will be removed from the recent files list.", "File Not Found", MB_OK | MB_ICONWARNING)
        RemoveMRUItem(idx)
        fName = ""
    ELSE
        STARTTIMER WIN, 10, 3000                   ' the timer loads fName
    ENDIF
ENDSUB

': ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
': Path handling after Notepad2 Helpers.c (c) Florian Balmer
': ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

' Canonical form: absolute, "." and ".." resolved, "/" turned into "\", long (non-8.3) names, upper-case drive letter.
SUB NormalizePath(STRING p$), STRING
    IF p$ = "" OR p$ = "Empty" THEN RETURN p$
    ISTRING a[520]
    ISTRING b[520]
    INT n = GetFullPathNameA(p$, 519, &a, NULL)
    IF n = 0 OR n > 519 THEN RETURN p$
    STRING r$ = a
    n = GetLongPathNameA(&a, &b, 519)                ' fails for a missing file: keep the full path then
    IF n > 0 AND n <= 519 THEN r$ = b
    IF MID$(r$, 2, 1) = ":" THEN r$ = UCASE$(LEFT$(r$, 1)) + MID$(r$, 2)
    RETURN r$
ENDSUB

' Absolute path -> path relative to the exe folder (for the INI). Other drive or too far away: stays absolute.
SUB RelativeToApp(STRING p$), STRING
    IF p$ = "" OR p$ = "Empty" THEN RETURN p$
    STRING bs$ = CHR$(92)
    STRING base$ = GETSTARTPATH
    IF RIGHT$(base$, 1) <> bs$ THEN base$ = base$ + bs$
    IF MID$(p$, 2, 1) <> ":" OR MID$(base$, 2, 1) <> ":" THEN RETURN p$      ' UNC etc.
    IF LCASE$(LEFT$(p$, 3)) <> LCASE$(LEFT$(base$, 3)) THEN RETURN p$        ' other drive

    STRING fl$ = LCASE$(p$)
    STRING bl$ = LCASE$(base$)
    INT common = 0
    INT i = 1
    WHILE i <= LEN(fl$) AND i <= LEN(bl$)
        IF MID$(fl$, i, 1) <> MID$(bl$, i, 1) THEN BREAK
        IF MID$(fl$, i, 1) = bs$ THEN common = i
        i = i + 1
    WEND
    IF common < 3 THEN RETURN p$

    INT ups = 0
    INT k
    FOR k = common + 1 TO LEN(base$)
        IF MID$(base$, k, 1) = bs$ THEN ups = ups + 1
    NEXT k
    IF ups > 3 THEN RETURN p$                        ' "..\..\..\..\x" is no more portable than an absolute path

    STRING rel$ = ""
    FOR k = 1 TO ups
        rel$ = rel$ + ".." + bs$
    NEXT k
    RETURN rel$ + MID$(p$, common + 1)
ENDSUB

' INI value -> normalised absolute path (handles absolute, relative and %ENV% entries)
SUB AbsoluteFromApp(STRING s$), STRING
    IF s$ = "" OR s$ = "Empty" THEN RETURN s$
    STRING bs$ = CHR$(92)
    STRING r$ = s$
    IF INSTR(r$, "%") > 0 THEN
        ISTRING e[520]
        INT n = ExpandEnvironmentStringsA(r$, &e, 519)
        IF n > 0 AND n <= 519 THEN r$ = e
    ENDIF
    IF MID$(r$, 2, 1) <> ":" AND LEFT$(r$, 2) <> bs$ + bs$ THEN
        STRING base$ = GETSTARTPATH
        IF RIGHT$(base$, 1) <> bs$ THEN base$ = base$ + bs$
        r$ = base$ + r$
    ENDIF
    RETURN NormalizePath(r$)
ENDSUB

': ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
': DoSave - File Saving Engine with State Clearing
': ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
SUB DoSave()
    StopTimer(WIN, FILE_MONITOR_TIMER_ID)

    STRING prevName$ = fName
    INT saveSuccess = FALSE
    INT roRestore = FALSE
    INT attrs = 0
    INT ans = 0
    ISTRING eolBuf[16]
    ISTRING dirBuf[300]

    IF Save_As = 1 OR fName = "" THEN
        dirBuf = ""
        GetPathFile(fName, &dirBuf, NULL)
        STRING startDir$ = dirBuf
        fName = FileRequest("Save File", WIN, 0, Filter$, "txt", 0, startDir$)
    ENDIF

    IF LEN(fName) = 0 THEN
        fName = prevName$                ' cancelled: keep the document's name
        IF g_IsFileMonitored AND g_CurrentLoadedPath <> "" THEN
            STARTTIMER WIN, FILE_MONITOR_INTERVAL, FILE_MONITOR_TIMER_ID
        ENDIF
        RETURN
    ENDIF

    INT pathLen = LEN(fName)
    IF pathLen >= 260 THEN
        ShowBalloonToast("Path Too Long", "The selected file path exceeds MAX_PATH (260 characters):" + g_CRLF + fName)
        fName = prevName$
        IF g_IsFileMonitored AND g_CurrentLoadedPath <> "" THEN
            STARTTIMER WIN, FILE_MONITOR_INTERVAL, FILE_MONITOR_TIMER_ID
        ENDIF
        RETURN
    ENDIF

    ISTRING safePath$[1024]
    safePath$ = fName

    ' --- read-only target: ask, never strip the flag silently ---
    attrs = GetFileAttributesA(safePath$)                   ' -1 = file does not exist
    IF attrs <> -1 THEN
        IF (attrs & 1) <> 0 THEN                            ' FILE_ATTRIBUTE_READONLY
            ans = MessageBoxA(WIN.hwnd, safePath$ + g_CRLF + g_CRLF + "This file is read-only." + g_CRLF + g_CRLF + "Yes: overwrite it (it will stay read-only)" + g_CRLF + "No: save under another name" + g_CRLF + "Cancel: do not save", "Tpad", 0x233)
            IF ans = 6 THEN                                 ' IDYES
                INT cleared = attrs - 1
                IF cleared = 0 THEN cleared = 0x80          ' FILE_ATTRIBUTE_NORMAL
                SetFileAttributesA(safePath$, cleared)
                roRestore = TRUE
            ELSEIF ans = 7 THEN                             ' IDNO: Save As
                fName = prevName$
                Save_As = 1
                DoSave()
                RETURN
            ELSE                                            ' Cancel
                fName = prevName$
                IF g_IsFileMonitored AND g_CurrentLoadedPath <> "" THEN
                    STARTTIMER WIN, FILE_MONITOR_INTERVAL, FILE_MONITOR_TIMER_ID
                ENDIF
                RETURN
            ENDIF
        ENDIF
    ENDIF

    PrepareDocumentForSave()
    saveSuccess = SaveBufferToFile(safePath$)
    Trace("DoSave saveSuccess=" + STR$(saveSuccess) + " path=" + safePath$)

    IF roRestore THEN                                       ' put the read-only flag back, win or lose
        attrs = GetFileAttributesA(safePath$)
        IF attrs <> -1 THEN SetFileAttributesA(safePath$, attrs | 1)
    ENDIF

    IF saveSuccess = TRUE THEN
        DWORD FSIZE = 0
        HANDLE hCheck = CreateFileA(safePath$, FILE_READ_DATA, FILE_SHARE_READ, NULL, OPEN_EXISTING, 0, NULL)
        IF hCheck <> INVALID_HANDLE_VALUE THEN
            FSIZE = GetFileSize(hCheck, NULL)
            CloseHandle(hCheck)
        ENDIF

        lstrcpynA(&eolBuf, g_App.eolMode, 15)

        ISTRING sizeStr[32]
        GetReadableFileSize(FSIZE, &sizeStr)
        CONTROLCMD WIN, STATUS_1, @SWSETPANETEXT, 1, sizeStr
        CONTROLCMD WIN, STATUS_1, @SWSETPANETEXT, 3, eolBuf

        SendMessageA(g_hSciCtrl, SCI_SETSAVEPOINT, 0, 0)
        g_EolPending = FALSE
        g_IsDirty = FALSE
        g_CurrentLoadedPath = safePath$
        fName = safePath$
        Save_As = 0

        UpdateTitleBar()
        SetFocusA(g_hSciCtrl)
        UpdateStatusBar()

        StartFileMonitoring()
    ELSE
        IF g_SaveError <> 0 THEN
            STRING failMsg$ = DescribeWinError(g_SaveError) + g_CRLF + safePath$
            ShowBalloonToast("Save failed", failMsg$)
        ENDIF
        fName = prevName$            ' a failed "Save As" must not rename the document
        IF g_IsFileMonitored AND g_CurrentLoadedPath <> "" THEN
            StartTimer(WIN, 1000, FILE_MONITOR_TIMER_ID)
        ENDIF
        RETURN
    ENDIF
ENDSUB

SUB DoPrint()
    UINT hPrt
    STRING printName
    INT pagefrom = 1, pageto = 1, copies = 1, collate = 0
    printName = PRTDIALOG(NULL, pagefrom, pageto, copies, collate)
    If (hPrt)
        INT txtLen = 0
        txtLen = SendMessageA(g_hSciCtrl, SCI_GETTEXT, 0, 0)
        IF txtLen > 0 THEN
            POINTER pBuf = SafeAllocHeap(txtLen + 2)
            IF pBuf <> 0 THEN
                SendMessageA(g_hSciCtrl, SCI_GETTEXT, txtLen + 1, pBuf)
                WRITEPRINTER hPrt, #<STRING>pBuf
                SafeFreeHeap(pBuf)
            ENDIF
        ENDIF
        CLOSEPRINTER hPrt
    EndIf
EndSub

': ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
': Layout & Resizing Engine (Optimized for Live Dragging)
': ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
SUB DoResize()
    INT totalLines
    GetClientSize WIN, posLEFT, posTOP, posWIDTH, posHEIGHT
    SendMessage(WIN, SB_GETRECT, 0, BRECT, STATUS_1)
    STATUS_HEIGHT = BRECT.BOTTOM - BRECT.TOP

    ApplyStatusParts()
    CONTROLCMD WIN, STATUS_1, @SWRESIZE

    SetSize WIN, 0, 0, posWIDTH, g_ToolbarH, 2000 ' Toolbar
    INT topToolbarH = g_ToolbarH

    IF g_IsResizing = FALSE THEN
        IF g_IconSz > 16 THEN
            SendMessage(hToolBar, 0x0420, 0, (g_IconSz << 16) | g_IconSz)               ' TB_SETBITMAPSIZE
            SendMessage(hToolBar, 0x041F, 0, ((g_IconSz + 6) << 16) | (g_IconSz + 7))   ' TB_SETBUTTONSIZE
        ENDIF
        SendMessage(hToolBar, TB_AUTOSIZE, 0, 0)
    ENDIF

    PlaceGotoControls()

    INT numCharW = 8
    INT hdcScreen = GetDC(WIN.HWND)

    IF hdcScreen <> 0 THEN
        INT fontHeight = -MulDiv(g_App.fontSize, GetDeviceCaps(hdcScreen, 90), 72)
        INT hAppFont = CreateFontA(fontHeight, 0, 0, 0, g_App.fontWeight, 0, 0, 0, _
                                   0, 0, 0, 5, 0, g_App.fontName)

        IF hAppFont <> 0 THEN
            INT oldF = SelectObject(hdcScreen, hAppFont)
            SIZE charSize

            IF GetTextExtentPoint32A(hdcScreen, "0", 1, &charSize) <> 0 THEN
                numCharW = charSize.cx
            ENDIF

            SelectObject(hdcScreen, oldF)
            DeleteObject(hAppFont)
        ENDIF

        ReleaseDC(WIN.HWND, hdcScreen)
    ENDIF

    IF numCharW <= 0 THEN numCharW = 8

    totalLines = 1
    IF g_hSciCtrl <> 0 THEN
        totalLines = SendMessageA(g_hSciCtrl, SCI_GETLINECOUNT, 0, 0)
    ENDIF
    IF totalLines < 1 THEN totalLines = 1

    INT numDigits = LEN(STR$(totalLines))
    IF numDigits < 3 THEN numDigits = 3

    gutterW = (numDigits * numCharW) + DpiPx(21)
    IF gutterW < DpiPx(64) THEN gutterW = DpiPx(64)

    topToolbarH = g_ToolbarH
    INT clientTop = posTOP + topToolbarH
    INT clientHeight = (posHEIGHT - STATUS_HEIGHT) - topToolbarH
    INT editH = clientHeight - (textH + 2)
    INT editW = posWIDTH - gutterW

    SetSize W0, posLEFT, clientTop, posWIDTH, textH + 2
    SetSize W1, posLEFT, clientTop + textH + 2, gutterW, editH
    SetWindowPos(g_hSciCtrl, 0, posLEFT + gutterW, clientTop + textH + 2, editW, editH, SWP_NOZORDER | SWP_NOACTIVATE)

    IF g_IsResizing = TRUE THEN
        InvalidateRect(W1.HWND, NULL, FALSE)
        InvalidateRect(W0.HWND, NULL, FALSE)
    ELSE
        DrawRuler()
        InvalidateRect(W0.HWND, NULL, FALSE)
        InvalidateRect(W1.HWND, NULL, FALSE)
        InvalidateRect(g_hSciCtrl, NULL, FALSE)
    ENDIF
ENDSUB

SUB InitRuler()
    OpenWindow W0, 0, 0, 0, 0, WS_CHILD | WS_VISIBLE | SS_NOTIFY | @NoCaption | @noautodraw | 0x4, WIN.hwnd, "", &RulerWndProc
    SetWindowSubclass(W0.hwnd, &subclassProc, subclassID2, 0)
    SetFont W0, g_App.fontName, g_App.fontSize, g_App.fontWeight, g_App.fontFlags
    GETTEXTSIZE(W0, "0", textW, textH)
    SetWindowColor(W0, RGB(224, 220, 224))
    FrontPen W0, RGB(64, 64, 64)
    BackPen W0, RGB(224, 220, 224)

    INT fHeight = textH
    IF fHeight <= 0 THEN fHeight = 15
    STRING activeFontName = g_App.fontName
    IF activeFontName = "" THEN activeFontName = "Consolas"

    g_hRulerFont        = CreateFont(fHeight, 0, 0, 0, g_App.fontWeight, (g_App.fontFlags & 2), (g_App.fontFlags & 4), 0, 0, 0, 0, 5, 0, activeFontName)
    g_hRulerSepPen      = CreatePen(PS_SOLID, 1, RGB(160, 160, 170))
    g_hRulerPolePen     = CreatePen(PS_SOLID, 1, RGB(70, 70, 80))
    g_hRulerFlagPen     = CreatePen(PS_SOLID, 1, RGB(0, 100, 40))
    g_hRulerFlagBrush   = CreateSolidBrush(RGB(0, 220, 100))
    g_hRulerArrowPen    = CreatePen(PS_SOLID, 1, RGB(60, 60, 70))
    g_hRulerEraserPen   = CreatePen(PS_SOLID, 1, RGB(180, 80, 100))
    g_hRulerEraserBrush = CreateSolidBrush(RGB(240, 130, 150))
ENDSUB

SUB InitGutter()
    OpenWindow W1, 0, 0, 0, 0, WS_CHILD | WS_VISIBLE | SS_NOTIFY | @NoCaption | @noautodraw | 0x4, WIN.hwnd, "", &GutterWndProc
    SetWindowSubclass(W1.hwnd, &subclassProc, subclassID, 0)
    SetFont W1, g_App.fontName, g_App.fontSize, g_App.fontWeight, g_App.fontFlags
    GETTEXTSIZE(W1, "0", textW, textH)
    SetWindowColor(W1, RGB(224, 220, 224))
    FrontPen W1, RGB(64, 64, 64)
    BackPen W1, RGB(224, 220, 224)
ENDSUB

SUB EnsureGutterCache(INT w, INT h, INT hdcRef), INT
    IF g_hGutDC = 0 THEN
        g_hGutDC = CreateCompatibleDC(hdcRef)
        IF g_hGutDC = 0 THEN RETURN FALSE
    ENDIF

    ' DIB: rebuild only when the size changed
    IF g_hGutDib = 0 OR w <> g_GutW OR h <> g_GutH THEN
        BITMAPINFO bmi
        RtlZeroMemory(&bmi, LEN(bmi))
        bmi.bmiHeader.biSize        = LEN(bmi.bmiHeader)
        bmi.bmiHeader.biWidth       = w
        bmi.bmiHeader.biHeight      = -h
        bmi.bmiHeader.biPlanes      = 1
        bmi.bmiHeader.biBitCount    = 32
        bmi.bmiHeader.biCompression = 0

        POINTER pNewBits = NULL
        INT hNew = CreateDIBSection(hdcRef, &bmi, 0, &pNewBits, NULL, 0)
        IF hNew = 0 THEN RETURN FALSE

        INT hPrev = SelectObject(g_hGutDC, hNew)
        IF g_hGutOldBmp = 0 THEN g_hGutOldBmp = hPrev   ' remember the original 1x1 bitmap once
        IF g_hGutDib <> 0 THEN DeleteObject(g_hGutDib)

        g_hGutDib  = hNew
        g_pGutBits = pNewBits
        g_GutW = w
        g_GutH = h
    ENDIF

    ' Font: rebuild only when name/size/weight/flags/DPI changed
    INT dpi = GetDeviceCaps(hdcRef, 90)
    STRING key$ = g_App.fontName + "|" + STR$(g_App.fontSize) + "|" + STR$(g_App.fontWeight) + "|" + STR$(g_App.fontFlags) + "|" + STR$(dpi)

    IF g_hGutFont = 0 OR key$ <> g_GutFontKey THEN
        INT px = -MulDiv(g_App.fontSize, dpi, 72)
        IF px = 0 THEN px = -13

        STRING fname$ = g_App.fontName
        IF fname$ = "" THEN fname$ = "Consolas"

        INT hNewFont = CreateFontA(px, 0, 0, 0, g_App.fontWeight, (g_App.fontFlags & 2), (g_App.fontFlags & 4), 0, 0, 0, 0, 5, 0, fname$)
        IF hNewFont <> 0 THEN
            SelectObject(g_hGutDC, hNewFont)
            IF g_hGutFont <> 0 THEN DeleteObject(g_hGutFont)
            g_hGutFont   = hNewFont
            g_GutFontKey = key$
        ENDIF
    ENDIF

    ' Pens and brush: created once
    IF g_hGutPolePen   = 0 THEN g_hGutPolePen   = CreatePen(PS_SOLID, 1, RGB(70, 70, 80))
    IF g_hGutFlagPen   = 0 THEN g_hGutFlagPen   = CreatePen(PS_SOLID, 1, RGB(0, 100, 40))
    IF g_hGutFlagBrush = 0 THEN g_hGutFlagBrush = CreateSolidBrush(RGB(0, 220, 100))

    RETURN TRUE
ENDSUB

SUB FreeGutterCache()
    IF g_hGutDC <> 0 THEN
        IF g_hGutOldBmp <> 0 THEN SelectObject(g_hGutDC, g_hGutOldBmp)
        DeleteDC(g_hGutDC)
        g_hGutDC = 0
        g_hGutOldBmp = 0
    ENDIF
    IF g_hGutDib       <> 0 THEN DeleteObject(g_hGutDib)       : g_hGutDib = 0
    IF g_hGutFont      <> 0 THEN DeleteObject(g_hGutFont)      : g_hGutFont = 0
    IF g_hGutPolePen   <> 0 THEN DeleteObject(g_hGutPolePen)   : g_hGutPolePen = 0
    IF g_hGutFlagPen   <> 0 THEN DeleteObject(g_hGutFlagPen)   : g_hGutFlagPen = 0
    IF g_hGutFlagBrush <> 0 THEN DeleteObject(g_hGutFlagBrush) : g_hGutFlagBrush = 0
    g_pGutBits = NULL
    g_GutW = 0 : g_GutH = 0
ENDSUB

SUB GutterWndProc(), INT
    Select @CLASS
        Case @IDPAINT
            ' UpdateGutter()
            ValidateRect(W1.hwnd, NULL)

        Case WM_ERASEBKGND
            RETURN 1

        Case WM_LBUTTONDOWN
            INT clickY = @MOUSEY

            IF g_hSciCtrl <> 0 THEN
                INT firstVisLine = SendMessageA(g_hSciCtrl, SCI_GETFIRSTVISIBLELINE, 0, 0)

                INT lineH = SendMessageA(g_hSciCtrl, SCI_TEXTHEIGHT, 0, 0)
                IF lineH <= 0 THEN lineH = 15

                INT clickedVisLine = firstVisLine + (clickY / lineH)

                INT clickedDocLine = SendMessageA(g_hSciCtrl, SCI_DOCLINEFROMVISIBLE, clickedVisLine, 0)
                INT totalLines     = SendMessageA(g_hSciCtrl, SCI_GETLINECOUNT, 0, 0)

                IF clickedDocLine >= 0 AND clickedDocLine < totalLines THEN
                    ToggleBookmark(clickedDocLine)
                    UpdateGutter()
                    InvalidateRect(W1.hwnd, NULL, FALSE)
                ENDIF
            ENDIF
            RETURN 0

    EndSelect
    RETURN 0
ENDSUB

SUB subclassProc(hWnd : INT, uMsg : INT, wParam : INT, lParam : INT, uIdSubclass : UINT_PTR, dwRefData : DWORD_PTR), INT
    Select uMsg
        Case WM_ERASEBKGND
            RETURN 1

        Case WM_PAINT
            DefSubclassProc(hWnd, uMsg, wParam, lParam)
            IF uIdSubclass = subclassID THEN
                UpdateGutter()          ' gutter window only
            ELSE
                HSCROLLPOS = SendMessageA(g_hSciCtrl, SCI_SETHSCROLLBAR, 0, 0)
                DrawRuler()             ' ruler window only
            ENDIF
            RETURN 0
    EndSelect

    RETURN DefSubclassProc(hWnd, uMsg, wParam, lParam)
EndSub

SUB RulerWndProc(), INT
    STATIC INT isHoveringToolbar = FALSE

    Select @CLASS
        Case @IDPAINT
            HSCROLLPOS = SendMessageA(g_hSciCtrl, SCI_SETHSCROLLBAR, 0, 0)
            ' DrawRuler()
            ValidateRect(W0.hwnd, NULL)

        Case WM_ERASEBKGND
            RETURN 1

        Case WM_MOUSEMOVE

            ' Check if mouse is anywhere over the microtoolbar region
            IF (@mouseX >= 1) & (@mousex <= gutterW) THEN
                IF isHoveringToolbar = FALSE THEN
                    isHoveringToolbar = TRUE
                    ShowBalloonToast("Bookmark Shortcuts", "<CTRL>+F2 : Toggle Bookmark" + g_CRLF + "F2 : Next Bookmark" + g_CRLF + "<SHIFT>+F2 : Previous Bookmark")
                ENDIF
            ELSE
                IF isHoveringToolbar = TRUE THEN
                    isHoveringToolbar = FALSE
                    HideBalloonToast()
                ENDIF
            ENDIF
            RETURN 0

        Case WM_MOUSELEAVE
            isHoveringToolbar = FALSE
            HideBalloonToast()
            RETURN 0

        Case WM_LBUTTONDOWN
            INT clickX = @MOUSEX

            IF clickX < gutterW THEN
                DWORD selStart = 0
                selStart = SendMessageA(g_hSciCtrl, SCI_GETCURRENTPOS, 0, 0)
                INT caretLine = 0
                caretLine = SendMessageA(g_hSciCtrl, SCI_LINEFROMPOSITION, selStart, 0)
                INT totalLines = 1
                totalLines = SendMessageA(g_hSciCtrl, SCI_GETLINECOUNT, 0, 0)

                IF clickX >= 2 AND clickX <= 15 THEN
                    ToggleBookmark(caretLine)
                    UpdateGutter()
                ELSEIF clickX >= 16 AND clickX <= 29 THEN
                    GotoPrevBookmark(caretLine, totalLines)
                ELSEIF clickX >= 30 AND clickX <= 42 THEN
                    GotoNextBookmark(caretLine, totalLines)
                ELSEIF clickX >= 43 AND clickX <= 61 THEN
                    ClearAllBookmarks()
                    UpdateGutter()
                ENDIF
                RETURN 0
            ENDIF

    EndSelect
    RETURN 0
ENDSUB
': ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
': File Monitoring Engine Subroutines
': ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
SUB GetFileWriteTime(POINTER pFilePath, POINTER pFileTime), INT
    IF pFilePath = NULL OR pFileTime = NULL THEN RETURN FALSE

    HANDLE hFile = CreateFileA(#<STRING>pFilePath, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, NULL, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, NULL)
    IF hFile = INVALID_HANDLE_VALUE THEN RETURN FALSE

    INT result = GetFileTime(hFile, NULL, NULL, pFileTime)
    CloseHandle(hFile)
    RETURN result
ENDSUB

SUB StartFileMonitoring()
    IF g_CurrentLoadedPath = "" THEN
        g_IsFileMonitored = FALSE
        STOPTIMER WIN, FILE_MONITOR_TIMER_ID
        RETURN
    ENDIF

    IF GetFileWriteTime(&g_CurrentLoadedPath, &g_LastFileWriteTime) = TRUE THEN
        g_IsFileMonitored = TRUE
        STARTTIMER WIN, FILE_MONITOR_INTERVAL, FILE_MONITOR_TIMER_ID
    ELSE
        g_IsFileMonitored = FALSE
    ENDIF
ENDSUB

SUB CheckFileStatus()
    IF g_IsFileMonitored = FALSE OR g_CurrentLoadedPath = "" THEN RETURN

    FILETIME currentWriteTime
    RtlZeroMemory(&currentWriteTime, LEN(currentWriteTime))

    IF GetFileWriteTime(&g_CurrentLoadedPath, &currentWriteTime) = TRUE THEN
        IF CompareFileTime(&g_LastFileWriteTime, &currentWriteTime) <> 0 THEN
            STOPTIMER WIN, FILE_MONITOR_TIMER_ID

            STRING msg = "The file on disk has been modified by another program:" + g_CRLF
            msg = msg + g_CurrentLoadedPath + g_CRLF + g_CRLF
            msg = msg + "Do you want to reload it?"

            INT choice = MESSAGEBOX(WIN, msg, "File Modified Outside Tpad", MB_YESNO | MB_ICONQUESTION)
            IF choice = IDYES THEN
                fName = g_CurrentLoadedPath
                IF LoadMemoryMappedFile(g_CurrentLoadedPath) THEN
                    SendMessageA(g_hSciCtrl, SCI_EMPTYUNDOBUFFER, 0, 0)
                    GetFileWriteTime(&g_CurrentLoadedPath, &g_LastFileWriteTime)
                    g_IsDirty = FALSE
                    UpdateTitleBar()
                    UpdateGutter()
                ENDIF
            ELSE
                fName = g_CurrentLoadedPath
                g_LastFileWriteTime = currentWriteTime
            ENDIF

            STARTTIMER WIN, FILE_MONITOR_INTERVAL, FILE_MONITOR_TIMER_ID
       ENDIF
    ELSE
        STOPTIMER WIN, FILE_MONITOR_TIMER_ID
        g_IsFileMonitored = FALSE

        STRING errMsg = "The open file has been deleted or removed from disk:" + g_CRLF
        errMsg = errMsg + g_CurrentLoadedPath
        MESSAGEBOX(WIN, errMsg, "File Removed", MB_OK | MB_ICONWARNING)
    ENDIF
ENDSUB

SUB EDIT(HWND : INT, uMsg : INT, wParam : INT, lParam : POINTER), INT
    STATIC INT bSkipChar = FALSE
    INT selStart, caretLine, res
    INT isCtrlDown = FALSE
    INT isAltDown  = FALSE

    ' Use GetKeyState to read the thread message queue state
    IF (GetKeyState(VK_CONTROL) & 0x8000) THEN isCtrlDown = TRUE
    IF (GetKeyState(VK_MENU)    & 0x8000) THEN isAltDown  = TRUE

    ' Ignore Ctrl if AltGr is pressed (AltGr = Ctrl + Alt on European layouts)
    IF isAltDown THEN isCtrlDown = FALSE

    Select uMsg

        Case 0x007B    ' WM_CONTEXTMENU
            ShowEditContextMenu(lParam)
            RETURN 0
        Case WM_KEYDOWN
            bSkipChar = FALSE

            IF wParam = VK_ESCAPE THEN
                bSkipChar = TRUE
                SendMessageA(WIN.hwnd, WM_COMMAND, CMD_EXIT, 0)
                RETURN 0
            ENDIF

            IF wParam = VK_F2 THEN
                bSkipChar = TRUE
                selStart = SendMessageA(HWND, SCI_GETCURRENTPOS, 0, 0)
                caretLine = SendMessageA(HWND, SCI_LINEFROMPOSITION, selStart, 0)
                INT totLines = SendMessageA(HWND, SCI_GETLINECOUNT, 0, 0)

                IF isCtrlDown THEN
                    ToggleBookmark(caretLine)
                    UpdateGutter()
                    RETURN 0
                ELSEIF GetKeyState(VK_SHIFT) & 0x8000 THEN
                    GotoPrevBookmark(caretLine, totLines)
                    RETURN 0
                ELSE
                    GotoNextBookmark(caretLine, totLines)
                    RETURN 0
                ENDIF
            ENDIF

            IF wParam = 0x72 THEN                    ' VK_F3
                bSkipChar = TRUE
                IF GetKeyState(VK_SHIFT) & 0x8000 THEN
                    FindAgain(TRUE)
                ELSE
                    FindAgain(FALSE)
                ENDIF
                RETURN 0
            ENDIF

            IF isCtrlDown THEN
                SELECT wParam
                    CASE 0x46 ' Ctrl+F
                        bSkipChar = TRUE
                        Show_Find(WIN, HWND, FALSE)
                        RETURN 0

                    CASE 0x48 ' Ctrl+H
                        bSkipChar = TRUE
                        Show_Find(WIN, HWND, TRUE)
                        RETURN 0
                ENDSELECT
            ENDIF

        Case WM_CHAR
            ' Suppress character generation from any shortcut handled in WM_KEYDOWN
            IF bSkipChar THEN
                bSkipChar = FALSE
                RETURN 0
            ENDIF

            ' Block unhandled Ctrl+Key ASCII control characters (0-31) from reaching Scintilla
            IF isCtrlDown AND wParam < 32 THEN
                RETURN 0
            ENDIF

        Case WM_UNICHAR
            IF bSkipChar THEN
                bSkipChar = FALSE
                RETURN 0
            ENDIF
    EndSelect

    res = CallWindowProcA(ORIG, HWND, uMsg, wParam, lParam)

    IF uMsg = WM_CHAR OR uMsg = WM_KEYDOWN OR uMsg = WM_VSCROLL OR uMsg = WM_HSCROLL OR uMsg = WM_MOUSEWHEEL OR uMsg = WM_LBUTTONUP THEN
        PostMessageA(WIN.hwnd, 32800, 0, 0)
    ENDIF

    RETURN res
ENDSUB

SUB ShowEditContextMenu(INT lp)
    INT x = lp & 0xFFFF
    INT y = (lp >> 16) & 0xFFFF
    IF x > 32767 THEN x = x - 65536
    IF y > 32767 THEN y = y - 65536

    ' Keyboard invocation (Shift+F10 / Menu key) sends -1,-1: pop up at the caret
    IF x = -1 AND y = -1 THEN
        INT pos = SendMessageA(g_hSciCtrl, SCI_GETCURRENTPOS, 0, 0)
        POINT pt
        pt.x = SendMessageA(g_hSciCtrl, 2164, pos, 0)      ' SCI_POINTXFROMPOSITION
        pt.y = SendMessageA(g_hSciCtrl, 2165, pos, 0) + SendMessageA(g_hSciCtrl, SCI_TEXTHEIGHT, 0, 0)
        ClientToScreen(g_hSciCtrl, &pt)
        x = pt.x : y = pt.y
    ENDIF

    INT selEmpty = SendMessageA(g_hSciCtrl, 2650, 0, 0)    ' SCI_GETSELECTIONEMPTY
    INT canUndo  = SendMessageA(g_hSciCtrl, SCI_CANUNDO, 0, 0)
    INT canRedo  = SendMessageA(g_hSciCtrl, SCI_CANREDO, 0, 0)
    INT canPaste = SendMessageA(g_hSciCtrl, 2173, 0, 0)    ' SCI_CANPASTE

    INT fUndo = 1 : IF canUndo <> 0 THEN fUndo = 0         ' 1 = MF_GRAYED
    INT fRedo = 1 : IF canRedo <> 0 THEN fRedo = 0
    INT fSel  = 0 : IF selEmpty <> 0 THEN fSel = 1
    INT fPaste = 1 : IF canPaste <> 0 THEN fPaste = 0

    UINT hPop = CreatePopupMenu()
    IF hPop = 0 THEN RETURN

    AppendMenuA(hPop, fUndo,  CMD_UNDO,      "&Undo" + CHR$(9) + "Ctrl+Z")
    AppendMenuA(hPop, fRedo,  CMD_REDO,      "&Redo" + CHR$(9) + "Ctrl+Y")
    AppendMenuA(hPop, 0x800,  0,             NULL)         ' separator
    AppendMenuA(hPop, fSel,   CMD_CUT,       "Cu&t" + CHR$(9) + "Ctrl+X")
    AppendMenuA(hPop, fSel,   CMD_COPY,      "&Copy" + CHR$(9) + "Ctrl+C")
    AppendMenuA(hPop, fPaste, CMD_PASTE,     "&Paste" + CHR$(9) + "Ctrl+V")
    AppendMenuA(hPop, 0x800,  0,             NULL)
    AppendMenuA(hPop, 0,      CMD_SELECTALL, "Select &All" + CHR$(9) + "Ctrl+A")

    g_WndMenu.SkinPopup(hPop)
    TrackPopupMenu(hPop, TPM_LEFTALIGN | TPM_RIGHTBUTTON, x, y, 0, WIN.hwnd, NULL)
    DestroyMenu(hPop)
ENDSUB

SUB Edit_Scroll_2bottom()
    INT lcount, chrIndex
    lcount = 0
    lcount = SendMessageA(g_hSciCtrl, SCI_GETLINECOUNT, 0, 0) - 1
    chrIndex = 0
    chrIndex = SendMessageA(g_hSciCtrl, SCI_POSITIONFROMLINE, lcount, 0)
    SendMessageA(g_hSciCtrl, SCI_SETSEL, chrIndex, chrIndex)
    SendMessageA(g_hSciCtrl, SCI_SCROLLCARET, 0, 0)
    UpdateGutter()
    SetFocusA(g_hSciCtrl)
EndSub

SUB Edit_Scroll_2Top()
    SendMessageA(g_hSciCtrl, SCI_SETSEL, 0, 0)
    SendMessageA(g_hSciCtrl, SCI_SCROLLCARET, 0, 0)
    UpdateGutter()
    SetFocusA(g_hSciCtrl)
EndSub

SUB Edit_Scroll_2Line()
    INT lcount, chrIndex
    lcount = VAL(GETCONTROLTEXT WIN, 101) - 1
    chrIndex = 0
    chrIndex = SendMessageA(g_hSciCtrl, SCI_POSITIONFROMLINE, lcount, 0)
    SendMessageA(g_hSciCtrl, SCI_SETSEL, chrIndex, chrIndex)
    SendMessageA(g_hSciCtrl, SCI_SCROLLCARET, 0, 0)
    UpdateGutter()
    SetFocusA(g_hSciCtrl)
EndSub

': ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
': Check, Toggle, Clear, and Navigate Bookmarks
': ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
SUB IsLineBookmarked(INT lineIdx), INT
    IF lineIdx < 0 OR lineIdx >= MAX_BOOKMARK_LINES THEN RETURN FALSE
    INT dwordIdx = lineIdx / 32
    INT bitIdx   = lineIdx % 32
    IF (g_BookmarkMask[dwordIdx] & (1 << bitIdx)) THEN
        RETURN TRUE
    ENDIF
    RETURN FALSE
ENDSUB

SUB ToggleBookmark(INT lineIdx)
    IF lineIdx < 0 OR lineIdx >= MAX_BOOKMARK_LINES THEN RETURN
    INT dwordIdx = lineIdx / 32
    INT bitIdx   = lineIdx % 32
    g_BookmarkMask[dwordIdx] = g_BookmarkMask[dwordIdx] || (1 << bitIdx)
    SetFocusA(g_hSciCtrl)
ENDSUB

SUB ClearAllBookmarks()
    INT i
    FOR i = 0 TO 2047
        g_BookmarkMask[i] = 0
    NEXT i
    SetFocusA(g_hSciCtrl)
ENDSUB

SUB GotoNextBookmark(INT currentLine, INT totalLines)
    IF totalLines <= 0 THEN RETURN
    INT searchLine = currentLine + 1
    INT count = 0

    WHILE count < totalLines
        IF searchLine >= totalLines THEN searchLine = 0
        IF IsLineBookmarked(searchLine) THEN
            INT charIdx = 0
            charIdx = SendMessageA(g_hSciCtrl, SCI_POSITIONFROMLINE, searchLine, 0)
            SendMessageA(g_hSciCtrl, SCI_SETSEL, charIdx, charIdx)
            SendMessageA(g_hSciCtrl, SCI_SCROLLCARET, 0, 0)
            UpdateGutter()
            SetFocusA(g_hSciCtrl)
            RETURN
        ENDIF
        searchLine++
        count++
    WEND
ENDSUB

SUB GotoPrevBookmark(INT currentLine, INT totalLines)
    IF totalLines <= 0 THEN RETURN
    INT searchLine = currentLine - 1
    INT count = 0

    WHILE count < totalLines
        IF searchLine < 0 THEN searchLine = totalLines - 1
        IF IsLineBookmarked(searchLine) THEN
            INT charIdx = 0
            charIdx = SendMessageA(g_hSciCtrl, SCI_POSITIONFROMLINE, searchLine, 0)
            SendMessageA(g_hSciCtrl, SCI_SETSEL, charIdx, charIdx)
            SendMessageA(g_hSciCtrl, SCI_SCROLLCARET, 0, 0)
            UpdateGutter()
            SetFocusA(g_hSciCtrl)
            RETURN
        ENDIF
        searchLine--
        count++
    WEND
ENDSUB

': ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
': Visual-Line-Driven Gutter Rendering
': ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
SUB UpdateGutter()
IF IsIconic(WIN.hwnd) <> 0 THEN RETURN
    INT totalH, posW
    GETCLIENTSIZE W1, posL, posT, posW, totalH
    IF totalH <= 0 OR posW <= 0 THEN RETURN
    INT posH = totalH

    Gutter_hDC = GetDC(W1.HWND)
    IF Gutter_hDC = 0 THEN RETURN

    IF EnsureGutterCache(posW, posH, Gutter_hDC) = FALSE THEN
        ReleaseDC(W1.HWND, Gutter_hDC)
        RETURN
    ENDIF

    INT hdcG = g_hGutDC
    POINTER pBits = g_pGutBits
    INT stride = posW * 4

    WINRECT rcGutter
    rcGutter.left = 0 : rcGutter.top = 0 : rcGutter.right = posW : rcGutter.bottom = posH

    IF g_hbrGutter <> 0 THEN
        FillRect(hdcG, &rcGutter, g_hbrGutter)
        GdiFlush()
    ELSE
        BGRA_FillVerticalGradient(pBits, posW, posH, stride, 0x00F4F2F4, 0x00D0CCD0)
    ENDIF

    IF g_IsResizing = TRUE OR g_hSciCtrl = 0 THEN
        BitBlt(Gutter_hDC, 0, 0, posW, posH, hdcG, 0, 0, SRCCOPY)
        ReleaseDC(W1.HWND, Gutter_hDC)
        RETURN
    ENDIF

    INT visLineHeight = SendMessageA(g_hSciCtrl, SCI_TEXTHEIGHT, 0, 0)
    IF visLineHeight <= 0 THEN visLineHeight = 15

    INT firstVisLine  = SendMessageA(g_hSciCtrl, SCI_GETFIRSTVISIBLELINE, 0, 0)
    INT linesOnScreen = SendMessageA(g_hSciCtrl, SCI_LINESONSCREEN, 0, 0)

    INT selStart = SendMessageA(g_hSciCtrl, SCI_GETCURRENTPOS, 0, 0)
    INT currentCaretLine = SendMessageA(g_hSciCtrl, SCI_LINEFROMPOSITION, selStart, 0)

    SetBkMode(hdcG, TRANSPARENT)
    SetTextAlign(hdcG, TA_TOP | TA_RIGHT)

    INT numRightBoundary = posW - DpiPx(8)
    IF numRightBoundary < 3 THEN numRightBoundary = 3

    POINT flagPts[3]

    INT yPos = 0
    INT visIndex = 0
    INT currentVisLine = 0
    INT docLine = -1
    INT prevDocLine = -1
    INT totalDocLines = SendMessageA(g_hSciCtrl, SCI_GETLINECOUNT, 0, 0)

    FOR visIndex = 0 TO linesOnScreen
        currentVisLine = firstVisLine + visIndex
        docLine = SendMessageA(g_hSciCtrl, SCI_DOCLINEFROMVISIBLE, currentVisLine, 0)

        IF docLine < 0 OR docLine >= totalDocLines THEN BREAK

        IF docLine = currentCaretLine THEN
            POINTER pHighlightRow = NULL
            INT rowIdx
            FOR rowIdx = 0 TO visLineHeight - 1
                IF (yPos + rowIdx) < posH THEN
                    pHighlightRow = pBits + ((yPos + rowIdx) * stride)
                    SSE2_BlendHighlightRow(pHighlightRow, posW - 2, 0xFFFFFF00)
                ENDIF
            NEXT rowIdx
        ENDIF

        IF docLine <> prevDocLine THEN
            temp$ = LTrim$(Str$(docLine + 1))

            IF IsLineBookmarked(docLine) THEN
                INT poleX  = DpiPx(4)
                INT topY   = yPos + 1
                INT botY   = yPos + visLineHeight - 2
                INT flagH  = (visLineHeight / 2) + 1
                INT flagW  = DpiPx(6)

                INT hOldLoopPen = SelectObject(hdcG, g_hGutPolePen)
                MoveToEx(hdcG, poleX, topY, NULL)
                API_LineTo(hdcG, poleX, botY + 1)

                SelectObject(hdcG, g_hGutFlagPen)
                INT hOldLoopBrush = SelectObject(hdcG, g_hGutFlagBrush)

                flagPts[0].x = poleX + 1     : flagPts[0].y = topY
                flagPts[1].x = poleX + flagW : flagPts[1].y = topY + (flagH / 2)
                flagPts[2].x = poleX + 1     : flagPts[2].y = topY + flagH

                Polygon(hdcG, &flagPts[0], 3)

                SelectObject(hdcG, hOldLoopBrush)
                SelectObject(hdcG, hOldLoopPen)
            ENDIF

            IF docLine = currentCaretLine THEN
                SetTextColor(hdcG, RGB(0, 128, 0))
            ELSE
                SetTextColor(hdcG, RGB(90, 90, 100))
            ENDIF

            TextOut(hdcG, numRightBoundary, yPos, temp$, Len(temp$))
            prevDocLine = docLine
        ENDIF

        yPos += visLineHeight
        IF yPos >= posH THEN BREAK
    NEXT visIndex

    BitBlt(Gutter_hDC, 0, 0, posW, posH, hdcG, 0, 0, SRCCOPY)
    GdiFlush()
    ReleaseDC(W1.HWND, Gutter_hDC)
ENDSUB

' Paints a gradient below the toolbar strip
SUB DrawTBGradient()
GetClientSize WIN, posLEFT, posTOP, posWIDTH, posHEIGHT
INT hdcWin = GETHDC(WIN)

IF hdcWin <> 0 THEN
    INT stripH = g_ToolbarH + 2

    WINRECT ETO, rcStrip

    ' 1. Fill everything below the strip directly (mostly hidden by children anyway)
    ETO.left = 0 : ETO.top = stripH : ETO.right = posWIDTH : ETO.bottom = posHEIGHT
    IF hbrBackground <> 0 THEN
        FillRect(hdcWin, &ETO, hbrBackground)
    ELSE
        FillRect(hdcWin, &ETO, GetSysColorBrush(15))
    ENDIF

    ' 2. Compose the strip off-screen
    INT hMem = CreateCompatibleDC(hdcWin)
    INT hBmpBuf = CreateCompatibleBitmap(hdcWin, posWIDTH, stripH)
    INT hOldBuf = SelectObject(hMem, hBmpBuf)

    rcStrip.left = 0 : rcStrip.top = 0 : rcStrip.right = posWIDTH : rcStrip.bottom = stripH
    IF hbrBackground <> 0 THEN
        FillRect(hMem, &rcStrip, hbrBackground)
    ELSE
        FillRect(hMem, &rcStrip, GetSysColorBrush(15))
    ENDIF

    TRIVERTEX vert[2]
    GRADIENT_RECT gRect
    vert[0].x = 0        : vert[0].y = 0  : vert[0].Red = 0xF400 : vert[0].Green = 0xF200 : vert[0].Blue = 0xF400 : vert[0].Alpha = 0
    vert[1].x = posWIDTH : vert[1].y = g_ToolbarH : vert[1].Red = 0xC800 : vert[1].Green = 0xC400 : vert[1].Blue = 0xC800 : vert[1].Alpha = 0
    gRect.UpperLeft = 0 : gRect.LowerRight = 1
    GradientFill(hMem, &vert[0], 2, &gRect, 1, GRADIENT_FILL_RECT_V)

    TRIVERTEX vertHandle[2]
    GRADIENT_RECT gRectHandle
    vertHandle[0].x = 0  : vertHandle[0].y = 0  : vertHandle[0].Red = 0xD800 : vertHandle[0].Green = 0xD000 : vertHandle[0].Blue = _
0xD800 : vertHandle[0].Alpha = 0
    vertHandle[1].x = 10 : vertHandle[1].y = g_ToolbarH : vertHandle[1].Red = 0xA000 : vertHandle[1].Green = 0x9C00 : vertHandle[1].Blue = _
0xA000 : vertHandle[1].Alpha = 0
    gRectHandle.UpperLeft = 0 : gRectHandle.LowerRight = 1
    GradientFill(hMem, &vertHandle[0], 2, &gRectHandle, 1, GRADIENT_FILL_RECT_H)

    INT hPenShadow    = CreatePen(0, 1, RGB(160, 160, 170))
    INT hPenHighlight = CreatePen(0, 1, RGB(255, 255, 255))
    INT hPenBorder    = CreatePen(0, 1, RGB(160, 160, 160))
    INT hOldPen       = SelectObject(hMem, hPenShadow)

    MoveToEx(hMem, 10, 2, NULL)  : API_LineTo(hMem, 10, g_ToolbarH - 2)
    SelectObject(hMem, hPenHighlight)
    MoveToEx(hMem, 11, 2, NULL)  : API_LineTo(hMem, 11, g_ToolbarH - 2)


    SelectObject(hMem, hPenBorder)
    MoveToEx(hMem, 0, 0, NULL)   : API_LineTo(hMem, posWIDTH, 0)
    MoveToEx(hMem, 0, g_ToolbarH, NULL)  : API_LineTo(hMem, posWIDTH, g_ToolbarH)

    SelectObject(hMem, hPenHighlight)
    MoveToEx(hMem, 0, 1, NULL)   : API_LineTo(hMem, posWIDTH, 1)
    MoveToEx(hMem, 0, g_ToolbarH + 1, NULL)  : API_LineTo(hMem, posWIDTH, g_ToolbarH + 1)

    SelectObject(hMem, hOldPen)
    DeleteObject(hPenShadow)
    DeleteObject(hPenHighlight)
    DeleteObject(hPenBorder)

    ' 3. One single copy to the screen
    BitBlt(hdcWin, 0, 0, posWIDTH, stripH, hMem, 0, 0, SRCCOPY)

    SelectObject(hMem, hOldBuf)
    DeleteObject(hBmpBuf)
    DeleteDC(hMem)

    RELEASEHDC(WIN, hdcWin)
ENDIF
ENDSUB

': ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
': DrawRuler
': ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
SUB DrawRuler()
IF IsIconic(WIN.hwnd) <> 0 THEN RETURN
    GETCLIENTSIZE W0, posL, posT, posW, posH
    IF posH <= 0 OR posW <= 0 THEN RETURN

    Ruler_hDC = GetDC(W0.HWND)
    IF Ruler_hDC = 0 THEN RETURN

    rhdcMem = CreateCompatibleDC(Ruler_hDC)
    IF rhdcMem = 0 THEN
        ReleaseDC(W0.HWND, Ruler_hDC)
        RETURN
    ENDIF

    BITMAPINFO bmi
    RtlZeroMemory(&bmi, LEN(bmi))
    bmi.bmiHeader.biSize        = LEN(BITMAPINFOHEADER)
    bmi.bmiHeader.biWidth       = posW
    bmi.bmiHeader.biHeight      = -posH
    bmi.bmiHeader.biPlanes      = 1
    bmi.bmiHeader.biBitCount    = 32
    bmi.bmiHeader.biCompression = 0

    POINTER pBits = NULL
    rhbmMem = CreateDIBSection(Ruler_hDC, &bmi, 0, &pBits, 0, 0)

    IF rhbmMem = 0 THEN
        DeleteDC(rhdcMem)
        ReleaseDC(W0.HWND, Ruler_hDC)
        RETURN
    ENDIF

    roldBmp = SelectObject(rhdcMem, rhbmMem)

    TRIVERTEX vert[2]
    GRADIENT_RECT gRect
    vert[0].x = 0    : vert[0].y = 0    : vert[0].Red = 0xF400 : vert[0].Green = 0xF200 : vert[0].Blue = 0xF400 : vert[0].Alpha = 0
    vert[1].x = posW : vert[1].y = posH : vert[1].Red = 0xD000 : vert[1].Green = 0xCC00 : vert[1].Blue = 0xD000 : vert[1].Alpha = 0
    gRect.UpperLeft = 0 : gRect.LowerRight = 1
    GradientFill(rhdcMem, &vert[0], 2, &gRect, 1, GRADIENT_FILL_RECT_V)

    INT oldPen = SelectObject(rhdcMem, g_hRulerSepPen)
    MoveToEx(rhdcMem, 0, posH - 1, NULL)
    API_LineTo(rhdcMem, posW, posH - 1)

    IF g_IsResizing = TRUE OR g_hSciCtrl = 0 THEN
        BitBlt(Ruler_hDC, 0, 0, posW, posH, rhdcMem, 0, 0, SRCCOPY)
        SelectObject(rhdcMem, oldPen)
        SelectObject(rhdcMem, roldBmp)
        DeleteObject(rhbmMem)
        DeleteDC(rhdcMem)
        ReleaseDC(W0.HWND, Ruler_hDC)
        RETURN
    ENDIF

    IF g_hRulerFont = 0 THEN
        INT fontHeight = -MulDiv(g_App.fontSize, GetDeviceCaps(Ruler_hDC, 90), 72)
        g_hRulerFont = CreateFontA(fontHeight, 0, 0, 0, g_App.fontWeight, 0, 0, 0, _
                                   0, 0, 0, 5, 0, g_App.fontName)
    ENDIF

    roldFont = SelectObject(rhdcMem, g_hRulerFont)

    INT charW = 8
    SIZE charSize
    IF GetTextExtentPoint32A(rhdcMem, "0", 1, &charSize) <> 0 THEN
        charW = charSize.cx
    ENDIF
    IF charW <= 0 THEN charW = 8

    INT leftMargin = SendMessageA(g_hSciCtrl, SCI_GETMARGINLEFT, 0, 0)
    IF leftMargin < DpiPx(12) THEN leftMargin = DpiPx(12)

    INT totalNeededChars = ((posW + HSCROLLPOS) / charW) + 20
    IF totalNeededChars < 100 THEN totalNeededChars = 100

    STRING item1 = "----+----"
    STRING itemDigit
    ISTRING Ruler$[4096]

    Ruler$ = "0"
    INT blockCount = 1

    WHILE LEN(Ruler$) < totalNeededChars
        itemDigit = LTRIM$(STR$(blockCount % 10))
        Ruler$ = Ruler$ + item1 + itemDigit
        blockCount++
    WEND

    IF pBits <> NULL THEN
        INT currentPos    = SendMessageA(g_hSciCtrl, 2008, 0, 0)
        INT currentColumn = SendMessageA(g_hSciCtrl, 2129, currentPos, 0)
        INT tickerX       = gutterW + leftMargin + (currentColumn * charW) - HSCROLLPOS

        IF tickerX >= gutterW AND tickerX < posW THEN
            DWORD yellowHighlight = 0x00FFFF30
            INT pitchBytes        = posW * 4
            INT y                 = 0

            FOR y = 0 TO posH - 1
                POINTER pRowBits = pBits + (y * pitchBytes) + (tickerX * 4)
                SSE2_BlendHighlightRow(pRowBits, charW, yellowHighlight)
            NEXT y
        ENDIF
    ENDIF

    SetTextColor(rhdcMem, RGB(70, 70, 80))
    SetBkMode(rhdcMem, TRANSPARENT)

    INT textX = gutterW + leftMargin - HSCROLLPOS
    TextOut(rhdcMem, textX, 0, Ruler$, LEN(Ruler$))

    WINRECT rcMicroHeader
    rcMicroHeader.left = 0 : rcMicroHeader.top = 0 : rcMicroHeader.right = gutterW : rcMicroHeader.bottom = posH

    IF g_hbrGutter <> 0 THEN
        FillRect(rhdcMem, &rcMicroHeader, g_hbrGutter)
    ELSE
        TRIVERTEX mhVert[2]
        GRADIENT_RECT mhRect
        mhVert[0].x = 0            : mhVert[0].y = 0    : mhVert[0].Red = 0xF400 : mhVert[0].Green = 0xF200 : mhVert[0].Blue = 0xF400 : mhVert[0].Alpha = 0
        mhVert[1].x = gutterW      : mhVert[1].y = posH : mhVert[1].Red = 0xD000 : mhVert[1].Green = 0xCC00 : mhVert[1].Blue = 0xD000 : mhVert[1].Alpha = 0
        mhRect.UpperLeft = 0 : mhRect.LowerRight = 1
        GradientFill(rhdcMem, &mhVert[0], 2, &mhRect, 1, GRADIENT_FILL_RECT_V)
    ENDIF

    SelectObject(rhdcMem, g_hRulerSepPen)
    MoveToEx(rhdcMem, gutterW - 1, 0, NULL)
    API_LineTo(rhdcMem, gutterW - 1, posH)

    POINT flagPts[3]
    SelectObject(rhdcMem, g_hRulerPolePen)
    MoveToEx(rhdcMem, 6, 3, NULL)
    API_LineTo(rhdcMem, 6, 15)

    SelectObject(rhdcMem, g_hRulerFlagPen)
    INT hOldBrush = SelectObject(rhdcMem, g_hRulerFlagBrush)
    flagPts[0].x = 7  : flagPts[0].y = 3
    flagPts[1].x = 13 : flagPts[1].y = 6
    flagPts[2].x = 7  : flagPts[2].y = 9
    Polygon(rhdcMem, &flagPts[0], 3)
    SelectObject(rhdcMem, hOldBrush)

    SelectObject(rhdcMem, g_hRulerArrowPen)
    MoveToEx(rhdcMem, 23, 4, NULL) : API_LineTo(rhdcMem, 19, 8)
    MoveToEx(rhdcMem, 23, 4, NULL) : API_LineTo(rhdcMem, 27, 8)
    MoveToEx(rhdcMem, 23, 4, NULL) : API_LineTo(rhdcMem, 23, 13)

    MoveToEx(rhdcMem, 36, 13, NULL) : API_LineTo(rhdcMem, 32, 9)
    MoveToEx(rhdcMem, 36, 13, NULL) : API_LineTo(rhdcMem, 40, 9)
    MoveToEx(rhdcMem, 36, 4, NULL)  : API_LineTo(rhdcMem, 36, 13)

    SelectObject(rhdcMem, g_hRulerEraserPen)
    SelectObject(rhdcMem, g_hRulerEraserBrush)

    POINT eraserPts[4]
    eraserPts[0].x = 46 : eraserPts[0].y = 11
    eraserPts[1].x = 50 : eraserPts[1].y = 5
    eraserPts[2].x = 55 : eraserPts[2].y = 8
    eraserPts[3].x = 51 : eraserPts[3].y = 14
    Polygon(rhdcMem, &eraserPts[0], 4)

    BitBlt(Ruler_hDC, 0, 0, posW, posH, rhdcMem, 0, 0, SRCCOPY)

    SelectObject(rhdcMem, roldFont)
    SelectObject(rhdcMem, oldPen)
    SelectObject(rhdcMem, roldBmp)

    DeleteObject(rhbmMem)
    DeleteDC(rhdcMem)
    ReleaseDC(W0.HWND, Ruler_hDC)
ENDSUB

': ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
': Status & Auxiliary Utilities
': ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
SUB UpdateStatusBar()
    IF g_hSciCtrl = 0 THEN RETURN

    DWORD selStart = SendMessageA(g_hSciCtrl, SCI_GETCURRENTPOS, 0, 0)
    INT caretPos = selStart
    INT currentLine = SendMessageA(g_hSciCtrl, SCI_LINEFROMPOSITION, caretPos, 0)
    INT lineStartChar = SendMessageA(g_hSciCtrl, SCI_POSITIONFROMLINE, currentLine, 0)
    INT totalLines = SendMessageA(g_hSciCtrl, SCI_GETLINECOUNT, 0, 0)

    INT currentCol = caretPos - lineStartChar + 1
    IF currentCol < 1 THEN currentCol = 1

    ISTRING posBuf[64]
    wsprintfA(&posBuf, "Ln:%d/%d   Col:%d", currentLine + 1, totalLines, currentCol)
    CONTROLCMD WIN, STATUS_1, @SWSETPANETEXT, 0, posBuf

    INT currentByteSize = SendMessageA(g_hSciCtrl, SCI_GETTEXTLENGTH, 0, 0)
    ISTRING sizeStr[32]
    GetReadableFileSize(currentByteSize, &sizeStr)
    CONTROLCMD WIN, STATUS_1, @SWSETPANETEXT, 1, sizeStr

    STRING encStr
    encStr = EncodingName(g_App.encoding)
    CONTROLCMD WIN, STATUS_1, @SWSETPANETEXT, 2, encStr

    ISTRING eolBuf[16]
    IF LEN(g_App.eolMode) > 0 THEN
        lstrcpynA(&eolBuf, g_App.eolMode, 15)
    ELSE
        lstrcpynA(&eolBuf, "CRLF", 15)
    ENDIF
    CONTROLCMD WIN, STATUS_1, @SWSETPANETEXT, 3, eolBuf

    IF (GetKeyStateA(0x14) & 1) THEN
        CONTROLCMD WIN, STATUS_1, @SWSETPANETEXT, 4, "CAP"
    ELSE
        CONTROLCMD WIN, STATUS_1, @SWSETPANETEXT, 4, ""
    ENDIF

    IF (GetKeyStateA(0x90) & 1) THEN
        CONTROLCMD WIN, STATUS_1, @SWSETPANETEXT, 5, "NUM"
    ELSE
        CONTROLCMD WIN, STATUS_1, @SWSETPANETEXT, 5, ""
    ENDIF

    IF g_App.isOverwrite = 1 THEN
        CONTROLCMD WIN, STATUS_1, @SWSETPANETEXT, 6, "OVR"
    ELSE
        CONTROLCMD WIN, STATUS_1, @SWSETPANETEXT, 6, "INS"
    ENDIF

    INT canUndo = SendMessageA(g_hSciCtrl, SCI_CANUNDO, 0, 0)
    INT canRedo = SendMessageA(g_hSciCtrl, SCI_CANREDO, 0, 0)

    ControlCMD WIN, 2000, @TBENABLEBUTTON, CMD_UNDO, canUndo
    ControlCMD WIN, 2000, @TBENABLEBUTTON, CMD_REDO, canRedo

ENDSUB

SUB UpdateTitleBar()
    STRING targetCaption$ = ""

    PathCompactPathExA(&targetCaption$, g_CurrentLoadedPath, 60, 0)' cchMax includes the NUL
    IF g_CurrentLoadedPath <> "" THEN
        IF g_IsDirty THEN
            targetCaption$ = "Tpad - [" + targetCaption$ + " *]"
        ELSE
            targetCaption$ = "Tpad - [" + targetCaption$ + "]"
        ENDIF
    ELSE
        IF g_IsDirty THEN
            targetCaption$ = "Tpad - [No Name *]"
        ELSE
            targetCaption$ = "Tpad - [No Name]"
        ENDIF
    ENDIF

    ControlCMD WIN, 2000, @TBENABLEBUTTON, CMD_SAVE, g_IsDirty

    IF targetCaption$ <> g_CachedCaption$ THEN
        g_CachedCaption$ = targetCaption$
        SETCAPTION WIN, targetCaption$
    ENDIF
ENDSUB

' Debugging routine to send messages to DbgView.exe
SUB Trace(STRING msg$)
    OutputDebugStringA("[Tpad Trace] " + msg$ + "\n")
EndSub

' Shorten a path for the menu: keeps drive + file name, "..." in the middle.
SUB MruCaption(STRING p$, INT maxChars), STRING
    IF p$ = "" OR p$ = "Empty" THEN RETURN p$
    IF LEN(p$) <= maxChars THEN RETURN p$
    ISTRING outBuf[300]
    IF PathCompactPathExA(&outBuf, p$, maxChars + 1, 0) = 0 THEN RETURN p$   ' cchMax includes the NUL
    RETURN outBuf
ENDSUB

SUB mruArray()
    INT b = 0, i = 0, j = 0
    STRING target$ = newName
    IF target$ = "" OR target$ = "Empty" THEN RETURN
    target$ = NormalizePath(target$)
    STRING lt$ = LCASE$(target$)

    FOR i = 0 TO 4
        IF LCASE$(g_App.mru[i]) = lt$ THEN
            FOR j = i TO 1 STEP -1
                g_App.mru[j] = g_App.mru[j - 1]
            NEXT j
            g_App.mru[0] = target$
            b = 1
            BREAK
        ENDIF
    NEXT i

    IF b = 0 THEN
        FOR i = 4 TO 1 STEP -1
            g_App.mru[i] = g_App.mru[i - 1]
        NEXT i
        g_App.mru[0] = target$
    ENDIF
ENDSUB

SUB ClearMRUHistory()
    INT i
    FOR i = 0 TO 4
        g_App.mru[i] = "Empty"
        g_App.mruFlags[i] = @MENUDISABLE
    NEXT i

    INIWrite()
ENDSUB

SUB RemoveMRUItem(INT index)
    IF index < 0 OR index > 4 THEN RETURN

    INT i
    FOR i = index TO 3
        g_App.mru[i] = g_App.mru[i + 1]
    NEXT i

    g_App.mru[4] = "Empty"

    INIWrite()
ENDSUB

SUB BoolStr(INT v), STRING
    IF v <> 0 THEN RETURN "1"
    RETURN "0"
ENDSUB

SUB FlipBool(INT v), INT
    IF v <> 0 THEN RETURN 0
    RETURN 1
ENDSUB

SUB IniBool(STRING s$), INT
    IF VAL(s$) <> 0 THEN RETURN TRUE
    RETURN FALSE
ENDSUB

SUB IsBraceChar(INT c), INT
    IF c = 40 OR c = 41 OR c = 91 OR c = 93 OR c = 123 OR c = 125 THEN RETURN TRUE
    RETURN FALSE
ENDSUB

SUB ApplyEditOptions()
    IF g_hSciCtrl = 0 THEN RETURN
    INT hSci = g_hSciCtrl

    ' Tab key inserts spaces or real tabs. Width and indent unit are kept equal (4).
    IF g_App.tabsAsSpaces <> 0 THEN
        SendMessageA(hSci, 2124, 0, 0)             ' SCI_SETUSETABS = FALSE
    ELSE
        SendMessageA(hSci, 2124, 1, 0)
    ENDIF
    SendMessageA(hSci, 2036, 4, 0)                 ' SCI_SETTABWIDTH
    SendMessageA(hSci, 2122, 4, 0)                 ' SCI_SETINDENT
    SendMessageA(hSci, 2260, 1, 0)                 ' SCI_SETTABINDENTS: Tab in leading whitespace indents a level
    SendMessageA(hSci, 2262, 1, 0)                 ' SCI_SETBACKSPACEUNINDENTS

    ' Brace highlight styles (must be set after every STYLECLEARALL, hence called from ApplyViewOptions)
    IF g_App.themeID = 1 THEN
        SendMessageA(hSci, SCI_STYLESETFORE, 34, g_thBraceFg)       ' STYLE_BRACELIGHT
        SendMessageA(hSci, SCI_STYLESETBACK, 34, g_thBraceBg)
        SendMessageA(hSci, SCI_STYLESETFORE, 35, RGB(255, 255, 255))    ' STYLE_BRACEBAD
        SendMessageA(hSci, SCI_STYLESETBACK, 35, g_thBadBg)
    ELSE
        SendMessageA(hSci, SCI_STYLESETFORE, 34, RGB(0, 0, 200))
        SendMessageA(hSci, SCI_STYLESETBACK, 34, RGB(190, 215, 255))
        SendMessageA(hSci, SCI_STYLESETFORE, 35, RGB(255, 255, 255))
        SendMessageA(hSci, SCI_STYLESETBACK, 35, RGB(220, 60, 60))
    ENDIF
    SendMessageA(hSci, SCI_STYLESETBOLD, 34, TRUE)
    SendMessageA(hSci, SCI_STYLESETBOLD, 35, TRUE)

    IF g_App.braceMatch = 0 THEN
        SendMessageA(hSci, 2351, -1, -1)           ' clear any highlight
    ELSE
        UpdateBraceMatch()
    ENDIF

    CHECKMENUITEM WIN, CMD_TABS_SPACES, g_App.tabsAsSpaces
    CHECKMENUITEM WIN, CMD_AUTOINDENT,  g_App.autoIndent
    CHECKMENUITEM WIN, CMD_BRACEMATCH,  g_App.braceMatch
    CHECKMENUITEM WIN, CMD_TRIM_SAVE,   g_App.trimOnSave
    CHECKMENUITEM WIN, CMD_FINAL_NL,    g_App.finalNewline
ENDSUB

SUB ToggleEditOption(INT cmd)
    SELECT cmd
        CASE CMD_TABS_SPACES
            g_App.tabsAsSpaces = FlipBool(g_App.tabsAsSpaces)
        CASE CMD_AUTOINDENT
            g_App.autoIndent = FlipBool(g_App.autoIndent)
        CASE CMD_BRACEMATCH
            g_App.braceMatch = FlipBool(g_App.braceMatch)
        CASE CMD_TRIM_SAVE
            g_App.trimOnSave = FlipBool(g_App.trimOnSave)
        CASE CMD_FINAL_NL
            g_App.finalNewline = FlipBool(g_App.finalNewline)
    ENDSELECT
    ApplyEditOptions()
    IF g_hSciCtrl <> 0 THEN SetFocusA(g_hSciCtrl)
ENDSUB

': Called after Enter: copies the previous line's indentation.
': C/C++: one extra level after a line ending in "{". Python: after a line ending in ":".
SUB HandleAutoIndent()
    IF g_hSciCtrl = 0 THEN RETURN
    IF g_App.autoIndent = 0 THEN RETURN
    INT hSci = g_hSciCtrl

    INT pos = SendMessageA(hSci, SCI_GETCURRENTPOS, 0, 0)
    IF pos < 1 THEN RETURN

    INT c = SendMessageA(hSci, 2007, pos - 1, 0) & 0xFF       ' SCI_GETCHARAT

    ' IWBasic: a space typed after CASE / NEXT / ELSEIF ... re-aligns that line
    IF c = 32 AND g_activeLexer = SCLEX_FREEBASIC THEN
        BasicLiveDedent(hSci, pos)
        RETURN
    ENDIF

    INT eolMode = SendMessageA(hSci, 2030, 0, 0)              ' SCI_GETEOLMODE
    INT isNewLine = FALSE
    IF c = 10 THEN isNewLine = TRUE
    IF c = 13 AND eolMode = 1 THEN isNewLine = TRUE
    IF isNewLine = 0 THEN RETURN

    INT ln = SendMessageA(hSci, 2166, pos, 0)                 ' SCI_LINEFROMPOSITION
    IF ln < 1 THEN RETURN

    INT unit = SendMessageA(hSci, 2123, 0, 0)                 ' SCI_GETINDENT
    IF unit <= 0 THEN unit = 4

    INT ind = 0
    INT pStart = 0
    INT p = 0

    IF g_activeLexer = SCLEX_FREEBASIC THEN
        ind = BasicNextIndent(hSci, ln - 1)
    ELSE
        ind = SendMessageA(hSci, 2127, ln - 1, 0)             ' previous line's indentation

        pStart = SendMessageA(hSci, 2167, ln - 1, 0)
        p = SendMessageA(hSci, 2136, ln - 1, 0)
        WHILE p > pStart
            c = SendMessageA(hSci, 2007, p - 1, 0) & 0xFF
            IF c = 32 OR c = 9 THEN
                p--
            ELSE
                BREAK
            ENDIF
        WEND
        IF p > pStart THEN
            c = SendMessageA(hSci, 2007, p - 1, 0) & 0xFF
            IF g_activeLexer = SCLEX_CPP AND c = 123 THEN ind = ind + unit      ' {
            IF g_activeLexer = SCLEX_PYTHON AND c = 58 THEN ind = ind + unit    ' :
        ENDIF
    ENDIF

    IF ind > 0 THEN
        SendMessageA(hSci, 2126, ln, ind)                     ' SCI_SETLINEINDENTATION
        INT np = SendMessageA(hSci, 2128, ln, 0)              ' SCI_GETLINEINDENTPOSITION
        SendMessageA(hSci, 2025, np, 0)                       ' SCI_GOTOPOS
    ENDIF
ENDSUB

': Highlights the brace before or after the caret and its partner (or flags it as unmatched).
SUB UpdateBraceMatch()
    IF g_hSciCtrl = 0 THEN RETURN
    IF g_App.braceMatch = 0 THEN RETURN
    INT hSci = g_hSciCtrl

    INT pos = SendMessageA(hSci, SCI_GETCURRENTPOS, 0, 0)
    INT bracePos = -1
    INT matchPos = -1
    INT c = 0

    IF pos > 0 THEN
        c = SendMessageA(hSci, 2007, pos - 1, 0) & 0xFF
        IF IsBraceChar(c) THEN bracePos = pos - 1
    ENDIF
    IF bracePos < 0 THEN
        c = SendMessageA(hSci, 2007, pos, 0) & 0xFF
        IF IsBraceChar(c) THEN bracePos = pos
    ENDIF

    IF bracePos >= 0 THEN
        matchPos = SendMessageA(hSci, 2353, bracePos, 0)      ' SCI_BRACEMATCH
        IF matchPos >= 0 THEN
            SendMessageA(hSci, 2351, bracePos, matchPos)      ' SCI_BRACEHIGHLIGHT
        ELSE
            SendMessageA(hSci, 2352, bracePos, 0)             ' SCI_BRACEBADLIGHT
        ENDIF
    ELSE
        SendMessageA(hSci, 2351, -1, -1)
    ENDIF
ENDSUB

': True when an IF line carries code after THEN (single-line IF: no ENDIF).
': pBuf holds the lowercased, comment-stripped, string-blanked line.
SUB BufIsSingleLineIf(POINTER pBuf, INT n), INT
    INT i = 0
    INT j = 0
    INT b = 0
    INT okPrev = 0
    INT okNext = 0

    ' trailing " _" = line continuation: assume a block IF
    IF n >= 2 THEN
        IF (#<BYTE>(pBuf + n - 1) & 0xFF) = 95 AND (#<BYTE>(pBuf + n - 2) & 0xFF) = 32 THEN RETURN FALSE
    ENDIF

    i = 0
    WHILE i <= n - 4
        IF (#<BYTE>(pBuf + i) & 0xFF) = 116 AND (#<BYTE>(pBuf + i + 1) & 0xFF) = 104 AND (#<BYTE>(pBuf + i + 2) & 0xFF) = 101 AND (#<BYTE>(pBuf + i + 3) & 0xFF) = 110 THEN
            okPrev = 1
            IF i > 0 THEN
                b = #<BYTE>(pBuf + i - 1) & 0xFF
                IF (b >= 97 AND b <= 122) OR (b >= 48 AND b <= 57) OR b = 95 THEN okPrev = 0
            ENDIF
            okNext = 1
            IF i + 4 < n THEN
                b = #<BYTE>(pBuf + i + 4) & 0xFF
                IF (b >= 97 AND b <= 122) OR (b >= 48 AND b <= 57) OR b = 95 THEN okNext = 0
            ENDIF
            IF okPrev = 1 AND okNext = 1 THEN
                j = i + 4
                WHILE j < n AND ((#<BYTE>(pBuf + j) & 0xFF) = 32 OR (#<BYTE>(pBuf + j) & 0xFF) = 9)
                    j++
                WEND
                IF j < n THEN RETURN TRUE        ' code after THEN
                RETURN FALSE                     ' THEN ends the line: block IF
            ENDIF
        ENDIF
        i++
    WEND
    RETURN FALSE                                 ' no THEN at all: block IF
ENDSUB

': Classifies one line. Returns role * 100 + family.
':   role: 0 none, 1 opens a block, 2 closes it, 3 middle (ELSE / CASE / MENUTITLE ...)
SUB BasicClassifyLine(INT hSci, INT ln, POINTER pBuf), INT
    g_BlWordLen = 0
    g_BlTextLen = 0

    INT lnStart = SendMessageA(hSci, 2167, ln, 0)         ' SCI_POSITIONFROMLINE
    INT lnEnd   = SendMessageA(hSci, 2136, ln, 0)         ' SCI_GETLINEENDPOSITION
    INT n = lnEnd - lnStart
    IF n <= 0 THEN RETURN 0
    IF n > 400 THEN n = 400

    INT i = 0
    INT b = 0
    INT o = 0
    INT inQuote = 0

    ' copy the line: lowercase, no leading blanks, string contents blanked, comment cut off
    WHILE i < n
        b = SendMessageA(hSci, 2007, lnStart + i, 0) & 0xFF

        IF b = 34 THEN
            IF inQuote = 0 THEN
                inQuote = 1
            ELSE
                inQuote = 0
            ENDIF
        ENDIF

        IF inQuote = 0 AND b = 39 THEN BREAK              ' ' starts a comment

        IF o > 0 OR (b <> 32 AND b <> 9) THEN
            IF inQuote = 1 AND b <> 34 THEN b = 126
            IF b >= 65 AND b <= 90 THEN b = b + 32
            #<BYTE>(pBuf + o) = b
            o++
        ENDIF
        i++
    WEND

    ' trim trailing blanks
    WHILE o > 0 AND ((#<BYTE>(pBuf + o - 1) & 0xFF) = 32 OR (#<BYTE>(pBuf + o - 1) & 0xFF) = 9)
        o--
    WEND
    #<BYTE>(pBuf + o) = 0
    g_BlTextLen = o
    IF o = 0 THEN RETURN 0

    ' first word
    STRING w$ = ""
    INT w = 0
    WHILE w < o AND w < 20
        b = #<BYTE>(pBuf + w) & 0xFF
        IF (b >= 97 AND b <= 122) OR (b >= 48 AND b <= 57) OR b = 95 THEN
            w$ = w$ + CHR$(b)
            w++
        ELSE
            BREAK
        ENDIF
    WEND
    g_BlWordLen = w
    IF w = 0 THEN RETURN 0

    INT role = 0
    INT fam = 0

    SELECT w$
        CASE "if"
            IF BufIsSingleLineIf(pBuf, o) = 0 THEN
                role = 1 : fam = BFAM_IF
            ENDIF
        CASE "elseif"
            IF BufIsSingleLineIf(pBuf, o) = 0 THEN
                role = 3 : fam = BFAM_IF
            ENDIF
        CASE "else"
            IF w >= o THEN
                role = 3 : fam = BFAM_IF           ' bare ELSE only
            ENDIF
        CASE "endif"
            role = 2 : fam = BFAM_IF
        CASE "for"
            role = 1 : fam = BFAM_FOR
        CASE "next"
            role = 2 : fam = BFAM_FOR
        CASE "while"
            role = 1 : fam = BFAM_WHILE
        CASE "wend"
        CASE& "endwhile"
            role = 2 : fam = BFAM_WHILE
        CASE "do"
            role = 1 : fam = BFAM_DO
        CASE "loop"
            role = 2 : fam = BFAM_DO
        CASE "select"
            role = 1 : fam = BFAM_SELECT
        CASE "case"
        CASE& "default"
            role = 3 : fam = BFAM_SELECT
        CASE "endselect"
            role = 2 : fam = BFAM_SELECT
        CASE "sub"
            role = 1 : fam = BFAM_SUB
        CASE "endsub"
            role = 2 : fam = BFAM_SUB
        CASE "type"
            role = 1 : fam = BFAM_TYPE
        CASE "endtype"
            role = 2 : fam = BFAM_TYPE
        CASE "enum"
            role = 1 : fam = BFAM_ENUM
        CASE "endenum"
            role = 2 : fam = BFAM_ENUM
        CASE "class"
            role = 1 : fam = BFAM_CLASS
        CASE "endclass"
            role = 2 : fam = BFAM_CLASS
        CASE "beginmenu"
            role = 1 : fam = BFAM_MENU
        CASE "menutitle"
            role = 3 : fam = BFAM_MENU
        CASE "endmenu"
            role = 2 : fam = BFAM_MENU
        CASE "beginpopup"
            role = 1 : fam = BFAM_POPUP
        CASE "endpopup"
            role = 2 : fam = BFAM_POPUP
        CASE "datasection"
            role = 1 : fam = BFAM_DATA
        CASE "enddatasection"
            role = 2 : fam = BFAM_DATA
    ENDSELECT

    RETURN (role * 100) + fam
ENDSUB

': Scans upward for the line that opened the block of family fam.
': Same-family nesting is counted; other families nest properly and are ignored.
': Returns that line's indentation, or -1 when not found.
SUB BasicFindOpener(INT hSci, INT fromLn, INT fam, POINTER pBuf), INT
    INT depth = 0
    INT ln = fromLn - 1
    INT stopLn = fromLn - 4000
    IF stopLn < 0 THEN stopLn = 0
    INT info = 0
    INT f = 0
    INT r = 0

    WHILE ln >= stopLn
        info = BasicClassifyLine(hSci, ln, pBuf)
        f = info % 100
        IF f = fam THEN
            r = info / 100
            IF r = 2 THEN
                depth++
            ELSEIF r = 1 THEN
                IF depth = 0 THEN RETURN SendMessageA(hSci, 2127, ln, 0)   ' SCI_GETLINEINDENTATION
                depth--
            ENDIF
        ENDIF
        ln--
    WEND
    RETURN -1
ENDSUB

' Collect routines of the current document into g_rtnName / g_rtnLine. Returns the count.
SUB RoutineScan(), INT
    g_rtnCount = 0
    INT hSci = g_hSciCtrl
    IF hSci = 0 THEN RETURN 0
    INT lex = g_activeLexer
    IF lex <> SCLEX_FREEBASIC AND lex <> SCLEX_CPP AND lex <> SCLEX_PYTHON AND lex <> SCLEX_LUA THEN
        IF lex <> SCLEX_PERL AND lex <> SCLEX_BATCH AND lex <> SCLEX_ASM AND lex <> SCLEX_MAKEFILE THEN RETURN 0
    ENDIF

    ISTRING buf[512]
    POINTER pb = &buf
    STRING full$, lt$, nm$, low$
    INT nLines = SendMessageA(hSci, 2154, 0, 0)               ' SCI_GETLINECOUNT
    INT ln, n, o, i, c, ns, e, s, q, semi, eq, stopCol, labelMode, bad

    FOR ln = 0 TO nLines - 1
        IF g_rtnCount < RTN_MAX THEN
        IF SendMessageA(hSci, 2350, ln, 0) <= 500 THEN         ' SCI_LINELENGTH: skip monster lines
            n = SendMessageA(hSci, 2153, ln, &buf)             ' SCI_GETLINE
            #<BYTE>(pb + n) = 0
            FOR i = 0 TO n - 1                                 ' tabs -> blanks
                IF (#<BYTE>(pb + i) & 0xFF) = 9 THEN #<BYTE>(pb + i) = 32
            NEXT i

            o = 0
            WHILE o < n AND (#<BYTE>(pb + o) & 0xFF) = 32
                o++
            WEND
            full$ = buf
            lt$   = LCASE$(MID$(full$, o + 1, 16))
            ns = -1 : stopCol = 0 : labelMode = 0 : nm$ = ""
            c = #<BYTE>(pb + o) & 0xFF

            SELECT lex
                CASE SCLEX_FREEBASIC
                    IF LEFT$(lt$, 4) = "sub " THEN
                        ns = 4
                    ELSEIF LEFT$(lt$, 9) = "function " THEN
                        ns = 9
                    ENDIF
                CASE SCLEX_PYTHON
                    stopCol = 1
                    IF LEFT$(lt$, 4) = "def " THEN
                        ns = 4
                    ELSEIF LEFT$(lt$, 6) = "class " THEN
                        ns = 6
                    ELSEIF LEFT$(lt$, 10) = "async def " THEN
                        ns = 10
                    ENDIF
                CASE SCLEX_LUA
                    IF LEFT$(lt$, 9) = "function " THEN
                        ns = 9
                    ELSEIF LEFT$(lt$, 15) = "local function " THEN
                        ns = 15
                    ENDIF
                CASE SCLEX_PERL
                    IF LEFT$(lt$, 4) = "sub " THEN ns = 4
                CASE SCLEX_BATCH
                    IF o = 0 AND c = 58 THEN                   ' ":label" (not "::" comments)
                        IF (#<BYTE>(pb + 1) & 0xFF) <> 58 THEN
                            ns = 1 : stopCol = 1
                        ENDIF
                    ENDIF
                CASE SCLEX_ASM
                    IF o = 0 AND c > 32 THEN labelMode = 1     ' handled below
                CASE SCLEX_MAKEFILE
                    IF o = 0 AND c > 32 THEN labelMode = 1
                CASE SCLEX_CPP
                    IF o = 0 AND ((c >= 65 AND c <= 90) OR (c >= 97 AND c <= 122) OR c = 95) THEN labelMode = 2
            ENDSELECT

            IF ns >= 0 THEN                                    ' keyword languages: name follows the keyword
                i = o + ns
                WHILE i < n AND (#<BYTE>(pb + i) & 0xFF) = 32
                    i++
                WEND
                e = i
                bad = 0
                WHILE e < n AND bad = 0
                    c = #<BYTE>(pb + e) & 0xFF
                    IF c = 32 OR c = 40 OR c = 44 OR c = 13 OR c = 10 OR c = 59 OR c = 123 THEN
                        bad = 1
                    ELSEIF c = 58 AND stopCol = 1 THEN
                        bad = 1
                    ELSE
                        e++
                    ENDIF
                WEND
                IF e > i THEN nm$ = MID$(full$, i + 1, e - i)

            ELSEIF labelMode = 1 THEN                          ' Asm label / Makefile target:  name:
                e = 0
                bad = 0
                WHILE e < n AND bad = 0
                    c = #<BYTE>(pb + e) & 0xFF
                    IF c = 58 THEN
                        bad = 1
                    ELSEIF c <= 32 OR c = 61 OR c = 59 OR c = 35 THEN
                        bad = 2                                ' blank, '=', ';' or '#' before ':' : not a label
                    ELSE
                        e++
                    ENDIF
                WEND
                IF bad = 1 AND e > 0 THEN
                    IF (#<BYTE>(pb + e + 1) & 0xFF) <> 61 THEN ' "name:=" is a variable
                        nm$ = LEFT$(full$, e)
                        IF lex = SCLEX_MAKEFILE THEN
                            IF LEFT$(nm$, 1) = "." OR INSTR(nm$, "%") > 0 OR INSTR(nm$, "$") > 0 THEN nm$ = ""
                        ENDIF
                    ENDIF
                ENDIF

            ELSEIF labelMode = 2 THEN                          ' C/C++ : column-0 line "type name(args)" without ';'
                q = -1 : semi = 0 : eq = 0
                FOR i = 0 TO n - 1
                    c = #<BYTE>(pb + i) & 0xFF
                    IF c = 40 AND q < 0 THEN q = i
                    IF c = 59 THEN semi = 1
                    IF c = 61 AND q < 0 THEN eq = 1
                NEXT i
                IF q > 0 AND semi = 0 AND eq = 0 THEN
                    e = q
                    WHILE e > 0 AND (#<BYTE>(pb + e - 1) & 0xFF) = 32
                        e--
                    WEND
                    s = e
                    bad = 0
                    WHILE s > 0 AND bad = 0
                        c = #<BYTE>(pb + s - 1) & 0xFF
                        IF (c >= 48 AND c <= 57) OR (c >= 65 AND c <= 90) OR (c >= 97 AND c <= 122) OR c = 95 OR c = 58 OR c = 126 THEN
                            s--
                        ELSE
                            bad = 1
                        ENDIF
                    WEND
                    IF e > s THEN
                        nm$ = MID$(full$, s + 1, e - s)
                        low$ = LCASE$(nm$)
                        IF low$ = "if" OR low$ = "for" OR low$ = "while" OR low$ = "switch" OR low$ = "return" OR low$ = "else" OR low$ = "sizeof" OR low$ = "catch" OR low$ = "defined" THEN nm$ = ""
                        IF LEFT$(lt$, 8) = "typedef " OR LEFT$(lt$, 6) = "using " THEN nm$ = ""
                    ENDIF
                ENDIF
            ENDIF

            IF nm$ <> "" THEN
                g_rtnName[g_rtnCount] = LEFT$(nm$, 60)
                g_rtnLine[g_rtnCount] = ln
                g_rtnCount++
            ENDIF
        ENDIF
        ENDIF
    NEXT ln
    RETURN g_rtnCount
ENDSUB

' Rebuild the Routines popup each time it opens.
SUB BuildRoutinesMenu(INT hRtn)
    INT guard = 0
    WHILE GetMenuItemCount(hRtn) > 0 AND guard < 1000
        DeleteMenu(hRtn, 0, 0x00000400)                        ' MF_BYPOSITION (also frees "More..." submenus)
        guard++
    WEND

    INT n = RoutineScan()
    IF n = 0 THEN
        AppendMenuA(hRtn, 3, CMD_RTN_NONE, "(no routines found)")    ' MF_GRAYED | MF_DISABLED
        g_WndMenu.SkinPopup(hRtn)
        RETURN
    ENDIF

    ' alphabetical order (insertion sort on an index array)
    INT i, j, t, cont
    STRING k$
    FOR i = 0 TO n - 1
        g_rtnOrd[i] = i
    NEXT i
    FOR i = 1 TO n - 1
        t = g_rtnOrd[i]
        k$ = LCASE$(g_rtnName[t])
        j = i - 1
        cont = 1
        WHILE cont = 1
            IF j < 0 THEN
                cont = 0
            ELSEIF LCASE$(g_rtnName[g_rtnOrd[j]]) > k$ THEN
                g_rtnOrd[j + 1] = g_rtnOrd[j]
                j--
            ELSE
                cont = 0
            ENDIF
        WEND
        g_rtnOrd[j + 1] = t
    NEXT i

    INT shown = n
    IF shown > RTN_SHOW THEN shown = RTN_SHOW
    INT pages = (shown + RTN_PAGE - 1) / RTN_PAGE
    INT pg, first, last, idx
    UINT hPg = 0
    UINT hMore = 0

    FOR pg = 0 TO pages - 1
        first = pg * RTN_PAGE
        last  = first + RTN_PAGE - 1
        IF last > shown - 1 THEN last = shown - 1

        IF pg = 0 THEN
            hPg = hRtn
        ELSE
            hPg = CreatePopupMenu()
        ENDIF

        FOR i = first TO last
            idx = g_rtnOrd[i]
            AppendMenuA(hPg, 0, CMD_RTN_BASE + idx, g_rtnName[idx] + CHR$(9) + LTRIM$(STR$(g_rtnLine[idx] + 1)))
        NEXT i

        IF pg = 0 THEN
            IF pages > 1 THEN
                hMore = CreatePopupMenu()
                AppendMenuA(hRtn, 0x00000010, hMore, "More...")           ' MF_POPUP
            ENDIF
        ELSE
            AppendMenuA(hMore, 0x00000010, hPg, LEFT$(g_rtnName[g_rtnOrd[first]], 14) + " - " + LEFT$(g_rtnName[g_rtnOrd[last]], 14))
        ENDIF
    NEXT pg

    g_WndMenu.SkinPopup(hRtn)                                    ' owner-draw + brushed background, nested pages included
ENDSUB

': Where a closing/middle line belongs: its opener's indent (+1 level for CASE / MENUTITLE).
SUB BasicTargetIndent(INT hSci, INT ln, INT role, INT fam, POINTER pBuf, INT unit), INT
    INT t = BasicFindOpener(hSci, ln, fam, pBuf)
    IF t < 0 THEN RETURN -1
    IF role = 3 AND (fam = BFAM_SELECT OR fam = BFAM_MENU) THEN t = t + unit
    RETURN t
ENDSUB

': Indentation for the line created by Enter, based on the previous line.
': Also straightens the previous line if it was a closer / middle keyword.
SUB BasicNextIndent(INT hSci, INT prevLn), INT
    INT unit = SendMessageA(hSci, 2123, 0, 0)             ' SCI_GETINDENT
    IF unit <= 0 THEN unit = 4
    INT ind = SendMessageA(hSci, 2127, prevLn, 0)

    POINTER pBuf = SafeAllocHeap(512)
    IF pBuf = NULL THEN RETURN ind

    INT info = BasicClassifyLine(hSci, prevLn, pBuf)
    INT role = info / 100
    INT fam = info % 100
    INT target = 0

    IF role = 1 THEN
        ind = ind + unit
    ELSEIF role = 2 OR role = 3 THEN
        target = BasicTargetIndent(hSci, prevLn, role, fam, pBuf, unit)
        IF target >= 0 THEN
            IF target <> ind THEN SendMessageA(hSci, 2126, prevLn, target)   ' SCI_SETLINEINDENTATION
            ind = target
        ENDIF
        IF role = 3 THEN ind = ind + unit
    ENDIF

    SafeFreeHeap(pBuf)
    RETURN ind
ENDSUB

': Typing a space right after CASE / NEXT / ELSEIF / ELSE ... re-aligns that line at once.
SUB BasicLiveDedent(INT hSci, INT pos)
    INT ln = SendMessageA(hSci, 2166, pos, 0)             ' SCI_LINEFROMPOSITION
    IF ln < 1 THEN RETURN
    IF SendMessageA(hSci, 2136, ln, 0) <> pos THEN RETURN ' caret must be at the end of the line

    POINTER pBuf = SafeAllocHeap(512)
    IF pBuf = NULL THEN RETURN

    INT unit = SendMessageA(hSci, 2123, 0, 0)
    IF unit <= 0 THEN unit = 4

    INT info = BasicClassifyLine(hSci, ln, pBuf)
    INT role = info / 100
    INT fam = info % 100
    INT onlyKeyword = 0
    IF g_BlTextLen = g_BlWordLen THEN onlyKeyword = 1     ' read before the scan overwrites them

    IF (role = 2 OR role = 3) AND onlyKeyword = 1 THEN
        INT target = BasicTargetIndent(hSci, ln, role, fam, pBuf, unit)
        IF target >= 0 THEN
            IF target <> SendMessageA(hSci, 2127, ln, 0) THEN SendMessageA(hSci, 2126, ln, target)
        ENDIF
    ENDIF

    SafeFreeHeap(pBuf)
ENDSUB

': Runs just before a save: trims trailing blanks and/or ensures a final line break.
': Works on the document, in one undo step, so the editor and the file stay identical.
SUB PrepareDocumentForSave()
    IF g_hSciCtrl = 0 THEN RETURN
    IF g_App.trimOnSave = 0 AND g_App.finalNewline = 0 THEN RETURN
    INT hSci = g_hSciCtrl

    INT lineCount = 0
    INT ln = 0
    INT lineStart = 0
    INT lineEnd = 0
    INT p = 0
    INT c = 0
    INT docLen = 0
    INT mode = 0
    ISTRING nl[4]

    SendMessageA(hSci, 2078, 0, 0)                            ' SCI_BEGINUNDOACTION

    IF g_App.trimOnSave <> 0 THEN
        lineCount = SendMessageA(hSci, 2154, 0, 0)            ' SCI_GETLINECOUNT
        FOR ln = 0 TO lineCount - 1
            lineStart = SendMessageA(hSci, 2167, ln, 0)
            lineEnd   = SendMessageA(hSci, 2136, ln, 0)
            p = lineEnd
            WHILE p > lineStart
                c = SendMessageA(hSci, 2007, p - 1, 0) & 0xFF
                IF c = 32 OR c = 9 THEN
                    p--
                ELSE
                    BREAK
                ENDIF
            WEND
            IF p < lineEnd THEN
                SendMessageA(hSci, SCI_SETTARGETSTART, p, 0)
                SendMessageA(hSci, SCI_SETTARGETEND, lineEnd, 0)
                SendMessageA(hSci, 2194, 0, &"")              ' SCI_REPLACETARGET with ""
            ENDIF
        NEXT ln
    ENDIF

    IF g_App.finalNewline <> 0 THEN
        docLen = SendMessageA(hSci, 2006, 0, 0)               ' SCI_GETLENGTH
        IF docLen > 0 THEN
            c = SendMessageA(hSci, 2007, docLen - 1, 0) & 0xFF
            IF c <> 10 AND c <> 13 THEN
                mode = SendMessageA(hSci, 2030, 0, 0)
                IF mode = 0 THEN
                    nl = g_CRLF
                    SendMessageA(hSci, 2282, 2, &nl)          ' SCI_APPENDTEXT
                ELSEIF mode = 1 THEN
                    nl = CHR$(13)
                    SendMessageA(hSci, 2282, 1, &nl)
                ELSE
                    nl = CHR$(10)
                    SendMessageA(hSci, 2282, 1, &nl)
                ENDIF
            ENDIF
        ENDIF
    ENDIF

    SendMessageA(hSci, 2079, 0, 0)                            ' SCI_ENDUNDOACTION
ENDSUB

SUB INIRead()
    iniloc = GETSTARTPATH + "Tpad.ini"

    ' ---- defaults (what GetPrivateProfileString used to supply for a missing key)
    INT i
    FOR i = 0 TO 4
        g_App.mru[i] = "Empty"
    NEXT i
    g_App.fontName   = "Consolas"
    g_App.fontSize   = 10
    g_App.fontWeight = 0
    g_App.fontFlags  = 0
    g_App.onTop      = 0
    g_App.wordWrap   = 0
    g_App.themeID    = 0
    g_App.left   = -9999
    g_App.top    = -9999
    g_App.width  = 640
    g_App.height = 480
    g_App.showIndent  = 0
    g_App.showEOL     = 0
    g_App.showWS      = 1
    g_App.showWrapSym = 0
    g_App.tabsAsSpaces = 0
    g_App.autoIndent   = 1
    g_App.braceMatch   = 1
    g_App.trimOnSave   = 0
    g_App.finalNewline = 0

    ' ---- one read of the whole file
    HANDLE hF = CreateFileA(iniloc, 0x80000000, 1, NULL, 3, 0x80, NULL)     ' GENERIC_READ, SHARE_READ, OPEN_EXISTING
    IF hF = -1 THEN RETURN
    INT size = GetFileSize(hF, NULL)
    IF size <= 0 OR size > 65536 THEN
        CloseHandle(hF)
        RETURN
    ENDIF
    POINTER pBuf = SafeAllocHeap(size + 2)
    IF pBuf = NULL THEN
        CloseHandle(hF)
        RETURN
    ENDIF
    DWORD rdBytes = 0
    ReadFile(hF, pBuf, size, &rdBytes, NULL)
    CloseHandle(hF)
    INT total = rdBytes
    #<BYTE>(pBuf + total) = 0

    ' ---- parse line by line
    ISTRING lb[600]
    STRING ln$, sec$, key$, val$
    INT p = 0
    INT ls, le, n, eq, idx

    IF total >= 3 THEN                                                      ' skip a UTF-8 BOM if an editor added one
        IF (#<BYTE>(pBuf) & 0xFF) = 0xEF AND (#<BYTE>(pBuf + 1) & 0xFF) = 0xBB AND (#<BYTE>(pBuf + 2) & 0xFF) = 0xBF THEN p = 3
    ENDIF

    WHILE p < total
        ls = p
        WHILE p < total AND (#<BYTE>(pBuf + p) & 0xFF) <> 10
            p++
        WEND
        le = p
        p++                                                                 ' past the LF
        IF le > ls AND (#<BYTE>(pBuf + le - 1) & 0xFF) = 13 THEN le--       ' drop the CR of CRLF
        n = le - ls
        IF n > 598 THEN n = 598

        IF n > 0 THEN
            lstrcpynA(&lb, pBuf + ls, n + 1)
            ln$ = LTRIM$(lb)

            IF LEFT$(ln$, 1) = "[" THEN
                eq = INSTR(ln$, "]")
                IF eq > 2 THEN sec$ = UCASE$(MID$(ln$, 2, eq - 2)) ELSE sec$ = ""
            ELSEIF LEFT$(ln$, 1) <> ";" THEN
                eq = INSTR(ln$, "=")
                IF eq > 1 THEN
                    key$ = UCASE$(RTRIM$(LEFT$(ln$, eq - 1)))
                    val$ = RTRIM$(LTRIM$(MID$(ln$, eq + 1)))

                    IF sec$ = "FILES" THEN
                        IF LEFT$(key$, 3) = "MRU" THEN
                            idx = VAL(MID$(key$, 4))
                            IF idx >= 0 AND idx <= 4 AND val$ <> "" THEN g_App.mru[idx] = AbsoluteFromApp(val$)
                        ENDIF

                    ELSEIF sec$ = "FONT" THEN
                        IF key$ = "NAME" THEN
                            IF val$ <> "" THEN g_App.fontName = val$
                        ELSEIF key$ = "SIZE" THEN
                            g_App.fontSize = VAL(val$)
                        ELSEIF key$ = "WEIGHT" THEN
                            g_App.fontWeight = VAL(val$)
                        ELSEIF key$ = "FLAGS" THEN
                            g_App.fontFlags = VAL(val$)
                        ENDIF

                    ELSEIF sec$ = "SETTINGS" THEN
                        IF key$ = "ONTOP" THEN
                            g_App.onTop = VAL(val$)
                        ELSEIF key$ = "WORDWRAP" THEN
                            g_App.wordWrap = VAL(val$)
                        ELSEIF key$ = "THEMEID" THEN
                            g_App.themeID = VAL(val$)
                        ENDIF

                    ELSEIF sec$ = "WINDOW" THEN
                        IF key$ = "LEFT" THEN
                            g_App.left = VAL(val$)
                        ELSEIF key$ = "TOP" THEN
                            g_App.top = VAL(val$)
                        ELSEIF key$ = "WIDTH" THEN
                            g_App.width = VAL(val$)
                        ELSEIF key$ = "HEIGHT" THEN
                            g_App.height = VAL(val$)
                        ENDIF

                    ELSEIF sec$ = "SHOW" THEN
                        IF key$ = "INDENT" THEN
                            g_App.showIndent = IniBool(val$)
                        ELSEIF key$ = "EOL" THEN
                            g_App.showEOL = IniBool(val$)
                        ELSEIF key$ = "WS" THEN
                            g_App.showWS = IniBool(val$)
                        ELSEIF key$ = "WRAPSYM" THEN
                            g_App.showWrapSym = IniBool(val$)
                        ENDIF

                    ELSEIF sec$ = "EDIT" THEN
                        IF key$ = "TABSASSPACES" THEN
                            g_App.tabsAsSpaces = IniBool(val$)
                        ELSEIF key$ = "AUTOINDENT" THEN
                            g_App.autoIndent = IniBool(val$)
                        ELSEIF key$ = "BRACEMATCH" THEN
                            g_App.braceMatch = IniBool(val$)
                        ELSEIF key$ = "TRIMONSAVE" THEN
                            g_App.trimOnSave = IniBool(val$)
                        ELSEIF key$ = "FINALNEWLINE" THEN
                            g_App.finalNewline = IniBool(val$)
                        ENDIF

                    ELSEIF sec$ = "TOOLS" THEN
                        idx = VAL(MID$(key$, 5))
                        IF idx >= 0 AND idx < TOOL_MAX THEN
                            IF LEFT$(key$, 4) = "NAME" THEN
                                g_toolName[idx] = val$
                                IF idx >= g_toolCount THEN g_toolCount = idx + 1
                            ELSEIF LEFT$(key$, 4) = "PATH" THEN
                                g_toolPath[idx] = val$
                                IF idx >= g_toolCount THEN g_toolCount = idx + 1
                            ELSEIF LEFT$(key$, 4) = "ARGS" THEN
                                g_toolArgs[idx] = val$
                            ENDIF
                        ENDIF

                    ENDIF
                ENDIF
            ENDIF
        ENDIF
    WEND

    SafeFreeHeap(pBuf)
    IF g_App.themeID < 0 OR g_App.themeID >= THEME_COUNT THEN g_App.themeID = 0
ENDSUB

SUB IniPut(POINTER pBuf, STRING s$)
    lstrcatA(pBuf, s$)
    lstrcatA(pBuf, CHR$(13) + CHR$(10))
ENDSUB

SUB INIWrite()
DWORD t1 = GetTickCount()
    INT i
    iniloc = GETSTARTPATH + "Tpad.ini"
    IF IsIconic(WIN.hwnd) = 0 THEN GETSIZE WIN, g_App.left, g_App.top, g_App.width, g_App.height

    POINTER pBuf = SafeAllocHeap(32768)
    IF pBuf = NULL THEN RETURN
    #<BYTE>pBuf = 0                                   ' lstrcatA must start from an empty string

    IniPut(pBuf, "[Files]")
    FOR i = 0 TO 4
        IniPut(pBuf, "MRU" + LTRIM$(STR$(i)) + "=" + RelativeToApp(g_App.mru[i]))
    NEXT i

    IniPut(pBuf, "")
    IniPut(pBuf, "[Font]")
    IniPut(pBuf, "Name=" + g_App.fontName)
    IniPut(pBuf, "Size=" + LTRIM$(STR$(g_App.fontSize)))
    IniPut(pBuf, "Weight=" + LTRIM$(STR$(g_App.fontWeight)))
    IniPut(pBuf, "Flags=" + LTRIM$(STR$(g_App.fontFlags)))

    IniPut(pBuf, "")
    IniPut(pBuf, "[Settings]")
    IniPut(pBuf, "OnTop=" + LTRIM$(STR$(g_App.onTop)))
    IniPut(pBuf, "WordWrap=" + LTRIM$(STR$(g_App.wordWrap)))
    IniPut(pBuf, "ThemeID=" + LTRIM$(STR$(g_App.themeID)))

    IniPut(pBuf, "")
    IniPut(pBuf, "[Window]")
    IniPut(pBuf, "Left=" + LTRIM$(STR$(g_App.left)))
    IniPut(pBuf, "Top=" + LTRIM$(STR$(g_App.top)))
    IniPut(pBuf, "Width=" + LTRIM$(STR$(g_App.width)))
    IniPut(pBuf, "Height=" + LTRIM$(STR$(g_App.height)))

    IniPut(pBuf, "")
    IniPut(pBuf, "[Show]")
    IniPut(pBuf, "Indent=" + BoolStr(g_App.showIndent))
    IniPut(pBuf, "EOL=" + BoolStr(g_App.showEOL))
    IniPut(pBuf, "WS=" + BoolStr(g_App.showWS))
    IniPut(pBuf, "WrapSym=" + BoolStr(g_App.showWrapSym))

    IniPut(pBuf, "")
    IniPut(pBuf, "[Edit]")
    IniPut(pBuf, "TabsAsSpaces=" + BoolStr(g_App.tabsAsSpaces))
    IniPut(pBuf, "AutoIndent=" + BoolStr(g_App.autoIndent))
    IniPut(pBuf, "BraceMatch=" + BoolStr(g_App.braceMatch))
    IniPut(pBuf, "TrimOnSave=" + BoolStr(g_App.trimOnSave))
    IniPut(pBuf, "FinalNewline=" + BoolStr(g_App.finalNewline))

    IniPut(pBuf, "")
    IniPut(pBuf, "[Tools]")
    FOR i = 0 TO g_toolCount - 1
        IniPut(pBuf, "Name" + LTRIM$(STR$(i)) + "=" + g_toolName[i])
        IniPut(pBuf, "Path" + LTRIM$(STR$(i)) + "=" + g_toolPath[i])
        IniPut(pBuf, "Args" + LTRIM$(STR$(i)) + "=" + g_toolArgs[i])
    NEXT i

    STRING tmp$ = iniloc + ".tmp"
    HANDLE hF = CreateFileA(tmp$, 0x40000000, 0, NULL, 2, 0x80, NULL)      ' GENERIC_WRITE, CREATE_ALWAYS
    IF hF <> -1 THEN
        DWORD wr = 0
        WriteFile(hF, pBuf, lstrlenA(pBuf), &wr, NULL)                     ' the one and only write
        CloseHandle(hF)
        MoveFileExA(tmp$, iniloc, 9)                                       ' REPLACE_EXISTING | WRITE_THROUGH
    ENDIF
    SafeFreeHeap(pBuf)

Trace("INIWrite: " + STR$(GetTickCount() - t1) + " ms")
ENDSUB

SUB DescribeWinError(INT err), STRING
    IF err = -1 THEN RETURN "The file is larger than the 10 MB limit."
    IF err = 2 OR err = 3 THEN RETURN "The file or folder no longer exists."
    IF err = 5 THEN RETURN "Access denied. The file may be protected, in a folder you cannot write to, or blocked by Windows security."
    IF err = 8 THEN RETURN "Not enough memory."
    IF err = 19 THEN RETURN "The disk is write-protected."
    IF err = 21 THEN RETURN "The drive is not ready."
    IF err = 32 THEN RETURN "The file is in use by another program."
    IF err = 33 THEN RETURN "Part of the file is locked by another program."
    IF err = 39 OR err = 112 THEN RETURN "The disk is full."
    IF err = 123 OR err = 161 THEN RETURN "The file name or path is not valid."
    IF err = 206 THEN RETURN "The path is too long."
    IF err = 1117 THEN RETURN "An I/O device error occurred."
    IF err = 1224 THEN RETURN "The file is open in another program in a way that blocks writing."
    RETURN "Windows error " + STR$(err) + "."
ENDSUB

': Case-insensitive match of keyword kw$ at byte offset pos. Returns its length, or 0.
SUB HintMatchAt(POINTER pMem, INT pos, INT limit, STRING kw$), INT
    INT n = LEN(kw$)
    IF pos + n > limit THEN RETURN 0
    INT k = 0
    INT b = 0
    FOR k = 0 TO n - 1
        b = #<BYTE>(pMem + pos + k) & 0xFF
        IF b >= 65 AND b <= 90 THEN b = b + 32
        IF b <> ASC(MID$(kw$, k + 1, 1)) THEN RETURN 0
    NEXT k
    RETURN n
ENDSUB

': Normalised charset name -> code page (65001 = UTF-8, 0 = unknown)
SUB CodePageFromHint(STRING n$), INT
    INT cp = 0
    SELECT n$
        CASE "utf8"
            cp = 65001
        CASE "latin1"
        CASE& "iso88591"
        CASE& "windows1252"
        CASE& "cp1252"
            cp = 1252
        CASE "iso885915"
        CASE& "latin9"
            cp = 28605
        CASE "iso88592"
        CASE& "latin2"
            cp = 28592
        CASE "windows1250"
        CASE& "cp1250"
            cp = 1250
        CASE "windows1251"
        CASE& "cp1251"
            cp = 1251
        CASE "koi8r"
            cp = 20866
        CASE "koi8u"
            cp = 21866
        CASE "iso88595"
            cp = 28595
        CASE "cp866"
        CASE& "ibm866"
            cp = 866
        CASE "windows1253"
        CASE& "cp1253"
            cp = 1253
        CASE "iso88597"
            cp = 28597
        CASE "windows1254"
        CASE& "cp1254"
            cp = 1254
        CASE "iso88599"
        CASE& "latin5"
            cp = 28599
        CASE "windows1255"
        CASE& "cp1255"
            cp = 1255
        CASE "windows1256"
        CASE& "cp1256"
            cp = 1256
        CASE "windows1257"
        CASE& "cp1257"
            cp = 1257
        CASE "windows1258"
        CASE& "cp1258"
            cp = 1258
        CASE "cp874"
        CASE& "windows874"
            cp = 874
        CASE "cp850"
            cp = 850
        CASE "cp437"
            cp = 437
        CASE "cp852"
            cp = 852
        CASE "shiftjis"
        CASE& "sjis"
        CASE& "cp932"
        CASE& "windows31j"
            cp = 932
        CASE "gbk"
        CASE& "gb2312"
        CASE& "cp936"
            cp = 936
        CASE "euckr"
        CASE& "cp949"
            cp = 949
        CASE "big5"
        CASE& "cp950"
            cp = 950
    ENDSELECT
    RETURN cp
ENDSUB

': Scan the head of the file for an encoding declaration.
': Returns 0 = no usable hint, 65001 = UTF-8, otherwise a code page.
SUB DetectCodingHint(POINTER pMem, DWORD fileSize), INT
    IF pMem = NULL OR fileSize < 8 THEN RETURN 0

    INT scanLen = fileSize
    IF scanLen > 4096 THEN scanLen = 4096

    INT i = 0
    INT j = 0
    INT c = 0
    INT prev = 0
    INT kwLen = 0
    INT tokLen = 0
    INT sep = 0
    INT cp = 0
    STRING tok$

    WHILE i < scanLen
        c = #<BYTE>(pMem + i) & 0xFF
        IF c >= 65 AND c <= 90 THEN c = c + 32

        ' keywords start with c, e or f
        IF c = 99 OR c = 101 OR c = 102 THEN
            prev = 32
            IF i > 0 THEN prev = #<BYTE>(pMem + i - 1) & 0xFF

            ' the keyword must not be the tail of a longer word
            IF (prev >= 48 AND prev <= 57) OR (prev >= 65 AND prev <= 90) OR (prev >= 97 AND prev <= 122) OR prev = 95 THEN
                kwLen = 0
            ELSE
                kwLen = HintMatchAt(pMem, i, scanLen, "fileencoding")
                IF kwLen = 0 THEN kwLen = HintMatchAt(pMem, i, scanLen, "charset")
                IF kwLen = 0 THEN kwLen = HintMatchAt(pMem, i, scanLen, "encoding")
                IF kwLen = 0 THEN kwLen = HintMatchAt(pMem, i, scanLen, "coding")
                IF kwLen = 0 THEN kwLen = HintMatchAt(pMem, i, scanLen, "fenc")
            ENDIF

            IF kwLen > 0 THEN
                j = i + kwLen
                sep = 0

                WHILE j < scanLen AND (#<BYTE>(pMem + j) & 0xFF = 32 OR #<BYTE>(pMem + j) & 0xFF = 9)
                    j++
                WEND
                IF j < scanLen THEN
                    c = #<BYTE>(pMem + j) & 0xFF
                    IF c = 58 OR c = 61 THEN          ' ':' or '='
                        sep = 1
                        j++
                        WHILE j < scanLen AND (#<BYTE>(pMem + j) & 0xFF = 32 OR #<BYTE>(pMem + j) & 0xFF = 9)
                            j++
                        WEND
                    ENDIF
                ENDIF
                IF j < scanLen THEN
                    c = #<BYTE>(pMem + j) & 0xFF
                    IF c = 34 OR c = 39 THEN          ' optional quote
                        sep = 1
                        j++
                    ENDIF
                ENDIF

                IF sep = 1 THEN
                    tok$ = ""
                    tokLen = 0
                    WHILE j < scanLen AND tokLen < 32
                        c = #<BYTE>(pMem + j) & 0xFF
                        IF c >= 65 AND c <= 90 THEN c = c + 32
                        IF (c >= 97 AND c <= 122) OR (c >= 48 AND c <= 57) THEN
                            tok$ = tok$ + CHR$(c)
                        ELSEIF c <> 45 AND c <> 95 THEN
                            BREAK
                        ENDIF
                        j++
                        tokLen++
                    WEND

                    cp = CodePageFromHint(tok$)
                    IF cp > 0 THEN RETURN cp
                ENDIF
            ENDIF
        ENDIF
        i++
    WEND
    RETURN 0
ENDSUB

SUB HasHighBytes(POINTER pMem, DWORD fileSize), INT
    DWORD i = 0
    WHILE i < fileSize
        IF (#<BYTE>(pMem + i) & 0x80) <> 0 THEN RETURN TRUE
        i++
    WEND
    RETURN FALSE
ENDSUB

SUB RemoveQuotes(), STRING
    While LEFT$(Cline, 1) = CHR$(34)
        Cline = RIGHT$(Cline, LEN(Cline) - 1)
    Wend
    While RIGHT$(Cline, 1) = CHR$(34)
        Cline = LEFT$(Cline, LEN(Cline) - 1)
    Wend
    RETURN Cline
EndSub

SUB SizeDialogClient(UINT hDlg, INT cw, INT ch)          ' cw/ch in 96-DPI pixels
    WINRECT rcW, rcC
    GetWindowRect(hDlg, &rcW)
    GetClientRect(hDlg, &rcC)
    INT dx = (rcW.right - rcW.left) - rcC.right           ' non-client size
    INT dy = (rcW.bottom - rcW.top) - rcC.bottom
    SetWindowPos(hDlg, 0, 0, 0, DpiPx(cw) + dx, DpiPx(ch) + dy, 0x16)   ' NOMOVE | NOZORDER | NOACTIVATE
ENDSUB

SUB PlaceCtl(UINT hDlg, INT id, INT x, INT y, INT w, INT h)
    SetWindowPos(GetDlgItem(hDlg, id), 0, DpiPx(x), DpiPx(y), DpiPx(w), DpiPx(h), 0x14)
ENDSUB

SUB InitAbout()
    CREATEDIALOG About, 0, 0, DpiPx(280), DpiPx(178), @NOCAPTION, WIN, "About Tpad", &Abouthandler
    CONTROL About, @STATIC, "", 0, 0, DpiPx(280), DpiPx(178), 0x5000000E, About_Banner
    CONTROL About, @BUTTON, "Close", DpiPx(225), DpiPx(5), DpiPx(75), DpiPx(20), 0x5001000B, 1
    CONTROL About, @BUTTON, "Escape Close", 0, 0, 0, 0, 0x40080000, About_Close
ENDSUB

SUB Abouthandler(), INT

    SELECT @MESSAGE

        CASE @IDINITDIALOG
            g_AboutOrig = GetWindowLongA(About.hwnd, GWL_WNDPROC)
            SetWindowLongA(About.hwnd, GWL_WNDPROC, &ColorSubClass)

            SizeDialogClient(About.hwnd, 280, 178)
            PlaceCtl(About.hwnd, About_Banner, 0, 0, 280, 178)
            PlaceCtl(About.hwnd, 1, 225, 5, 50, 20)

            g_hAboutBannerBmp = CreateAboutImage(About.hwnd, DpiPx(280), DpiPx(178))
            UINT hImgCtrl = GetControlHandle(About, About_Banner)
            SendMessageA(hImgCtrl, 0x0172, 0, g_hAboutBannerBmp)    ' STM_SETIMAGE

            InjectUIFont(About.hwnd)
            CENTERWINDOW About

        CASE @IDERASEBACKGROUND
            ' nothing: the bitmap covers the whole client area

        CASE @IDCLOSEWINDOW
            ' Safely clean up this dialog's unique font
            UINT hFnt = GetPropA(About.hwnd, "Tpad_UIFont")
            IF hFnt <> 0 THEN
                RemovePropA(About.hwnd, "Tpad_UIFont")
                DeleteObject(hFnt)
            ENDIF

        CASE @IDCONTROL
            IF @ControlID = 1 OR @ControlID = About_Close THEN
                SendMessage About, WM_CLOSE, 0, 0
            ENDIF

        CASE @IDLBUTTONDN
            DragWindow(About)

    ENDSELECT
    RETURN 0
ENDSUB

': ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
': Composites Top Header Banner into an HBITMAP handle
': ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
SUB CreateAboutImage(UINT hwndDlg, INT width, INT height), UINT
    UINT hdcWin = GetDC(hwndDlg)
    UINT hdcMem = CreateCompatibleDC(hdcWin)
    UINT hBmp   = CreateCompatibleBitmap(hdcWin, width, height)
    UINT hOld   = SelectObject(hdcMem, hBmp)

    WINRECT rc
    rc.left = 0 : rc.top = 0 : rc.right = width : rc.bottom = height

    ' 1. Background
    SetBrushOrgEx(hdcMem, 0, 0, NULL)
    IF g_WndMenu.m_hbrBrushed <> 0 THEN
        FillRect(hdcMem, &rc, g_WndMenu.m_hbrBrushed)
    ELSE
        UINT hbrBg = CreateSolidBrush(RGB(212, 215, 220))
        FillRect(hdcMem, &rc, hbrBg)
        DeleteObject(hbrBg)
    ENDIF

    ' 2. Header (56) and footer (48)
    INT headH = DpiPx(56) : INT footH = DpiPx(48)
    UINT hdcTmp = CreateCompatibleDC(hdcWin)

    UINT hHead = CreateAboutBanner(hwndDlg, width, headH)
    UINT hOldT = SelectObject(hdcTmp, hHead)
    BitBlt(hdcMem, 0, 0, width, headH, hdcTmp, 0, 0, SRCCOPY)
    SelectObject(hdcTmp, hOldT)
    DeleteObject(hHead)

    UINT hFoot = CreateAboutFooter(hwndDlg, width, footH)
    hOldT = SelectObject(hdcTmp, hFoot)
    BitBlt(hdcMem, 0, height - footH, width, footH, hdcTmp, 0, 0, SRCCOPY)
    SelectObject(hdcTmp, hOldT)
    DeleteObject(hFoot)
    DeleteDC(hdcTmp)

    ' 3. Info grid
    SetBkMode(hdcMem, 1)
    UINT hFontL = CreateUIFont(9, 700)
    UINT hFontV = CreateUIFont(9, 400)

    ' Measure the widest label and the widest value
    INT labelW = TextW(hdcMem, hFontL, "Built with")
    INT valueW = TextW(hdcMem, hFontV, "Yannick Dalissier")
    INT w2

    w2 = TextW(hdcMem, hFontL, "Version")   : IF w2 > labelW THEN labelW = w2
    w2 = TextW(hdcMem, hFontL, "Author")    : IF w2 > labelW THEN labelW = w2
    w2 = TextW(hdcMem, hFontL, "Engine")    : IF w2 > labelW THEN labelW = w2
    w2 = TextW(hdcMem, hFontV, APP_VERSION) : IF w2 > valueW THEN valueW = w2
    w2 = TextW(hdcMem, hFontV, "IWBasic 2.5") : IF w2 > valueW THEN valueW = w2
    w2 = TextW(hdcMem, hFontV, "Scintilla") : IF w2 > valueW THEN valueW = w2

    INT gap    = DpiPx(14)
    INT blockW = labelW + gap + valueW
    INT xLabel = (width - blockW) / 2
    INT xValue = xLabel + labelW + gap

    AboutRow(hdcMem, DpiPx(64),  "Version",    APP_VERSION,         xLabel, xValue, width, hFontL, hFontV)
    AboutRow(hdcMem, DpiPx(80),  "Author",     "Yannick Dalissier", xLabel, xValue, width, hFontL, hFontV)
    AboutRow(hdcMem, DpiPx(96),  "Built with", "IWBasic 2.5",       xLabel, xValue, width, hFontL, hFontV)
    AboutRow(hdcMem, DpiPx(112), "Engine",     "Scintilla",         xLabel, xValue, width, hFontL, hFontV)

    IF hFontL <> 0 THEN DeleteObject(hFontL)
    IF hFontV <> 0 THEN DeleteObject(hFontV)

    ' 4. Frame
    DrawEdge(hdcMem, &rc, 5, 0x000F)

    SelectObject(hdcMem, hOld)
    DeleteDC(hdcMem)
    ReleaseDC(hwndDlg, hdcWin)
    RETURN hBmp
ENDSUB

SUB AboutRow(UINT hdc, INT y, STRING label$, STRING value$, INT xLabel, INT xValue, INT width, UINT hFontL, UINT hFontV)
    WINRECT rcL, rcV
    rcL.left = xLabel : rcL.top = y : rcL.right = xValue - DpiPx(4) : rcL.bottom = y + DpiPx(16)
    rcV.left = xValue : rcV.top = y : rcV.right = width - DpiPx(8)  : rcV.bottom = y + DpiPx(16)

    UINT hOldF = 0
    IF hFontL <> 0 THEN hOldF = SelectObject(hdc, hFontL)
    SetTextColor(hdc, RGB(95, 100, 110))
    DrawTextA(hdc, label$, -1, &rcL, 0x00000820)    ' LEFT | SINGLELINE | NOPREFIX

    IF hFontV <> 0 THEN SelectObject(hdc, hFontV)
    SetTextColor(hdc, RGB(0, 128, 0))              ' DARK GREEN
    DrawTextA(hdc, value$, -1, &rcV, 0x00000820)

    IF hOldF <> 0 THEN SelectObject(hdc, hOldF)
ENDSUB

SUB TextW(UINT hdc, UINT hFont, STRING s$), INT
    SIZE sz
    UINT hOld = SelectObject(hdc, hFont)
    GetTextExtentPoint32A(hdc, s$, LEN(s$), &sz)
    SelectObject(hdc, hOld)
    RETURN sz.cx
ENDSUB

SUB CreateAboutBanner(UINT hwndDlg, INT width, INT height), UINT
    UINT hdcWin  = GetDC(hwndDlg)
    UINT hdcMem  = CreateCompatibleDC(hdcWin)
    UINT hBmp    = CreateCompatibleBitmap(hdcWin, width, height)
    UINT hOldBmp = SelectObject(hdcMem, hBmp)

    WINRECT rc
    rc.left = 0 : rc.top = 0 : rc.right = width : rc.bottom = height

    ' 1. Background Fill using Brushed Metal Pattern Brush
    IF g_WndMenu.m_hbrBrushed <> 0 THEN
        FillRect(hdcMem, &rc, g_WndMenu.m_hbrBrushed)
    ELSE
        UINT hbrBg = CreateSolidBrush(RGB(212, 215, 220))
        FillRect(hdcMem, &rc, hbrBg)
        DeleteObject(hbrBg)
    ENDIF

    ' 2. Sunken 3D Icon Pocket
    WINRECT rcIconBox
    rcIconBox.left = DpiPx(8) : rcIconBox.top = DpiPx(4) : rcIconBox.right = DpiPx(50) : rcIconBox.bottom = DpiPx(46)
    DrawEdge(hdcMem, &rcIconBox, EDGE_SUNKEN, BF_RECT)

    IF hIcon[1] <> 0 THEN
        DrawIconEx(hdcMem, DpiPx(13), DpiPx(9), hIcon[1], DpiPx(32), DpiPx(32), 0, 0, 3)
    ENDIF

    SetBkMode(hdcMem, 1) ' TRANSPARENT

    ' 3. Embossed Title Text with Soft Glow Aura ("TPad")
    UINT hFontTitle = CreateFontA(-DpiPx(22), 0, 0, 0, 700, FALSE, FALSE, FALSE, 0, 0, 0, 5, 0, "Courier New")
    SelectObject(hdcMem, hFontTitle)

    WINRECT rcTitle
    rcTitle.left   = DpiPx(115)
    rcTitle.top    = DpiPx(5)
    rcTitle.right  = width
    rcTitle.bottom = DpiPx(27) 

    COLORREF colGlow      = RGB(192, 192, 192) ' Soft light gray
    COLORREF colHighlight = RGB(255, 255, 255) ' Crisp White Raised Edge
    COLORREF colShadow    = RGB(20, 24, 30)    ' Dark Shadow
    COLORREF colMain      = RGB(60, 68, 80)    ' Charcoal Embossed Face

    DrawEmbossedGlowText(hdcMem, APP_NAME, &rcTitle, colGlow, colHighlight, colShadow, colMain)

    DeleteObject(hFontTitle)

    ' 4. Engraved Subtitle ("Portable Text Editor")
    UINT hFontSub = CreateFontA(-DpiPx(12), 0, 0, 0, 600, FALSE, FALSE, FALSE, 0, 0, 0, 5, 0, "Courier")
    SelectObject(hdcMem, hFontSub)

    WINRECT rcSubHL, rcSubMain
    rcSubHL.left = DpiPx(67) : rcSubHL.top = DpiPx(32) : rcSubHL.right = width + DpiPx(1) : rcSubHL.bottom = DpiPx(44)
    SetTextColor(hdcMem, RGB(255, 255, 255))
    DrawTextA(hdcMem, "Portable Text Editor", -1, &rcSubHL, 0x00000020)

    rcSubMain.left = DpiPx(66) : rcSubMain.top = DpiPx(31) : rcSubMain.right = width : rcSubMain.bottom = DpiPx(43)
    SetTextColor(hdcMem, RGB(65, 72, 82))
    DrawTextA(hdcMem, "Portable Text Editor", -1, &rcSubMain, 0x00000020)

    DeleteObject(hFontSub)

    ' 5. Deco Block Divider at the bottom of Header Banner
    DrawDecoBlockDivider(hdcMem, DpiPx(12), height - DpiPx(6), width - DpiPx(24), RGB(110, 116, 128))

    ' Cleanup GDI Objects & Memory DC
    SelectObject(hdcMem, hOldBmp)
    DeleteDC(hdcMem)
    ReleaseDC(hwndDlg, hdcWin)

    RETURN hBmp
ENDSUB

': ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
': Combines an 8-pass backlit aura with embossed face
': ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
SUB DrawEmbossedGlowText(UINT hdc, STRING text$, POINTER prc, COLORREF glowCol, COLORREF highlightCol, COLORREF shadowCol, COLORREF mainCol)
    WINRECT rc, rcOff
    rc = #<WINRECT>prc
    INT g4 = DpiPx(4) : INT g1 = DpiPx(1)
    SetBkMode(hdc, 1) ' TRANSPARENT

    ' 1. Layer 1: 8-Pass Backlit Glow Halo (Outer spread at 2px offset)
    SetTextColor(hdc, glowCol)
    INT dx, dy
    FOR dx = -g4 TO g4 STEP g4
        FOR dy = -g4 TO g4 STEP g4
            IF dx <> 0 OR dy <> 0 THEN
                rcOff.left   = rc.left + dx
                rcOff.top    = rc.top + dy
                rcOff.right  = rc.right + dx
                rcOff.bottom = rc.bottom + dy
                DrawTextA(hdc, text$, - g1, &rcOff, 0x00000020) ' 0x00000020 = DT_SINGLELINE | DT_VCENTER | DT_CENTER
            ENDIF
        NEXT dy
    NEXT dx

    ' 2. Layer 2: Emboss Bottom-Right Drop Shadow (+1px X, +1px Y)
    rcOff.left = rc.left + g1 : rcOff.top = rc.top + g1
    rcOff.right = rc.right + g1 : rcOff.bottom = rc.bottom + g1
    SetTextColor(hdc, shadowCol)
    DrawTextA(hdc, text$, - g1, &rcOff, 0x00000020)

    ' 3. Layer 3: Emboss Top-Left Highlight Edge (-1px X, -1px Y)
    rcOff.left = rc.left - g1 : rcOff.top = rc.top - g1
    rcOff.right = rc.right - g1 : rcOff.bottom = rc.bottom - g1
    SetTextColor(hdc, highlightCol)
    DrawTextA(hdc, text$, - g1, &rcOff, 0x00000020)

    ' 4. Layer 4: Crisp Main Text Face (Base position)
    SetTextColor(hdc, mainCol)
    DrawTextA(hdc, text$, - g1, prc, 0x00000020)
ENDSUB

' ============================================================================
' DrawGlowText - Renders an 8-pass soft optical blur halo around text
' ============================================================================
SUB DrawGlowText(UINT hdc, STRING text$, POINTER prc, COLORREF glowCol, COLORREF mainCol)
    WINRECT rcGlow, rc
    rc = #<WINRECT>prc   ' Dereference structure pointer safely
    INT g2 = DpiPx(2)
    SetTextColor(hdc, glowCol)

    ' 8-Directional 1px offsets simulate a Gaussian edge blur
    INT dx, dy
    FOR dx = -g2 TO g2
        FOR dy = -g2 TO g2
            IF dx <> 0 OR dy <> 0 THEN
                rcGlow.left   = rc.left + dx
                rcGlow.top    = rc.top + dy
                rcGlow.right  = rc.right + dx
                rcGlow.bottom = rc.bottom + dy
                DrawTextA(hdc, text$, -1, &rcGlow, 0x00000001) ' 0x00000001 = DT_CENTER
            ENDIF
        NEXT dy
    NEXT dx

    ' Sharp main face on top
    SetTextColor(hdc, mainCol)
    DrawTextA(hdc, text$, -1, prc, 0x00000001)
ENDSUB

': ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
': Composites Bottom Footer Banner with Soft Glow Effect
': ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
SUB CreateAboutFooter(UINT hwndDlg, INT width, INT height), UINT
    UINT hdcWin  = GetDC(hwndDlg)
    UINT hdcMem  = CreateCompatibleDC(hdcWin)
    UINT hBmp    = CreateCompatibleBitmap(hdcWin, width, height)
    UINT hOldBmp = SelectObject(hdcMem, hBmp)

    WINRECT rc
    rc.left = 0 : rc.top = 0 : rc.right = width : rc.bottom = height

    ' Background Fill
    IF g_WndMenu.m_hbrBrushed <> 0 THEN
        FillRect(hdcMem, &rc, g_WndMenu.m_hbrBrushed)
    ELSE
        UINT hbrBg = CreateSolidBrush(RGB(212, 215, 220))
        FillRect(hdcMem, &rc, hbrBg)
        DeleteObject(hbrBg)
    ENDIF

    ' 1. Deco Block Divider at the top edge of footer
    DrawDecoBlockDivider(hdcMem, DpiPx(12), DpiPx(6), width - DpiPx(24), RGB(110, 116, 128))

    ' 2. Setup Font
    SetBkMode(hdcMem, 1) ' TRANSPARENT
    UINT hFontCredits = CreateUIFont(8, 600)
    UINT hOldFont = SelectObject(hdcMem, hFontCredits)

    ' Color Palette for Glow Effect
    COLORREF colGlow = RGB(192, 192, 192) ' Soft slate/cyan halo
    COLORREF colText = RGB(112, 112, 112)    ' Sharp Dark Charcoal Face

    WINRECT rcLine1, rcLine2

    ' Credit Line 1
    rcLine1.left = 0 : rcLine1.top = DpiPx(16) : rcLine1.right = width : rcLine1.bottom = DpiPx(30)
    DrawGlowText(hdcMem, "Inspired by the works of F. Balmer", &rcLine1, colGlow, colText)

    ' Credit Line 2
    rcLine2.left = 0 : rcLine2.top = DpiPx(31) : rcLine2.right = width : rcLine2.bottom = DpiPx(45)
    DrawGlowText(hdcMem, "Scintilla is (c) Neil Hodgson", &rcLine2, colGlow, colText)

    ' Restores original font and cleans up
    IF hOldFont <> 0 THEN SelectObject(hdcMem, hOldFont)
    IF hFontCredits <> 0 THEN DeleteObject(hFontCredits)

    SelectObject(hdcMem, hOldBmp)
    DeleteDC(hdcMem)
    ReleaseDC(hwndDlg, hdcWin)

    RETURN hBmp
ENDSUB

': ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
': Stepped geometric square blocks
': ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
SUB DrawDecoBlockDivider(UINT hdc, INT x, INT y, INT width, COLORREF col)
    UINT hBrush = CreateSolidBrush(col)
    WINRECT rc
    INT cx = x + (width / 2)
    INT cy = y
    INT d1 = DpiPx(1), d2 = DpiPx(2), d3 = DpiPx(3)
    INT e8 = DpiPx(8), e12 = DpiPx(12), e16 = DpiPx(16), e20 = DpiPx(20)

    rc.left = cx - d3 : rc.top = cy - d3 : rc.right = cx + d3 : rc.bottom = cy + d3
    FillRect(hdc, &rc, hBrush)

    rc.left = cx - e12 : rc.top = cy - d2 : rc.right = cx - e8  : rc.bottom = cy + d2
    FillRect(hdc, &rc, hBrush)
    rc.left = cx + e8  : rc.top = cy - d2 : rc.right = cx + e12 : rc.bottom = cy + d2
    FillRect(hdc, &rc, hBrush)

    rc.left = cx - e20 : rc.top = cy - d2 : rc.right = cx - e16 : rc.bottom = cy + d2
    FillRect(hdc, &rc, hBrush)
    rc.left = cx + e16 : rc.top = cy - d2 : rc.right = cx + e20 : rc.bottom = cy + d2
    FillRect(hdc, &rc, hBrush)

    INT halfW = (width / 2) - DpiPx(40)
    INT offset
    FOR offset = DpiPx(28) TO halfW STEP DpiPx(7)
        rc.left = cx - offset - d1 : rc.top = cy - d1 : rc.right = cx - offset + d1 : rc.bottom = cy + d1
        FillRect(hdc, &rc, hBrush)
        rc.left = cx + offset - d1 : rc.top = cy - d1 : rc.right = cx + offset + d1 : rc.bottom = cy + d1
        FillRect(hdc, &rc, hBrush)
    NEXT offset

    DeleteObject(hBrush)
ENDSUB
': ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
': Ownerdraw brushed buttons with icon
': ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
SUB DrawFindButton(POINTER p)
    INT  id    = #<INT>(p + 4)
    IF id = ctlMatchCase OR id = ctlMatchWholeWord THEN
        DrawFindCheck(p)
        RETURN
    ENDIF
    UINT state = #<INT>(p + 16)
    INT  hwndB = #<INT>(p + 20)
    HDC  hdc   = #<INT>(p + 24)
    WINRECT rc
    rc.left = #<INT>(p + 28) : rc.top = #<INT>(p + 32) : rc.right = #<INT>(p + 36) : rc.bottom = #<INT>(p + 40)

    ' Face
    SetBrushOrgEx(hdc, 0, 0, NULL)
    IF g_WndMenu.m_hbrBrushed <> 0 THEN
        FillRect(hdc, &rc, g_WndMenu.m_hbrBrushed)
    ELSE
        FillRect(hdc, &rc, GetSysColorBrush(15))
    ENDIF

    INT press = 0
    IF (state & 0x0001) THEN
        press = 1
        DrawEdge(hdc, &rc, 0x000A, 0x000F)            ' sunken
    ELSE
        DrawEdge(hdc, &rc, 0x0005, 0x000F)            ' raised
    ENDIF

    ' Which toolbar icon (-1 = text only)
    INT idx = -1
    IF id = ctlFind       THEN idx = 9
    IF id = ctlReplaceBtn THEN idx = 10
    IF id = ctlReplaceAll THEN idx = 10
    IF GetParent(hwndB) = About.hwnd THEN idx = -1     ' About's Close button: text only

    ' Caption and font
    ISTRING cap[64]
    cap = ""
    GetWindowTextA(hwndB, &cap, 63)
    STRING s = cap
    IF s = "..." THEN                                     ' the Browse button: icon only
        idx = 1
        s = ""
    ENDIF
    IF UCASE$(s) = "OK" THEN idx = 23                 ' green check
    IF UCASE$(s) = "CANCEL" THEN idx = 18             ' red X

    UINT hf = SendMessageA(hwndB, 0x0031, 0, 0)       ' WM_GETFONT
    UINT hOldF = 0
    IF hf <> 0 THEN hOldF = SelectObject(hdc, hf)

    WINRECT rcT
    rcT.left = 0 : rcT.top = 0 : rcT.right = 0 : rcT.bottom = 0
    DrawTextA(hdc, s, -1, &rcT, 0x00000420)           ' DT_CALCRECT | DT_SINGLELINE
    INT tw = rcT.right - rcT.left
    INT th = rcT.bottom - rcT.top

    INT iw = 0
    IF idx >= 0 THEN
        iw = g_IconSz + DpiPx(6)
        IF tw = 0 THEN iw = g_IconSz                      ' no caption: no gap to leave
    ENDIF
    INT bw = rc.right - rc.left
    INT bh = rc.bottom - rc.top
    INT x0 = rc.left + ((bw - (iw + tw)) / 2) + press

    IF idx >= 0 THEN
        ImageList_Draw(himl[4], idx, hdc, x0, rc.top + ((bh - g_IconSz) / 2) + press, 1)
    ENDIF

    WINRECT rcText
    rcText.left   = x0 + iw
    rcText.top    = rc.top + ((bh - th) / 2) + press
    rcText.right  = rcText.left + tw + 2
    rcText.bottom = rcText.top + th
    INT oldBk = SetBkMode(hdc, 1)
    IF (state & 0x0006) THEN
        SetTextColor(hdc, GetSysColor(17))             ' grayed
    ELSE
        SetTextColor(hdc, RGB(30, 30, 30))
    ENDIF
    DrawTextA(hdc, s, -1, &rcText, 0x00000020)         ' DT_SINGLELINE, & mnemonics underlined

    IF (state & 0x0010) THEN                           ' ODS_FOCUS
        WINRECT rcF
        rcF.left = rc.left + DpiPx(4) : rcF.top = rc.top + DpiPx(4)
        rcF.right = rc.right - DpiPx(4) : rcF.bottom = rc.bottom - DpiPx(4)
        DrawFocusRect(hdc, &rcF)
    ENDIF

    SetBkMode(hdc, oldBk)
    IF hOldF <> 0 THEN SelectObject(hdc, hOldF)
ENDSUB

SUB DrawFindCheck(POINTER p)
    INT  id    = #<INT>(p + 4)
    UINT state = #<INT>(p + 16)
    INT  hwndB = #<INT>(p + 20)
    HDC  hdc   = #<INT>(p + 24)
    WINRECT rc
    rc.left = #<INT>(p + 28) : rc.top = #<INT>(p + 32) : rc.right = #<INT>(p + 36) : rc.bottom = #<INT>(p + 40)

    ' background: the dialog's own brush, lined up with the dialog's origin so it blends in
    WINRECT rw
    POINT pd
    GetWindowRect(hwndB, &rw)
    pd.x = rw.left : pd.y = rw.top
    ScreenToClient(GetParent(hwndB), &pd)
    SetBrushOrgEx(hdc, 0 - pd.x, 0 - pd.y, NULL)
    IF hbrBackground <> 0 THEN
        FillRect(hdc, &rc, hbrBackground)
    ELSE
        FillRect(hdc, &rc, GetSysColorBrush(15))
    ENDIF

    INT checked = 0
    IF id = ctlMatchCase AND match_case <> 0 THEN checked = 1
    IF id = ctlMatchWholeWord AND match_word <> 0 THEN checked = 1

    ' the box
    INT bx = DpiPx(13)
    WINRECT rcB
    rcB.left   = rc.left + DpiPx(1)
    rcB.top    = rc.top + ((rc.bottom - rc.top) - bx) / 2
    rcB.right  = rcB.left + bx
    rcB.bottom = rcB.top + bx
    UINT fl = 0                                         ' DFCS_BUTTONCHECK
    IF checked <> 0 THEN fl = fl | 0x0400               ' DFCS_CHECKED
    IF (state & 0x0001) THEN fl = fl | 0x0200           ' DFCS_PUSHED while the mouse is down
    DrawFrameControl(hdc, &rcB, 4, fl)                  ' DFC_BUTTON

    ' caption
    ISTRING cap[64]
    cap = ""
    GetWindowTextA(hwndB, &cap, 63)
    STRING s = cap
    UINT hf = SendMessageA(hwndB, 0x0031, 0, 0)         ' WM_GETFONT
    UINT hOldF = 0
    IF hf <> 0 THEN hOldF = SelectObject(hdc, hf)

    WINRECT rcT
    rcT.left = 0 : rcT.top = 0 : rcT.right = 0 : rcT.bottom = 0
    DrawTextA(hdc, s, -1, &rcT, 0x00000420)             ' DT_CALCRECT | DT_SINGLELINE
    INT tw = rcT.right - rcT.left
    INT th = rcT.bottom - rcT.top

    rcT.left   = rcB.right + DpiPx(6)
    rcT.top    = rc.top + ((rc.bottom - rc.top) - th) / 2
    rcT.right  = rcT.left + tw + 2
    rcT.bottom = rcT.top + th
    INT oldBk = SetBkMode(hdc, 1)
    SetTextColor(hdc, RGB(30, 30, 30))
    DrawTextA(hdc, s, -1, &rcT, 0x00000020)             ' DT_SINGLELINE, & mnemonic underlined

    IF (state & 0x0010) THEN                            ' ODS_FOCUS
        WINRECT rcF
        rcF.left = rcT.left - DpiPx(2) : rcF.top = rcT.top - DpiPx(1)
        rcF.right = rcT.right + DpiPx(2) : rcF.bottom = rcT.bottom + DpiPx(1)
        DrawFocusRect(hdc, &rcF)
    ENDIF

    SetBkMode(hdc, oldBk)
    IF hOldF <> 0 THEN SelectObject(hdc, hOldF)
ENDSUB
': ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
': Brushed Find/Replace dialog
': ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
SUB ColorFindSubClass(hwnd : INT, uMsg : INT, wParam : INT, lParam : POINTER), INT
    IF uMsg = 0x000F OR uMsg = 0x0006 THEN              ' WM_PAINT / WM_ACTIVATE: default first, then the caption on top
        IF g_FindOrig <> 0 THEN CallWindowProcA(g_FindOrig, hwnd, uMsg, wParam, lParam)
        CapPaint(hwnd)
        RETURN 0
    ENDIF
    IF uMsg >= 0x0200 AND uMsg <= 0x0202 THEN           ' mouse move / left down / left up
        IF CapHandle(hwnd, uMsg, lParam) = 1 THEN RETURN 0
    ENDIF
    IF uMsg = 0x0215 THEN CapHandle(hwnd, uMsg, lParam)

    Select uMsg
        Case WM_CTLCOLOREDIT
            If g_hFindEditBgBrush = 0 THEN g_hFindEditBgBrush = CreateSolidBrush(RGB(253, 246, 227))
            SetTextColor(wParam, RGB(0, 0, 0))
            SetBkColor(wParam, RGB(253, 246, 227))
            cID = GetDlgCtrlID(lParam)
            IF (cID = ctlSearchtext) OR (cID = ctlReplacetext)
                ReDrawFrame(search_dlg, wParam)
            ENDIF
            RETURN g_hFindEditBgBrush

        Case 0x0134                                   ' WM_CTLCOLORLISTBOX
            If g_hFindEditBgBrush = 0 THEN g_hFindEditBgBrush = CreateSolidBrush(RGB(253, 246, 227))
            SetTextColor(wParam, RGB(0, 0, 0))
            SetBkColor(wParam, RGB(253, 246, 227))
            RETURN g_hFindEditBgBrush

        Case WM_CTLCOLORDLG
            IF hbrBackground <> 0 THEN RETURN hbrBackground

        Case 0x002B                                   ' WM_DRAWITEM
            IF wParam <> 0 THEN
                DrawFindButton(lParam)
                RETURN TRUE
            ENDIF

        Case WM_CTLCOLORSTATIC
            SetBkMode(wParam, @TRANSPARENT)
            SetTextColor(wParam, RGB(40, 40, 40))
            SetBrushOrgEx(wParam, 0, 0, NULL)
            RETURN ghbrBackground
    EndSelect

    IF g_FindOrig <> 0 THEN
        RETURN CallWindowProcA(g_FindOrig, hwnd, uMsg, wParam, lParam)
    ENDIF
    RETURN 0
EndSub

SUB ColorSubClass(hwnd : INT, uMsg : INT, wParam : INT, lParam : POINTER), INT
    Select uMsg
        Case WM_CTLCOLORDLG
            IF hbrBackground <> 0 THEN RETURN hbrBackground

        Case 0x002B                                   ' WM_DRAWITEM
            IF wParam <> 0 THEN
                DrawFindButton(lParam)
                RETURN TRUE
            ENDIF
    EndSelect

    IF g_AboutOrig <> 0 THEN
        RETURN CallWindowProcA(g_AboutOrig, hwnd, uMsg, wParam, lParam)
    ENDIF
    RETURN 0
EndSub
': ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
': File RAM buffer to disk
': ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
SUB SaveBufferToFile(STRING filePath$), INT
    g_SaveError = 0
    IF g_hSciCtrl = 0 THEN RETURN FALSE

    INT txtLen = SendMessageA(g_hSciCtrl, SCI_GETTEXTLENGTH, 0, 0)
    POINTER pUtf8 = SafeAllocHeap(txtLen + 1)
    IF pUtf8 = NULL THEN
        g_SaveError = 8
        RETURN FALSE
    ENDIF
    SendMessageA(g_hSciCtrl, SCI_GETTEXT, txtLen + 1, pUtf8)

    IF g_EolPending THEN
        POINTER pConv = ConvertEOLs(pUtf8, txtLen, g_EolTarget)
        IF pConv <> NULL THEN
            SafeFreeHeap(pUtf8)
            pUtf8  = pConv
            txtLen = g_ConvLen
        ENDIF
    ENDIF

    POINTER pOutBuf = pUtf8
    INT outLen = txtLen
    INT ownsOut = FALSE
    INT proceed = TRUE
    INT result = FALSE
    INT enc = g_App.encoding
    INT usedDef = 0
    INT wLen = 0
    POINTER pWide = NULL

    IF txtLen > 0 AND enc = ENC_ANSI THEN
        INT cpSave = g_App.codePage
        wLen = MultiByteToWideChar(65001, 0, pUtf8, txtLen, NULL, 0)
        pWide = SafeAllocHeap((wLen + 1) * 2)
        IF pWide = NULL THEN
            g_SaveError = 8
            proceed = FALSE
        ELSE
            MultiByteToWideChar(65001, 0, pUtf8, txtLen, pWide, wLen)

            outLen = WideCharToMultiByte(cpSave, 0x400, pWide, wLen, NULL, 0, NULL, NULL)
            pOutBuf = SafeAllocHeap(outLen + 1)
            IF pOutBuf = NULL THEN
                g_SaveError = 8
                proceed = FALSE
                pOutBuf = pUtf8
            ELSE
                ownsOut = TRUE
                WideCharToMultiByte(cpSave, 0x400, pWide, wLen, pOutBuf, outLen, NULL, &usedDef)

                IF usedDef <> 0 THEN
                    STRING cpLabel$ = "ANSI"
                    IF cpSave <> 0 THEN cpLabel$ = CPNameOf(cpSave)
                    IF MessageBoxA(WIN.hwnd, "Some characters cannot be represented in " + cpLabel$ + " and will be replaced." + g_CRLF + "Save anyway?", "Tpad", 0x31) = 1 THEN
                        SafeFreeHeap(pOutBuf)
                        outLen = WideCharToMultiByte(cpSave, 0, pWide, wLen, NULL, 0, NULL, NULL)
                        pOutBuf = SafeAllocHeap(outLen + 1)
                        IF pOutBuf = NULL THEN
                            g_SaveError = 8
                            proceed = FALSE
                            ownsOut = FALSE
                            pOutBuf = pUtf8
                        ELSE
                            WideCharToMultiByte(cpSave, 0, pWide, wLen, pOutBuf, outLen, NULL, NULL)
                        ENDIF
                    ELSE
                        proceed = FALSE      ' user cancelled: no error, no toast
                    ENDIF
                ENDIF
            ENDIF
            SafeFreeHeap(pWide)
        ENDIF

    ELSEIF txtLen > 0 AND enc >= ENC_U16LE_BOM THEN
        wLen = MultiByteToWideChar(65001, 0, pUtf8, txtLen, NULL, 0)
        pWide = SafeAllocHeap((wLen + 1) * 2)
        IF pWide = NULL THEN
            g_SaveError = 8
            proceed = FALSE
        ELSE
            MultiByteToWideChar(65001, 0, pUtf8, txtLen, pWide, wLen)
            IF enc = ENC_U16BE_BOM OR enc = ENC_U16BE THEN SwapBytes16(pWide, wLen * 2)
            pOutBuf = pWide
            outLen = wLen * 2
            ownsOut = TRUE
        ENDIF
    ENDIF

    IF proceed THEN
        result = AtomicSave(filePath$, pOutBuf, outLen, enc)
    ENDIF

    IF ownsOut THEN SafeFreeHeap(pOutBuf)
    SafeFreeHeap(pUtf8)
    RETURN result
ENDSUB

': Safe save: temp file in the same folder, then swap over the target.
': Falls back to a direct write when the swap cannot help (new file, symlink,
': path too long for the ".tpad.tmp" suffix).
SUB AtomicSave(STRING path$, POINTER pBuf, INT bufLen, INT enc), INT
    g_SaveError = 0

    INT attrs = GetFileAttributesA(path$)          ' -1 = does not exist

    IF attrs = -1 THEN
        ' New file: nothing to protect, but do not leave a half-written one behind.
        IF WriteEncodedFile(path$, pBuf, bufLen, enc) = 0 THEN
            DeleteFileA(path$)
            RETURN FALSE
        ENDIF
        RETURN TRUE
    ENDIF

    IF (attrs & 0x400) <> 0 OR LEN(path$) + 10 >= 260 THEN
        ' reparse point (symlink/junction) or no room for the suffix: write in place
        RETURN WriteEncodedFile(path$, pBuf, bufLen, enc)
    ENDIF

    STRING tmp$ = path$ + ".tpad.tmp"

    IF WriteEncodedFile(tmp$, pBuf, bufLen, enc) = 0 THEN
        DeleteFileA(tmp$)                          ' g_SaveError already set; original untouched
        RETURN FALSE
    ENDIF

    ' carry over Hidden / System / Archive from the original
    INT keep = attrs & 0x26
    IF keep = 0 THEN keep = 0x80                   ' FILE_ATTRIBUTE_NORMAL
    SetFileAttributesA(tmp$, keep)

    ' MOVEFILE_REPLACE_EXISTING (1) | MOVEFILE_WRITE_THROUGH (8)
    IF MoveFileExA(tmp$, path$, 9) = 0 THEN
        g_SaveError = GetLastError()               ' read before any other API call
        Trace("SWAP failed err=" + STR$(g_SaveError))
        DeleteFileA(tmp$)
        RETURN FALSE
    ENDIF

    RETURN TRUE
ENDSUB

': Writes BOM + payload to path$ (create/truncate). Sets g_SaveError on failure.
SUB WriteEncodedFile(STRING path$, POINTER pBuf, INT bufLen, INT enc), INT
    HANDLE hFile = CreateFileA(path$, GENERIC_WRITE, 0, NULL, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL)
    IF hFile = INVALID_HANDLE_VALUE THEN
        g_SaveError = GetLastError()
        RETURN FALSE
    ENDIF

    DWORD bytesWritten = 0
    INT wr = TRUE
    BYTE bom[3]

    IF bufLen > 0 THEN
        IF enc = ENC_UTF8BOM THEN
            bom[0] = 0xEF : bom[1] = 0xBB : bom[2] = 0xBF
            wr = WriteFile(hFile, &bom[0], 3, &bytesWritten, NULL)
        ELSEIF enc = ENC_U16LE_BOM THEN
            bom[0] = 0xFF : bom[1] = 0xFE
            wr = WriteFile(hFile, &bom[0], 2, &bytesWritten, NULL)
        ELSEIF enc = ENC_U16BE_BOM THEN
            bom[0] = 0xFE : bom[1] = 0xFF
            wr = WriteFile(hFile, &bom[0], 2, &bytesWritten, NULL)
        ENDIF

        IF wr <> 0 THEN
            wr = WriteFile(hFile, pBuf, bufLen, &bytesWritten, NULL)
            IF wr = 0 THEN
                g_SaveError = GetLastError()
            ELSEIF bytesWritten <> bufLen THEN
                wr = 0
                g_SaveError = 112                  ' short write = disk full
            ENDIF
        ELSE
            g_SaveError = GetLastError()
        ENDIF
    ENDIF

    IF wr <> 0 THEN FlushFileBuffers(hFile)        ' data on disk before the swap; result ignored

    Trace("WRITE " + path$ + " enc=" + STR$(enc) + " len=" + STR$(bufLen) + " wr=" + STR$(wr) + " err=" + STR$(g_SaveError))
    CloseHandle(hFile)

    IF wr <> 0 THEN RETURN TRUE
    RETURN FALSE
ENDSUB

SUB BGRA_FillVerticalGradient(POINTER pBits, INT width, INT height, INT stride, DWORD colTop, DWORD colBottom)
    If pBits = NULL OR width <= 0 OR height <= 0 THEN RETURN

    INT y, x
    POINTER pRow = NULL

    INT r1 = (colTop >> 16) & 0xFF, g1 = (colTop >> 8) & 0xFF, b1 = colTop & 0xFF
    INT r2 = (colBottom >> 16) & 0xFF, g2 = (colBottom >> 8) & 0xFF, b2 = colBottom & 0xFF

    INT curR, curG, curB
    DWORD lineCol

    For y = 0 TO height - 1
        curR = r1 + (((r2 - r1) * y) / height)
        curG = g1 + (((g2 - g1) * y) / height)
        curB = b1 + (((b2 - b1) * y) / height)

        lineCol = (curB << 16) | (curG << 8) | curR

        pRow = pBits + (y * stride)
        For x = 0 TO width - 1
            #<DWORD>(pRow + (x * 4)) = lineCol
        Next x
    Next y
EndSub

SUB SetLexerByExtension(STRING filePath$)
    IF g_hSciCtrl = 0 THEN RETURN

        STRING ext$ = ""
    INT dotPos = LEN(filePath$)
    WHILE dotPos > 0
        IF MID$(filePath$, dotPos, 1) = CHR$(92) THEN BREAK       ' stop at the folder part: "C:\my.dir\Makefile" has no extension
        IF MID$(filePath$, dotPos, 1) = "." THEN
            ext$ = LCASE$(RIGHT$(filePath$, LEN(filePath$) - dotPos))
            BREAK
        ENDIF
        dotPos--
    WEND

    ' Files without extension that are recognised by their name
    IF ext$ = "" THEN
        STRING bn$ = LCASE$(filePath$)
        INT bsPos = LEN(bn$)
        WHILE bsPos > 0 AND MID$(bn$, bsPos, 1) <> CHR$(92)
            bsPos--
        WEND
        bn$ = RIGHT$(bn$, LEN(bn$) - bsPos)
        IF bn$ = "makefile" OR bn$ = "gnumakefile" THEN ext$ = "mak"
    ENDIF

    INT activeLexer = SCLEX_NULL

    SELECT ext$
        CASE "c"
        CASE& "cpp"
        CASE& "h"
        CASE& "hpp"
        CASE& "rc"
        CASE& "cxx"
        CASE& "cc"
        CASE& "hxx"
        CASE& "hh"
        CASE& "inl"
        CASE& "idl"
            activeLexer = SCLEX_CPP

        CASE "iwb"
        CASE& "inc"
        CASE& "bas"
        CASE& "iba"
        CASE& "eba"
            activeLexer = SCLEX_FREEBASIC

        CASE "asm"
        CASE& "s"
            activeLexer = SCLEX_ASM

        CASE "py"
        CASE& "pyw"
            activeLexer = SCLEX_PYTHON

        CASE "pl"
        CASE& "pm"
        CASE& "plx"
        CASE& "cgi"
        CASE& "pod"
            activeLexer = SCLEX_PERL

        CASE "mak"
        CASE& "make"
        CASE& "mk"
        CASE& "dsp"
            activeLexer = SCLEX_MAKEFILE

        CASE "bat"
        CASE& "cmd"
        CASE& "btm"
            activeLexer = SCLEX_BATCH

        CASE "diff"
        CASE& "patch"
            activeLexer = SCLEX_DIFF

        CASE "lua"
            activeLexer = SCLEX_LUA

        DEFAULT
            activeLexer = SCLEX_NULL
    ENDSELECT


    ' Store active lexer globally
    g_activeLexer = activeLexer

    ' Set lexer mode in Scintilla
    SendMessageA(g_hSciCtrl, SCI_SETLEXER, activeLexer, 0)

    ' Reset all character style bytes in the buffer to 0
    INT docLen = SendMessageA(g_hSciCtrl, 2006, 0, 0) ' SCI_GETLENGTH
    IF docLen > 0 THEN
        SendMessageA(g_hSciCtrl, 2005, 0, 0)         ' SCI_CLEARDOCUMENTSTYLE
        SendMessageA(g_hSciCtrl, 2032, 0, 255)       ' SCI_STARTSTYLING(pos=0, mask=255)
        SendMessageA(g_hSciCtrl, 2033, docLen, 0)    ' SCI_SETSTYLING(length=docLen, style=0)
    ENDIF

    ' If Default / Plain Text, update theme and return immediately
    IF activeLexer = SCLEX_NULL THEN
        ApplyThemeStyles(g_App.themeID)
        SyncSyntaxMenuCheck(32)
        InvalidateRect(g_hSciCtrl, NULL, TRUE)
        RETURN
    ENDIF

    SendMessageA(g_hSciCtrl, SCI_SETLEXER, activeLexer, 0)

    ' Dynamically allocate 8KB heap buffers
    POINTER pKw1 = SafeAllocHeap(8192)
    POINTER pKw2 = SafeAllocHeap(8192)
    POINTER pKw3 = SafeAllocHeap(8192)

    IF pKw1 = NULL OR pKw2 = NULL OR pKw3 = NULL THEN
        IF pKw1 <> NULL THEN SafeFreeHeap(pKw1)
        IF pKw2 <> NULL THEN SafeFreeHeap(pKw2)
        IF pKw3 <> NULL THEN SafeFreeHeap(pKw3)
        RETURN
    ENDIF

    ' CRITICAL: Null-terminate the first byte of each heap buffer
    ' so lstrcatA starts concatenating at offset 0 instead of appending to heap garbage
    #<BYTE>pKw1 = 0
    #<BYTE>pKw2 = 0
    #<BYTE>pKw3 = 0

    INT ks = 0
    FOR ks = 0 TO 8
        SendMessageA(g_hSciCtrl, SCI_SETKEYWORDS, ks, pKw1)      ' pKw1 is still empty here
    NEXT ks

    SELECT activeLexer

        ' ====================================================================
        ' C / C++ & Win32 (Notepad2 keyword list + Tpad's Win32 types)
        ' ====================================================================
        CASE SCLEX_CPP
            SendMessageA(g_hSciCtrl, SCI_SETPROPERTY, &"styling.within.preprocessor", &"1")

            lstrcatA(pKw1, "__abstract __alignof __asm __assume __based __box __cdecl __declspec __delegate __event __except ")
            lstrcatA(pKw1, "__except__try __fastcall __finally __forceinline __gc __hook __identifier __if_exists ")
            lstrcatA(pKw1, "__if_not_exists __inline __int16 __int32 __int64 __int8 __interface __leave __m128 __m128d __m128i ")
            lstrcatA(pKw1, "__m64 __multiple_inheritance __nogc __noop __pin __property __raise __sealed __single_inheritance ")
            lstrcatA(pKw1, "__stdcall __super __try __try_cast __unhook __uuidof __value __virtual_inheritance __wchar_t auto ")
            lstrcatA(pKw1, "BOOL bool break BYTE case catch char char16_t char32_t class COLORREF const const_cast constexpr ")
            lstrcatA(pKw1, "continue decltype default defined delete do double DWORD dynamic_cast else enum explicit export ")
            lstrcatA(pKw1, "extern false float for friend goto HANDLE HBITMAP HBRUSH HDC HICON HINSTANCE HMENU HMODULE HPEN HWND ")
            lstrcatA(pKw1, "if inline int LONG long LPARAM LRESULT mutable naked namespace new noexcept nullptr operator POINT ")
            lstrcatA(pKw1, "POINTER private protected public register reinterpret_cast return short signed SIZE size_t sizeof ")
            lstrcatA(pKw1, "static static_assert static_cast struct switch template this thread_local throw true try typedef ")
            lstrcatA(pKw1, "typeid typename UINT union unsigned using uuid virtual void volatile wchar_t while WINRECT WORD ")
            lstrcatA(pKw1, "WPARAM ")
            lstrcatA(pKw2, "#define #include #ifdef #ifndef #endif #else #elif #line #error #pragma #undef #import")

            SendMessageA(g_hSciCtrl, SCI_SETKEYWORDS, 0, pKw1)
            SendMessageA(g_hSciCtrl, SCI_SETKEYWORDS, 1, pKw2)

        ' ====================================================================
        ' IWBasic 2.5 / FreeBasic Lexer (ALL IWBasic Keywords & Types)
        ' ====================================================================
                CASE SCLEX_FREEBASIC
            SendMessageA(g_hSciCtrl, SCI_SETPROPERTY, &"freebasic.ignorecase", &"1")

            STRING fbWordChars$ = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_$"
            SendMessageA(g_hSciCtrl, SCI_SETWORDCHARS, 0, &fbWordChars$)

            ' SET 0 (GOLD, style 3): language structure + data types only

            lstrcatA(pKw1, "alias autodefine begininsertmenu beginmenu beginpopup boolean break breakfor byte case char class ")
            lstrcatA(pKw1, "const ctl data datasection declare def default delete dialog do double dword else elseif end ")
            lstrcatA(pKw1, "endclass enddatasection endenum endif endmenu endpopup endselect endsub endtype endwhile enum exit ")
            lstrcatA(pKw1, "extern float for global handle hdc hinstance hmenu hwnd if import int istring long loop new next not ")
            lstrcatA(pKw1, "onexit option pointer qword read restore return select setid short step string struct sub then to ")
            lstrcatA(pKw1, "type uint until wend while word wstring ")

            ' SET 1 (CYAN, style 10): preprocessor directives ($-forms; bare else/endif/option live in Set 0)

            lstrcatA(pKw2, "$define $else $endif $ifdef $ifndef $include $main $option $undef $use _asm _endasm define ifdef ")
            lstrcatA(pKw2, "ifndef include main undef use ")

            ' SET 2 (style 11): library commands / functions (all iwbstd.incc $command + other IWBasic library SUBs)

            lstrcatA(pKw3, "__delete __get __new __power __put __read __readmem __write __writemem _dup$ _wdupstr _wstrappend ")
            lstrcatA(pKw3, "abs acos acosd activatedwindow addaccelerator addmenuitem addstring allocheap allocmem ")
            lstrcatA(pKw3, "alreadyrunning append$ appendmenu appendtextfile argc argv asc asin asind atan atand attachbrowser ")
            lstrcatA(pKw3, "backpen bigstradd bigstrmake bigstrreset browsecmd browsefolder cdecl ceil centerwindow ")
            lstrcatA(pKw3, "changefilereadonly checkdropformat checkmenuitem chr chr$ circle clearlist closeconsole closedialog ")
            lstrcatA(pKw3, "closefile closeprinter closesplitter closewindow cls color colorrequest comenumnext comgetlasterror ")
            lstrcatA(pKw3, "concbinitstorage concbloadfonts conclientedge condrawoff condrawon confirmexit confirmsavechanges ")
            lstrcatA(pKw3, "conlbaddstrlist conlbinitstorage conlbrightclick conloadimages conlvautosize conlvcolumnlistset ")
            lstrcatA(pKw3, "conlvcolumnset conlvgetcheckstate conlvgettext conlvheaderautosize conlvhittest conlvsetcheckstate ")
            lstrcatA(pKw3, "conlvsetextendedstyle conlvsetextendedstyleraw connewcontrol conpcsetbarcolor conpcsetbkgcolor ")
            lstrcatA(pKw3, "conpcsetpos conpcsetrange conprogresscontrol conreset consolidercontrol consolidergetpos ")
            lstrcatA(pKw3, "consolidersetbuddy consolidersetpos consolidersetrange consolidersetthumbsize constatusslidercon ")
            lstrcatA(pKw3, "constatussliderupdate contabcontrol contabinsert control controlcmd controlex controlexists ")
            lstrcatA(pKw3, "contvcontrol contvdelete contvexpand contvfullinsert contvgetcuritemfulltext contvgetitemfulltext ")
            lstrcatA(pKw3, "contvgetitemtext contvgetparent contvgetselitem contvhittest contvinsert contvsetcolor ")
            lstrcatA(pKw3, "contvuseimages copyfile copyrgn cos cosd cosh coshd createcomobject createdialog createdir ")
            lstrcatA(pKw3, "createmenu createregkey createshortcut createsplitter date date$ daysfromstartofyear daysinmonth ")
            lstrcatA(pKw3, "debugout debugprint debugstart define_guid deletefile deleteimage deleteregkey deletergn ")
            lstrcatA(pKw3, "deletestring deletesystrayicon deletewildfile dictadd dictcreate dictfree dictgetkey ")
            lstrcatA(pKw3, "dictgetnextassoc dictgetstartassoc dictgetvalue dictlookup dictremove dictremoveall direxists ")
            lstrcatA(pKw3, "domodal dottedfour dragwindow drawmode dynaaddstr dynaaddstrzz dynadelete dynagetstr dynagetstrptr ")
            lstrcatA(pKw3, "dynainsertstr dynaloadfile dynanew dynaremovestr dynarenew dynasavefile dynasortstr dynaswapstr ")
            lstrcatA(pKw3, "ellipse enablecontrol enablemenu enablemenuitem enabletabs encode64 encodefile64 endpage eof exp ")
            lstrcatA(pKw3, "facos facosd fasin fasind fatan fatand fcos fcosd fcosh fcoshd fileexists filerequest fillrect ")
            lstrcatA(pKw3, "findclose findnext findopen floodfill floor flt fontrequest freeheap freelib freemem frontpen fsin ")
            lstrcatA(pKw3, "fsind fsinh fsinhd ftan ftand ftanh ftanhd getattribstr getbitmapsize getbrowserinterface getcaption ")
            lstrcatA(pKw3, "getcaretposition getclientsize getclrbuttonface getclrstatictext getcmclientcoords getcommandtext ")
            lstrcatA(pKw3, "getcomobject getcontrolhandle getcontroltext getdata getdefaultprinter getdirectorysystem ")
            lstrcatA(pKw3, "getdirectorywindows getdllversion getdragkeystate getdragpoint getdriveletters getdrivetypestr ")
            lstrcatA(pKw3, "getdropdata getdroppedfiles getdynadirlist getdynafilelist getexceptioncode getexceptioninformation ")
            lstrcatA(pKw3, "getfilebinaryversion getfileext getfilemodifiediso getfilesfl getfiletimeasiso getfiletimefromiso ")
            lstrcatA(pKw3, "getfocus getfolderpath gethdc getibkeywords getibprodir getisonowutc getkeystate getlasterror ")
            lstrcatA(pKw3, "getmyappdatadir getmydesktopdir getmydocsdir getmyquicklaunch getmystartmenu getpathfile getpixel ")
