': ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
': Tpad - Text Editor for IWBasic 2.5
': Memory-Mapped File Loader, UTF-8 Engine, and Brushed Metal Skinning
': ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

$USE "SciLexer.lib"
$USE "msimg32.lib"
$USE "ctl.lib"

$INCLUDE "windowssdk.inc"
$INCLUDE "commctrl.inc"
$INCLUDE "shlwapi.inc"
$INCLUDE "fletchie_ctl.inc"
$INCLUDE "BrushedMenu.inc"
$INCLUDE "SciLexer.inc"
$INCLUDE "Scintilla.inc"

AutoDefine "Off"

$MAIN

': ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
': Tooltip Balloon Types & Globals
': ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
TYPE TOOLINFO_BALLOON
    INT cbSize
    INT uFlags
    HWND hwnd
    UINT uId
    WINRECT rc
    HINSTANCE hinst
    POINTER lpszText
    LPARAM lParam
ENDTYPE

GLOBAL HWND g_hwndToolTip = 0

CONST BALLOON_DISMISS_TIMER_ID = 9005
CONST TTF_TRACK     = 0x0020
CONST TTF_ABSOLUTE  = 0x0080
CONST TTM_ADDTOOLA  = 1028
CONST TTM_DELTOOLA  = 1029
CONST TTM_TRACKACTIVATE = 1041
CONST TTM_TRACKPOSITION = 1042

': ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
': Application State Structure & Custom Types
': ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

TYPE APP_STATE
    ' Window Position & State
    INT left
    INT top
    INT width
    INT height
    INT onTop
    INT wordWrap
    INT showHScroll

    ' Font Configuration
    STRING fontName
    INT fontSize
    INT fontWeight
    INT fontFlags

    ' Editor Runtime State
    INT isOverwrite
    INT encoding
    INT codePage            ' 0 = system ANSI code page, otherwise the 8-bit code page number
    INT themeID

    ' MRU File Tracking
    STRING mru[5]
    INT mruFlags[5]

    STRING eolMode
    STRING filepath

    INT showIndent
    INT showEOL
    INT showWS
    INT showWrapSym
    INT tabsAsSpaces
    INT autoIndent
    INT braceMatch
    INT trimOnSave
    INT finalNewline
ENDTYPE

GLOBAL APP_STATE g_App

TYPE TPAD_LOGFONT
    DEF lfHeight AS INT
    DEF lfWidth AS INT
    DEF lfEscapement AS INT
    DEF lfOrientation AS INT
    DEF lfWeight AS INT
    DEF lfItalic AS BYTE
    DEF lfUnderline AS BYTE
    DEF lfStrikeOut AS BYTE
    DEF lfCharSet AS BYTE
    DEF lfOutPrecision AS BYTE
    DEF lfClipPrecision AS BYTE
    DEF lfQuality AS BYTE
    DEF lfPitchAndFamily AS BYTE
    DEF lfFaceName[32] AS BYTE
ENDTYPE

TYPE TPAD_CHOOSEFONT
    DEF lStructSize AS INT
    DEF hwndOwner AS INT
    DEF hDC AS INT
    DEF lpLogFont AS INT
    DEF iPointSize AS INT
    DEF Flags AS INT
    DEF rgbColors AS INT
    DEF lCustData AS INT
    DEF lpfnHook AS INT
    DEF lpTemplateName AS INT
    DEF hInstance AS INT
    DEF lpszStyle AS INT
    DEF nFontType AS WORD
    DEF wAlign AS WORD
    DEF nSizeMin AS INT
    DEF nSizeMax AS INT
ENDTYPE

GLOBAL INT g_Dpi = 96
GLOBAL INT g_ToolbarH = 26
GLOBAL INT g_IconScale = 1
GLOBAL INT g_IconSz    = 16
GLOBAL INT g_TbLastRight = 0

GLOBAL CBrushedMenuBase g_WndMenu
GLOBAL INT g_InUpdateUI = FALSE
GLOBAL INT g_IsReplaceDialog
GLOBAL INT g_startAtTop = FALSE
GLOBAL INT g_IsLoading = TRUE
GLOBAL INT g_IsResizing = FALSE
