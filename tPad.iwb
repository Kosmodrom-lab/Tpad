            lstrcatA(pKw1, "comm comment common cpu db dd df dosseg dq dt dup dw echo else elseif elseif1 elseif2 elseifb ")
            lstrcatA(pKw1, "elseifdef elseifdif elseifdifi elseife elseifidn elseifidni elseifnb elseifndef end endif endm endp ")
            lstrcatA(pKw1, "ends endstruc eq equ even exitm export extern externdef extrn for forc ge global goto group gt high ")
