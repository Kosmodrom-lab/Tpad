            lstrcatA(pKw1, "loopd loope looped loopew loopne loopned loopnew loopnz loopnzd loopnzw loopw loopz loopzd loopzw ")
            lstrcatA(pKw1, "lsl lss ltr mov movs movsb movsd movsq movsw movsx movsxd movzx mul neg nop not or out outs outsb ")
            lstrcatA(pKw1, "outsd outsw pop popa popad popaw popf popfd popfw push pusha pushad pushaw pushd pushf pushfd pushfw ")
            lstrcatA(pKw1, "pushw rcl rcr rdmsr rdpmc rdshr rdtsc rep repe repne repnz repz ret retf retn rol ror rsdc rsldt rsm ")
            lstrcatA(pKw1, "rsts sahf sal salc sar sbb scas scasb scasd scasq scasw seta setae setb setbe setc sete setg setge ")
            lstrcatA(pKw1, "setl setle setna setnae setnb setnbe setnc setne setng setnge setnl setnle setno setnp setns setnz ")
