        ' x86 Assembly: 6 Scintilla sets, loaded one after the other through pKw1
        '   0 CPU instructions  1 FPU instructions  2 registers
        '   3 directives        4 directive operands  5 extended (MMX/SSE) instructions
        ' ====================================================================
        CASE SCLEX_ASM
            ' set 0: CPU instructions
            lstrcatA(pKw1, "aaa aad aam aas adc add and arpl bound bsf bsr bswap bt btc btr bts call cbw cdq cflush clc cld cli ")
            lstrcatA(pKw1, "clts cmc cmova cmovae cmovb cmovbe cmovc cmove cmovg cmovge cmovl cmovle cmovna cmovnae cmovnb ")
