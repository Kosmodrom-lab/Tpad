GLOBAL UINT g_hAboutBannerBmp = 0
GLOBAL UINT g_hAboutFooterBmp = 0
GLOBAL INT g_EolTarget  = 0        ' 0 = CRLF, 1 = CR, 2 = LF
GLOBAL INT g_EolPending = FALSE    ' TRUE = user asked for a conversion at the next save
GLOBAL INT g_ConvLen    = 0        ' length result of ConvertEOLs
GLOBAL INT g_ForceEnc = -1  ' >= 0: loader must use this encoding instead of detecting
GLOBAL INT g_LoadError = 0
GLOBAL INT g_SaveError = 0   ' 0 = ok or user cancelled, otherwise a Win32 error code
GLOBAL INT g_HexTrace = 0
CONST CAP_H = 22                        ' caption bar height at 96 DPI
GLOBAL WINRECT g_capCloseRc             ' close button rectangle (client coordinates)
GLOBAL INT g_capDown = 0                ' 1 = left button pressed on the close button (mouse captured)
GLOBAL INT g_capPush = 0                ' 1 = ... and the pointer is still over it (drawn pushed)
GLOBAL ISTRING g_tipTxt[300]


CONST About_Close  = 2
CONST About_Banner = 2
CONST About_Footer = 12

CONST ENC_ANSI       = 0
CONST ENC_UTF8       = 1      ' UTF-8, no BOM
CONST ENC_UTF8BOM    = 2      ' UTF-8 with EF BB BF signature
