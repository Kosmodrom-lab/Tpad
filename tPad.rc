1 VERSIONINFO
FILEVERSION     2,0,0,0
PRODUCTVERSION  2,0,0,0
FILEFLAGSMASK   0x3FL
FILEFLAGS       0x2L              // VS_FF_PRERELEASE: it is a Beta
FILEOS          0x00040004L       // VOS_NT_WINDOWS32
FILETYPE        0x1L              // VFT_APP
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904E4"          // US English, codepage 1252
        BEGIN
            VALUE "CompanyName",      "Origami Concepts"
            VALUE "FileDescription",  "Tpad - text and source code editor"
            VALUE "FileVersion",      "2.0.0.0"
            VALUE "InternalName",     "Tpad"
            VALUE "OriginalFilename", "Tpad.exe"
            VALUE "ProductName",      "Tpad"
            VALUE "ProductVersion",   "2.0 [Beta]"
            VALUE "LegalCopyright",   "Copyright (c) 2026 Origami Concepts"
            VALUE "Comments",         "Written in IWBasic. Contact: yannick.dalissier@outlook.com"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1252
    END
END
1 24 "D:\\AI\\TXT_Edit\\Tpad.exe.manifest"